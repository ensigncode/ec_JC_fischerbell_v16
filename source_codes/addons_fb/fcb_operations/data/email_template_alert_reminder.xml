<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="email_template_alert_reminder_1" model="mail.template">
            <field name="name">Validation Reminder</field>
            <field name="model_id" ref="model_stock_picking"/>
            <field name="subject">validation Reminder</field>
            <field name="body_html" type="html">
                <p>Dear
                    <t t-out="object.name or ''"></t>
                    <br/>
                    Please validate the product in stocks
                    <br/>
                    Regards,
                    <br/>
                    <t t-out="object.partner_id.name"/>
                </p>
            </field>
        </record>
    </data>
</odoo>
