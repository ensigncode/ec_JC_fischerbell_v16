<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="report_packing_label_document">
        <t t-call="web.html_container">
            <div class="page">
                <style>
                    .table.table-bordered tr td {
                        padding-top : 20px;
                        padding-bottom : 20px;
                    }
                    .font-25 {
                        font-size : 25px;
                    }
                    .br-0 {
                        border-right : 0px;
                    }
                    .bl-0 {
                        border-left : 0px;
                    }
                    .pl-35 {
                        padding-left : 35px;
                    }
                </style>
                <div class="container">
                    <div class="row justify-content-center">
                        <table class="table table-bordered">
                            <tbody>
                                <tr>
                                    <td class="text-center" colspan="3">
                                        <img src="/fischerbell_custom/static/src/img/fischerbell_header.jpeg" width="400" height="100" style="margin-bottom: 10px;"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-uppercase">
                                        <span class="" t-field="doc.qr_code" t-options="{'widget': 'image'}" role="img"/>
                                    </td>
                                    <td colspan="2" class="text-uppercase">
                                        <div t-field="doc.name" t-options="{'widget': 'barcode', 'width': 600, 'height': 100, 'img_style': 'width:300px;height:50px;'}"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-uppercase">
                                        To:
                                    </td>
                                    <td colspan="2">
                                        <p style="margin-bottom:0px;">
                                            <t t-esc="doc.partner_id.name"></t><br />
                                            <t t-if="doc.partner_id.street"> <t t-esc="doc.partner_id.street"/></t>
                                            <t t-if="doc.partner_id.street2">, <t t-esc="doc.partner_id.street2"/></t>
                                            <t t-if="doc.partner_id.city">, <t t-esc="doc.partner_id.city"/></t>
                                            <t t-if="doc.partner_id.state_id"> <t t-esc="doc.partner_id.state_id.name"/></t>
                                            <t t-if="doc.partner_id.country_id"> <t t-esc="doc.partner_id.country_id.name"/></t>
                                            <t t-if="doc.partner_id.zip"> <t t-esc="doc.partner_id.zip"/></t>
                                        </p>
                                        <!-- <p t-if="doc.partner_id.parent_id">
                                            <t t-esc="doc.partner_id.parent_id.name"></t><br />
                                            <t t-if="doc.partner_id.parent_id.street"> <t t-esc="doc.partner_id.parent_id.street"/></t>
                                            <t t-if="doc.partner_id.parent_id.street2">, <t t-esc="doc.partner_id.parent_id.street2"/></t>
                                            <t t-if="doc.partner_id.parent_id.city">, <t t-esc="doc.partner_id.parent_id.city"/></t>
                                            <t t-if="doc.partner_id.parent_id.state_id"> <t t-esc="doc.partner_id.parent_id.state_id.name"/></t>
                                            <t t-if="doc.partner_id.parent_id.country_id"> <t t-esc="doc.partner_id.parent_id.country_id.name"/></t>
                                            <t t-if="doc.partner_id.parent_id.zip">, <t t-esc="doc.partner_id.parent_id.zip"/></t>
                                        </p> -->
                                    </td>
                                </tr>
                                <tr>
                                    <td colspan="3">
                                        Delivery Instructions: <t t-esc="doc.delivery_instruction"/>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="br-0">
                                        <p class="">
                                            Contact 1:<br />
                                            <t t-if="doc.contact_one">
                                                <t t-esc="doc.contact_one.name"></t><br />
                                                <t t-if="doc.contact_one.department"> <t t-esc="doc.contact_one.department"/></t><br />
                                                <t t-if="doc.contact_one.phone"> <t t-esc="doc.contact_one.phone"/></t>
                                            </t>
                                        </p>
                                    </td>
                                    <td class="bl-0 br-0"></td>
                                    <td class="bl-0">
                                        <p class="">
                                            Contact 2:<br />
                                            <t t-if="doc.contact_two">
                                                <t t-esc="doc.contact_two.name"></t><br />
                                                <t t-if="doc.contact_two.department"> <t t-esc="doc.contact_two.department"/></t><br />
                                                <t t-if="doc.contact_two.phone"> <t t-esc="doc.contact_two.phone"/></t>
                                            </t>
                                        </p>
                                    </td>
                                </tr>
                                <tr>
                                    <td class="text-center">
                                        <p>
                                            No. of SKU <br />
                                        </p>
                                        <p class="font-25">
                                            <t t-if="doc.move_line_ids and doc.move_ids_without_package">
                                                <t t-esc="len(doc.move_line_ids_without_package)"></t>
                                            </t>
                                            <t t-if="doc.package_level_ids and doc.picking_type_entire_packs and doc.state in ['assigned', 'done']">
                                                <t t-esc="len(doc.package_level_ids)"></t>
                                            </t>
                                        </p>
                                    </td>
                                    <td class="text-center">
                                        <p>Total Qty: <br /></p>
                                        <p class="font-25">
                                            <t t-if="doc.move_line_ids and doc.move_ids_without_package">
                                                <t t-set="total_qty" t-value="0"></t>
                                                <t t-foreach="doc.move_line_ids_without_package" t-as="move">
                                                    <t t-set="total_qty" t-value="total_qty + move.qty_done"></t>
                                                </t>
                                                <t t-esc="total_qty"></t>
                                            </t>
                                            <t t-if="doc.package_level_ids and doc.picking_type_entire_packs and doc.state in ['assigned', 'done']">
                                                <t t-set="total_qty" t-value="0"></t>
                                                <t t-foreach="doc.package_level_ids" t-as="move">
                                                    <t t-set="total_qty" t-value="total_qty + move.qty_done"></t>
                                                </t>
                                                <t t-esc="total_qty"></t>
                                               
                                            </t>
                                        </p>
                                    </td>
                                    <td class="text-center">
                                        <p>Package <br /></p>
                                        <p class="font-25"><t t-esc="doc.package"/></p>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </t>
    </template>
    <template id="report_packing_label">
        <t t-call="web.basic_layout">
            <t t-foreach="docs" t-as="doc">
                <t t-call="fcb_operations.report_packing_label_document" t-lang="doc.partner_id.lang"/>
            </t>
        </t>
    </template>

    <record id="paperformat_packing_label" model="report.paperformat">
        <field name="name">Packing label paperformat</field>
        <field name="default" eval="True" />
        <field name="format">custom</field>
        <field name="page_height">280</field>
        <field name="page_width">170</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">0</field>
        <field name="margin_left">0</field>
        <field name="margin_right">0</field>
        <field name="disable_shrinking" eval="True"/>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_delivery_order_packing_label_label" model="ir.actions.report">
        <field name="name">Packing Label</field>
        <field name="model">stock.picking</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">fcb_operations.report_packing_label</field>
        <field name="report_file">fcb_operations.report_packing_label</field>
        <field name="print_report_name">
            (object.state in ('draft', 'waiting', 'assigned', 'confirmed', 'done') and 'Packing label - %s' % (object.name))</field>
        <field name="binding_model_id" ref="model_stock_picking"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="fcb_operations.paperformat_packing_label"/>
    </record>

    
</odoo>