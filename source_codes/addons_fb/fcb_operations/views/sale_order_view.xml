<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sale_order_inherited_form_purchase_inherited" model="ir.ui.view">
        <field name="name">sale.purchase.order.inherited.custom</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_purchase.sale_order_inherited_form_purchase" />
        <field name="arch" type="xml">
            <xpath expr="//button" position="replace">
                <button class="oe_stat_button" name="action_view_purchase_orders" type="object" icon="fa-credit-card" groups='base.group_system' attrs="{'invisible': [('purchase_order_count', '=', 0)]}">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value"><field name="purchase_order_count"/></span>
                        <span class="o_stat_text">Purchase</span>
                    </div>
                </button>
            </xpath>
        </field>
    </record>
</odoo>
