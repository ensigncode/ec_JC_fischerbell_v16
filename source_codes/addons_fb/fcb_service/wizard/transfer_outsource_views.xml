<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- View for the wizard form -->
    <record id="outsource_location_details_view_form" model="ir.ui.view">
        <field name="name">fcb.outsource.location.view.form</field>
        <field name="model">fcb.outsource.location</field>
        <field name="arch" type="xml">
            <form string="Outsource Details">
                <group>
                    <group>
                        <field name="ticket_id" invisible='1'/>
                        <field name="product_id" invisible='1'/>
                        <field name="location_ids" invisible="1"/>
                        <field name="outsource_service" invisible="1"/>
                        <field name="to_destination" attrs="{'invisible': [('outsource_service', '!=', 'to_fcb')]}"/>
                        <field name="dest_location_id" domain="[('id','in',location_ids)]"
                               attrs="{'invisible': [('outsource_service', '!=', 'to_fcb')]}"/>
                        <field name="pick_up" attrs="{'invisible': [('outsource_service', '!=', 'd_to_supplier')]}"/>
                    </group>
                </group>
                <footer>
                    <button name="action_create_outsource_transfer"
                            string="Create Outsource Transfer"
                            type="object" class="oe_highlight"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
