<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- View fcb.prepayment.validation form -->
    <record id="view_fcb_prepayment_validation_form" model="ir.ui.view">
        <field name="name">view.fcb.prepayment.validation.form</field>
        <field name="model">fcb.prepayment.validation</field>
        <field name="arch" type="xml">
            <form string="Fcb Prepayment Validation">
                <sheet>
                    <div class="oe_title">
                        <p>Prepayment is required before confirming this order.</p>
                        <p>Please create and process the prepayment invoice before confirming..</p>
                    </div>
                </sheet>
                <footer>
                    <button name="action_submit" string="Ok" type="object" class="oe_highlight"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
