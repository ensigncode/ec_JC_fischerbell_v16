<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="fischerbell_custom_huzmat_report">
            <t t-if="o and 'company_id' in o">
                <t t-set="company" t-value="o.company_id"></t>
            </t>
            <t t-if="not o or not 'company_id' in o">
                <t t-set="company" t-value="res_company"></t>
            </t>
            <t>
                <div class="header">
                    <div class="col-6" style="float:left;width:50%;">
                        <img t-if="company.logo" t-att-src="image_data_uri(company.logo)"
                             style="max-height: 100px;"/>
                    </div>
                    <div class="col-6"
                         style="font:16px lucida-console,sans-serif !important; text-align: left;float:right;width:50%;">
                        <strong t-field="company.partner_id"/>
                        <br/>
                        <span t-if="company.partner_id.street">
                            <span t-if="company.partner_id.street" t-field="company.partner_id.street"/>,
                        </span>

                        <span t-if="company.partner_id.street2">
                            <span t-field="company.partner_id.street2"/>
                        </span>

                        <span t-if="company.partner_id.city" t-field="company.partner_id.city"/>

                        <span t-if="company.partner_id.country_id" t-field="company.partner_id.country_id"/>
                        <br/>
                        Tel :
                        <span class="col-6" t-if="company.partner_id.phone" t-field="company.partner_id.phone"/>
                        <span style="padding:15px"/>Fax :
                        <span class="col-6" t-if="company.partner_id.phone" t-field="company.partner_id.phone"/>
                        <br/>
                        W :
                        <span class="col-6" t-if="company.partner_id.website" t-field="company.partner_id.website"/>
                        <span style="padding:15px"/>E :
                        <span class="col-6" t-if="company.partner_id.phone" t-field="company.partner_id.phone"/>
                        <br/>
                        UEN :
                        <span class="col-6">200502661D</span>
                        <span style="padding:15px"/>GST REG No :
                        <span class="col-6">20-0502661D</span>
                        <br/>
                        <span t-if="company.partner_id.vat" t-field="company.partner_id.vat"/>
                        <br/>
                    </div>
                </div>
                <div class="col-12" style="background-color:black;text-align:center;float:left;width:100%;">
                    <strong style="color:white;font-size:25px;text-align:center;height: 16x;">HAZMAT SUIT INSPECTION
                        REPORT
                    </strong>
                </div>
                <br/>
                <br/>
                <br/>
                <div class="row mt32 mb32 ">
                    <div>
                        <table class="table-borderless" style=" border-color:white;  font-weight: bold;">
                            <tr style="font-weight: bold;font-size: 21px;">
                                <th colspan="2"></th>
                                <th colspan="1"></th>
                                <th colspan="3"></th>
                                <th colspan="2"></th>
                                <th colspan="1"></th>
                                <th colspan="3"></th>
                            </tr>
                            <tr>
                                <td colspan="2" style="width:25%">
                                    <strong style="font-weight: bold;font-size: 16px;">Customer</strong>
                                </td>
                                <td colspan="1">
                                    <strong style="text-align:right;padding:5px">:</strong>
                                </td>
                                <td colspan="3"
                                    style="border-bottom: 1px solid black;text-align:left;width:25%;height:10px">
                                    <t t-out="o.partner_id.name"/>
                                </td>
                                <td colspan="2" style="width:25%">
                                    <strong style="font-weight: bold;font-size: 16px;">Our Reference No</strong>
                                </td>
                                <td colspan="1">:&amp;nbsp;</td>
                                <td colspan="2" style="border-bottom: 1px solid black;text-align:center;width:25%;"
                                ></td>
                            </tr>
                            <tr>
                                <td colspan="2" style="width:25%">
                                    <strong style="font-weight: bold;font-size: 16px;">Address</strong>
                                </td>
                                <td colspan="1">
                                    <strong style="text-align:right;padding:5px">:</strong>
                                </td>
                                <td colspan="3"
                                    style="border-bottom: 1px solid black;text-align:left;width:25%;height:10px"
                                ></td>
                                <td colspan="2" style="width:25%">
                                    <strong style="font-weight: bold;font-size: 16px;">Your Reference No</strong>
                                </td>
                                <td colspan="1">:&amp;nbsp;</td>
                                <td colspan="2" style="border-bottom: 1px solid black;text-align:center;width:25%;"
                                ></td>
                            </tr>
                            <tr>
                                <td colspan="2" style="width:25%">
                                </td>
                                <td colspan="1">
                                    <strong style="text-align:right;padding:5px"></strong>
                                </td>
                                <td colspan="3"
                                    style="border-bottom: 1px solid black;text-align:left;width:25%;height:10px"
                                ></td>
                                <td colspan="2" style="width:25%">
                                    <strong style="font-weight: bold;font-size: 16px;">Requeste Date</strong>
                                </td>
                                <td colspan="1">:&amp;nbsp;</td>
                                <td colspan="2" style="border-bottom: 1px solid black;text-align:center;width:25%;"
                                ></td>
                            </tr>
                            <tr>
                                <td colspan="2" style="width:25%">
                                    <strong style="font-weight: bold;font-size: 16px;">Item Location</strong>
                                </td>
                                <td colspan="1">
                                    <strong style="text-align:right;padding:5px">:</strong>
                                </td>
                                <td colspan="3"
                                    style="border-bottom: 1px solid black;text-align:left;width:25%;height:10px"
                                ></td>
                                <td colspan="2" style="width:25%">
                                    <strong style="font-weight: bold;font-size: 16px;">Contact Person</strong>
                                </td>
                                <td colspan="1">:&amp;nbsp;</td>
                                <td colspan="2" style="border-bottom: 1px solid black;text-align:center;width:25%;"
                                ></td>
                            </tr>
                            <tr>
                                <td colspan="2" style="width:25%">
                                </td>
                                <td colspan="1">
                                    <strong style="text-align:right;padding:5px"></strong>
                                </td>
                                <td colspan="3"
                                    style="border-bottom: 1px solid black;text-align:left;width:25%;height:10px"
                                ></td>
                                <td colspan="2" style="width:25%">
                                    <strong style="font-weight: bold;font-size: 16px;">Contact No</strong>
                                </td>
                                <td colspan="1">:&amp;nbsp;</td>
                                <td colspan="2" style="border-bottom: 1px solid black;text-align:center;width:25%;"
                                ></td>
                            </tr>
                            <tr>
                                <td colspan="2" style="width:25%">
                                    <strong style="font-weight: bold;font-size: 16px;">Model</strong>
                                </td>
                                <td colspan="1">
                                    <strong style="text-align:right;padding:5px">:</strong>
                                </td>
                                <td colspan="3"
                                    style="border-bottom: 1px solid black;text-align:left;width:25%;height:10px"
                                ></td>
                                <td colspan="2" style="width:25%">
                                    <strong style="font-weight: bold;font-size: 16px;">Item Serial Number</strong>
                                </td>
                                <td colspan="1">:&amp;nbsp;</td>
                                <td colspan="2" style="border-bottom: 1px solid black;text-align:center;width:25%;"
                                ></td>
                            </tr>
                            <tr>
                                <td colspan="2" style="width:25%">
                                    <strong style="font-weight: bold;font-size: 16px;">Next Service Date</strong>
                                </td>
                                <td colspan="1">
                                    <strong style="text-align:right;padding:5px">:</strong>
                                </td>
                                <td colspan="3"
                                    style="border-bottom: 1px solid black;text-align:left;width:25%;height:10px"
                                ></td>
                                <td colspan="2" style="width:25%">
                                    <strong style="font-weight: bold;font-size: 16px;">Completed Date</strong>
                                </td>
                                <td colspan="1">:&amp;nbsp;</td>
                                <td colspan="2" style="border-bottom: 1px solid black;text-align:center;width:25%;"
                                ></td>
                            </tr>
                        </table>
                    </div>
                    <br/>
                </div>
                <br/>

                <div class="col-12" style="background-color:black;text-align:center;float:left;width:100%;">
                    <strong style="color:white;font-size:20px;text-align:center;height: 10px;">EQUIPEMENT</strong>
                </div>

                <t t-set="worksheet_template_id"
                   t-value="env[o.worksheet_template_id.sudo().model_id.model].search([('x_project_task_id', '=', o.id)])"></t>

                <table style="border:2px solid black;width:100%;border-collapse: collapse;" class="table o_main_table table-bordered">
                    <thead>
                        <t style="border-bottom: 2px solid black;">
                            <th colspan="3" style="border-left: 2px solid black;text-align :left;border-bottom: 2px solid black;">
                                <strong style="text-align:center">1.Hazmat Suit</strong>
                            </th>
                            <th colspan="2" rawspan="2" style="border-left: 2px solid black;border-bottom: 2px solid black;">
                                <strong style="font-weight: bold;font-size: 16px;">
                                    Condition
                                    <br/>
                                    P:Pass / F:Fail
                                </strong>
                            </th>
                            <th colspan="4" style="border-left: 2px solid black;border-bottom: 2px solid black;">
                                <strong style="text-align:center;font-weight: bold;font-size: 16px;">Explain Issues /
                                    Problems found
                                </strong>
                            </th>
                            <th colspan="3" style="border-left: 2px solid black;border-right: 2px solid black;border-bottom: 2px solid black;">
                                <strong style="text-align:center;font-weight: bold;font-size: 16px;">
                                    Tick if completed<br/>(&#10004;)
                                </strong>
                            </th>
                        </t>

                    </thead>
                    <tbody>
                        <tr t-foreach="worksheet_template_id.x_hazmat_suit_ids" t-as="ws">

                            <t style="border-left: 2px solid black;border: 2px solid black;border-bottom: 2px solid black;">
                                <td colspan="3" style="border-left: 2px solid black;text-align:center;border-bottom: 2px solid black;">
                                    <t t-if="ws.x_hazmat_suit"
                                       t-esc="ws.x_hazmat_suit"/>
                                </td>

                                <td colspan="2" style="border-left: 2px solid black;text-align:center;border-bottom: 2px solid black;">
                                    <t t-if="ws.x_condition"
                                       t-esc="ws.x_condition"/>
                                </td>
                                <td colspan="4"
                                    style="border-left: 2px solid black;outline: 1px solidblack;text-align:center;border-bottom: 2px solid black;">
                                    <t t-if="ws.x_issues"
                                       t-esc="ws.x_issues"/>
                                </td>
                                <td colspan="3"
                                    style="border-left: 2px solid black;text-align:center;border-right: 2px solid black;border-bottom: 2px solid black;">
                                    <t t-if="ws.x_completed == True ">
                                        (&#10004;)
                                    </t>
                                    <t t-else="">
                                        &amp;nbsp;
                                    </t>
                                </td>
                            </t>
                        </tr>
                    </tbody>
                </table>
                <br/>
                <div class="col-12" style="background-color:black;text-align:center;float:left;width:100%;">
                    <strong style="color:white;font-size:20px;text-align:center;height: 10px;">TESTING SPECIFICATIONS
                    </strong>
                </div>

                <table style="border:1px solid black;width:100%;border-collapse: collapse;">
                    <tr style="border-left: 2px solid white;border-right: 2px solid white;">
                        <td rawspan="2" style="border-bottom: 2px solid #C4BDBC;padding-top:15px">
                            We hereby confirm that the above suit have been serviced and tested according to EN 464 and
                            fulfils the gas tightness
                        </td>
                    </tr>
                    <tr rawspan="2" style="border-left: 2px solid white;border-right: 2px solid white;">
                        <td style="border-bottom: 2px solid #C4BDBC;padding-top:15px">requirement according to EN 943-1
                        </td>
                    </tr>
                    <tr rawspan="2" style="border-left: 2px solid white;border-right: 2px solid white;padding-top:15px">
                        <td style="padding-top: 15px;border-bottom: 2px solid #C4BDBC">
                            <span>Reading after inspection:</span>
                            <span style="display: inline;width: 100px;color:white;height: 100px;border-left: 2px solid black;
                            border-top: 2px solid black;border-bottom: 2px solid black;border-right: 2px solid black;padding-top: 18px;padding-bottom: 4px;">
                                inspection box
                            </span>
                            <span>&amp;nbsp; Inch Water Coulumn &amp;nbsp; Pass/Fail</span>
                        </td>

                    </tr>

                </table>
                <br/>
                <div class="col-12" style="background-color:black;text-align:center;float:left;width:100%;">
                    <strong style="color:white;font-size:20px;text-align:center;height: 10px;">REMARKS</strong>
                </div>

                <table style="border:1px solid black;width:100%;border-collapse: collapse;">
                    <tr style="border-left: 2px solid white;border-right: 2px solid white;">
                        <td style="border-bottom: 2px solid #C4BDBC;padding-top: 15px;">
                            <t t-if="worksheet_template_id.x_comments" t-out="worksheet_template_id.x_comments"/>
                        </td>
                    </tr>
                    <tr style="border-left: 2px solid white;border-right: 2px solid white;">
                        <td style="border-bottom: 2px solid #C4BDBC;padding-top: 15px;">&amp;nbsp;</td>
                    </tr>
                    <tr style="border-left: 2px solid white;border-right: 2px solid white;">
                        <td style="border-bottom: 2px solid #C4BDBC;padding-top: 15px;">&amp;nbsp;</td>
                    </tr>
                    <tr style="border-right: 1px solid white;border-left: 2px solid white;">
                        <td style="border-bottom: 2px solid white;padding-top: 15px;">&amp;nbsp;</td>
                    </tr>
                </table>

                <div>
                    <t t-call="fcb_service.print_custom_footer"/>
                </div>
            </t>
        </template>
        <template id="report_fischerbell_custom_huzmat_report">
            <t t-call="web.html_container">
                <t t-call="web.basic_layout">
                    <t t-foreach="docs" t-as="o">
                        <t t-call="fcb_service.fischerbell_custom_huzmat_report" t-lang="o.partner_id.lang"/>
                    </t>
                </t>
            </t>
        </template>
        <record id="paperformat_fischerbell_report_view" model="report.paperformat">
            <field name="name">Custom fischerbell report</field>
            <field name="default" eval="False"/>
            <field name="disable_shrinking" eval="False"/>
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">40.00</field>
            <field name="margin_bottom">00</field>
            <field name="margin_left">7</field>
            <field name="margin_right">7</field>
            <field name="dpi">90</field>
        </record>

        <record id="action_huzmal_task_custom_report" model="ir.actions.report">
            <field name="name">HAZMAT SUIT INSPECTION REPORT</field>
            <field name="model">project.task</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">fcb_service.report_fischerbell_custom_huzmat_report</field>
            <field name="report_file">fcb_service.report_fischerbell_custom_huzmat_report</field>
            <field name="print_report_name">'Worksheet %s - %s' % (object.name, object.partner_id.name)</field>
            <field name="binding_model_id" eval="False"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="paperformat_fischerbell_report_view"/>
        </record>
    </data>
</odoo>
