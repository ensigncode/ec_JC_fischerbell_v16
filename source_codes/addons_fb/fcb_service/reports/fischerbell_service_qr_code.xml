        <record id="fischerbell_qr_code_service_report" model="ir.actions.report">
            <field name="name">Qr Code</field>
            <field name="model">project.task</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">fcb_service.report_fischerbell_qr_code_service</field>
            <field name="report_file">fcb_service.report_fischerbell_qr_code_service</field>
            <field name="print_report_name">'Qr Code'</field>
            <field name="binding_model_id" eval="False"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="fcb_service.paperformat_qr_code"/>
        </record>
    </data>
</odoo>
