<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="fischerbell_qr_service_info_temp">
               <div>
                   <t t-foreach="docs" t-as="o">
                    <img t-if="o._generate_qr_code()"
                         style="display:block;"
                         t-att-src="'/report/barcode/?barcode_type=%s&amp;value=%s&amp;width=%s&amp;height=%s'%('QR', o._generate_qr_code(), 230, 230)"/>
                   </t>
               </div>
        </template>
        <template id="report_fischerbell_qr_code_service">
            <t t-call="web.html_container">
                <t t-call="web.basic_layout">
                    <t t-foreach="docs" t-as="o">
                        <t t-call="fcb_service.fischerbell_qr_service_info_temp" t-lang="o.partner_id.lang"/>
                    </t>
                </t>
            </t>
        </template>
        <record id="paperformat_qr_code" model="report.paperformat">
            <field name="name">Qr Code</field>
            <field name="default" eval="True" />
            <field name="format">custom</field>
            <field name="page_height">100</field>
            <field name="page_width">150</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">5</field>
            <field name="margin_bottom">5</field>
            <field name="margin_left">5</field>
            <field name="margin_right">5</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">5</field>
            <field name="dpi">80</field>
        </record>

