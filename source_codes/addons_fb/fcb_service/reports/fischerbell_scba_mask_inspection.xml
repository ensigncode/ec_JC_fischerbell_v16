<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="worksheet_custom_pagew" inherit_id="industry_fsm.worksheet_custom">
            <xpath expr="//t[@t-call='web.external_layout']" position="replace">
                <t t-call="fcb_service.fischerbell_custom_header"/>
            </xpath>
        </template>
        <template id="fischerbell_custom_header">
            <t t-if="o and 'company_id' in o">
                <t t-set="company" t-value="o.company_id"></t>
            </t>
            <t t-if="not o or not 'company_id' in o">
                <t t-set="company" t-value="res_company"></t>
            </t>
            <div>
                <div class="header">
                    <div class="col-6" style="float:left;width:50%;">
                        <img t-if="company.logo" t-att-src="image_data_uri(company.logo)"
                             style="max-height: 100px;"/>
                    </div>
                    <div class="col-6"
                         style="font:16px lucida-console,sans-serif !important; text-align: left;float:right;width:50%;">
                        <strong t-field="company.partner_id"/>
                        <br/>
                        <span t-if="company.partner_id.street">
                            <span t-if="company.partner_id.street" t-field="company.partner_id.street"/>,
                        </span>

                        <span t-if="company.partner_id.street2">
                            <span t-field="company.partner_id.street2"/>
                        </span>

                        <span t-if="company.partner_id.city" t-field="company.partner_id.city"/>

                        <span t-if="company.partner_id.country_id" t-field="company.partner_id.country_id"/>
                        <br/>
                        Tel :
                        <span class="col-6" t-if="company.partner_id.phone" t-field="company.partner_id.phone"/>
                        <span style="padding:15px"/>Fax :
                        <span class="col-6" t-if="company.partner_id.phone" t-field="company.partner_id.phone"/>
                        <br/>
                        W :
                        <span class="col-6" t-if="company.partner_id.website" t-field="company.partner_id.website"/>
                        <span style="padding:15px"/>E :
                        <span class="col-6" t-if="company.partner_id.phone" t-field="company.partner_id.phone"/>
                        <br/>
                        UEN :
                        <span class="col-6">200502661D</span>
                        <span style="padding:15px"/>GST REG No :
                        <span class="col-6">20-0502661D</span>
                        <br/>
                        <span t-if="company.partner_id.vat" t-field="company.partner_id.vat"/>
                        <br/>
                    </div>
                </div>
                <div class="col-12" style="background-color:black;text-align:center;float:left;width:100%;">
                    <strong style="color:white;font-size:25px;text-align:center;height: 16x;">
                        SCBA MASK INSPECTION REPORT
                    </strong>
                </div>
                <br/>
                <br/>
                <br/>
                <div class="row mt32 mb32 ">
                    <div>
                        <table>
                            <tr>
                                <th colspan="2"></th>
                                <th colspan="1"></th>
                                <th colspan="3"></th>
                                <th colspan="2"></th>
                                <th colspan="1"></th>
                                <th colspan="3"></th>
                            </tr>
                            <tr>
                                <td colspan="2" style="width:25%">
                                    <strong>Customer</strong>
                                </td>
                                <td colspan="1">
                                    <strong style="text-align:right;">:</strong>
                                </td>


                                <td colspan="3"
                                    style="border-bottom: 1px solid black;text-align:left;width:25%;height:10px"
                                ></td>
                                <td colspan="2" style="width:25%">
                                    <strong>Our Reference No</strong>
                                </td>
                                <td colspan="1">:</td>
                                <td colspan="2" style="border-bottom: 1px solid black;text-align:center;width:25%;"
                                ></td>
                            </tr>
                            <tr>
                                <td colspan="2" style="width:25%">
                                    <strong>Address</strong>
                                </td>
                                <td colspan="1">
                                    <strong style="text-align:right;">:</strong>
                                </td>
                                <td colspan="3"
                                    style="border-bottom: 1px solid black;text-align:left;width:25%;height:10px"
                                ></td>
                                <td colspan="2" style="width:25%">
                                    <strong>Your Reference No</strong>
                                </td>
                                <td colspan="1">:</td>
                                <td colspan="2" style="border-bottom: 1px solid black;text-align:center;width:25%;"
                                ></td>
                            </tr>
                            <tr>
                                <td colspan="2" style="width:25%">
                                </td>
                                <td colspan="1">
                                    <strong style="text-align:right;">:</strong>
                                </td>
                                <td colspan="3"
                                    style="border-bottom: 1px solid black;text-align:left;width:25%;height:10px"
                                ></td>
                                <td colspan="2" style="width:25%">
                                    <strong>Requeste Date</strong>
                                </td>
                                <td colspan="1">:</td>
                                <td colspan="2" style="border-bottom: 1px solid black;text-align:center;width:25%;"
                                ></td>
                            </tr>
                            <tr>
                                <td colspan="2" style="width:25%">
                                    <strong>Cylinder No.</strong>
                                </td>
                                <td colspan="1">
                                    <strong style="text-align:right;">:</strong>
                                </td>
                                <td colspan="3"
                                    style="border-bottom: 1px solid black;text-align:left;width:25%;height:10px"
                                ></td>
                                <td colspan="2" style="width:25%">
                                    <strong>Contact Person</strong>
                                </td>
                                <td colspan="1">:</td>
                                <td colspan="2" style="border-bottom: 1px solid black;text-align:center;width:25%;"
                                ></td>
                            </tr>
                            <tr>
                                <td colspan="2" style="width:25%">
                                    <strong>Brand</strong>
                                </td>
                                <td colspan="1">
                                    <strong style="text-align:right;">:</strong>
                                </td>
                                <td colspan="3"
                                    style="border-bottom: 1px solid black;text-align:left;width:25%;height:10px"
                                ></td>
                                <td colspan="2" style="width:25%">
                                    <strong>Contact No</strong>
                                </td>
                                <td colspan="1">:</td>
                                <td colspan="2" style="border-bottom: 1px solid black;text-align:center;width:25%;"
                                ></td>
                            </tr>
                            <tr>
                                <td colspan="2" style="width:25%">
                                    <strong>Model</strong>
                                </td>
                                <td colspan="1">
                                    <strong style="text-align:right;">:</strong>
                                </td>
                                <td colspan="3"
                                    style="border-bottom: 1px solid black;text-align:left;width:25%;height:10px"
                                ></td>
                                <td colspan="2" style="width:25%">
                                    <strong>Item Serial Number</strong>
                                </td>
                                <td colspan="1">:</td>
                                <td colspan="2" style="border-bottom: 1px solid black;text-align:center;width:25%;"
                                ></td>
                            </tr>
                            <tr>
                                <td colspan="2" style="width:25%">
                                    <strong>Next Service Date</strong>
                                </td>
                                <td colspan="1">
                                    <strong style="text-align:right;">:</strong>
                                </td>
                                <td colspan="3"
                                    style="border-bottom: 1px solid black;text-align:left;width:25%;height:10px"
                                ></td>
                                <td colspan="2" style="width:25%">
                                    <strong>Completed Date</strong>
                                </td>
                                <td colspan="1">:</td>
                                <td colspan="2" style="border-bottom: 1px solid black;text-align:center;width:25%;"
                                ></td>
                            </tr>
                        </table>
                    </div>
                    <br/>
                </div>
                <br/>
                <div class="col-12" style="background-color:black;text-align:center;float:left;width:100%;">
                    <strong style="color:white;font-size:20px;text-align:center;height: 10px;">TEST RESULT
                    </strong>
                </div>
                <table style="border:2px solid black;width:100%;border-collapse: collapse;"
                       class="table o_main_table table-bordered">
                    <thead>
                        <tr style="border: 2px solid black;vertical-align:middle;">
                            <th rowspan="2" style="border-left: 2px solid black;text-align:center">No.</th>
                            <th rowspan="2" style="border-left: 2px solid black;text-align:center">
                                <p>Fischer Bell</p>
                                <p>Mask Label</p>
                            </th>
                            <th rowspan="2"
                                style="border-left: 2px solid black;text-align:center;border-right: 2px solid black;">
                                Mask S/N:
                            </th>

                            <th colspan="5" style="border-left: 2px solid black;text-align:center">Factors
                            </th>
                            <th rowspan="2" style="border-left: 2px solid black;text-align:center">Results
                                (P/F)
                            </th>
                            <th rowspan="2"
                                style="border-left: 2px solid black;text-align:center;border-right: 2px solid black;">
                                Remarks
                            </th>
                        </tr>
                        <tr style="vertical-align:middle;border-left: 2px solid black;">
                            <th class="center" colspan="1">Nose Cup</th>
                            <th class="center" colspan="1" style="border-left:2px solid black;">Inhalation
                                <p>Valve</p>
                            </th>
                            <th class="center" colspan="1" style="border-left:2px solid black;">
                                <p>Exhalation</p>
                                <p>Valve</p>
                            </th>
                            <th class="center" colspan="1" style="border-left:2px solid black;">
                                Visor
                            </th>
                            <th class="center" colspan="1" style="border-left:2px solid black;">
                                Silicone
                                <p>Skirt</p>
                            </th>
                        </tr>
                    </thead>
                    <tbody class="table-bordered;text-align:center">
                        <tr style="border-left: 2px solid black;border-top:2px solid black">
                            <td style="border-left: 2px solid black; text-align:center">1</td>
                            <td style="border-left: 2px solid black; text-align:center">&amp;nbsp;</td>
                            <td style="border-left: 2px solid black; text-align:center">24</td>
                            <td style="border-left: 2px solid black; text-align:center;border-right: 2px solid black;">
                                &amp;nbsp; date
                            </td>
                            <td class="center">&amp;nbsp;</td>
                            <td class="center" style="border-left:2px solid black;">&amp;nbsp;
                            </td>
                            <td class="center" style="border-left:2px solid black;border-right: 2px solid black;">&amp;nbsp;</td>
                            <td class="center" style="border-left:2px solid black;border-right: 2px solid black;">&amp;nbsp;
                            </td>
                            <td class="center" style="border-left:2px solid black;border-right: 2px solid black;">
                                &amp;nbsp;
                            </td>
                            <td style="border-left: 2px solid black; text-align:center">&amp;nbsp;</td>
                        </tr>
                    </tbody>
                </table>
                <b>
                    <em style="font-size:14px">
                        *Results (Abbreviation):
                        <br/>
                        E - Expired ; G - Good Condition ; P - Passed ; F - Failed ; Coro - Corrosion ; Brk - Broken ;
                        TC - Torn/Cut ; Fry - Fraying ; Def
                        <br/>
                        - Deformed/Dented ; N.A - Not available
                    </em>
                </b>
                <br/>

                <div class="col-12" style="background-color:black;text-align:center;float:left;width:100%;">
                    <strong style="color:white;font-size:20px;text-align:center;height: 10px;">REMARKS
                    </strong>
                </div>

                <table style="border:1px solid black;width:100%;border-collapse: collapse;">
                    <tr style="border-left: 2px solid white;border-right: 2px solid white;">
                        <td style="border-bottom: 2px solid #C4BDBC;padding-top: 5px;">&amp;nbsp;</td>
                    </tr>
                    <tr style="border-left: 2px solid white;border-right: 2px solid white;">
                        <td style="border-bottom: 2px solid #C4BDBC;padding-top:5px;">&amp;nbsp;</td>
                    </tr>
                    <tr style="border-left: 2px solid white;border-right: 2px solid white;">
                        <td style="border-bottom: 2px solid #C4BDBC;padding-top: 5px;">&amp;nbsp;</td>
                    </tr>
                    <tr style="border-left: 2px solid white;border-right: 2px solid white;">
                        <td style="border-bottom: 2px solid white;padding-top: 5px;">&amp;nbsp;</td>
                    </tr>
                    <br/>
                </table>
                <div>
                    <t t-call="fcb_service.print_custom_footer"/>
                </div>
            </div>
        </template>
        <record id="paperformat_fischerbell_report_view" model="report.paperformat">
            <field name="name">Custom fischerbell report</field>
            <field name="default" eval="False"/>
            <field name="disable_shrinking" eval="False"/>
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">40.00</field>
            <field name="margin_bottom">0</field>
            <field name="margin_left">7</field>
            <field name="margin_right">7</field>
            <field name="dpi">90</field>
        </record>

        <record id="industry_fsm.task_custom_report" model="ir.actions.report">
            <field name="name">Task Report</field>
            <field name="model">project.task</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">industry_fsm.worksheet_custom</field>
            <field name="report_file">industry_fsm.worksheet_custom</field>
            <field name="print_report_name">'Worksheet %s - %s' % (object.name, object.partner_id.name)</field>
            <field name="binding_model_id" ref="model_project_task"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="paperformat_fischerbell_report_view"/>
        </record>
    </data>
</odoo>
