<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="fischerbell_custom_paper_test">
            <t t-if="o and 'company_id' in o">
                <t t-set="company" t-value="o.company_id"></t>
            </t>
            <t t-if="not o or not 'company_id' in o">
                <t t-set="company" t-value="res_company"></t>
            </t>
            <t>
                <div class="header">
                    <div class="col-6" style="float:left;width:50%;">
                        <img t-if="company.logo" t-att-src="image_data_uri(company.logo)"
                             style="max-height: 100px;"/>
                    </div>
                    <div class="col-6"
                         style="font:16px lucida-console,sans-serif !important; text-align: left;float:right;width:50%;">
                        <strong t-field="company.partner_id"/>
                        <br/>
                        <span t-if="company.partner_id.street">
                            <span t-if="company.partner_id.street" t-field="company.partner_id.street"/>,
                        </span>

                        <span t-if="company.partner_id.street2">
                            <span t-field="company.partner_id.street2"/>
                        </span>

                        <span t-if="company.partner_id.city" t-field="company.partner_id.city"/>

                        <span t-if="company.partner_id.country_id" t-field="company.partner_id.country_id"/>
                        <br/>
                        Tel :
                        <span class="col-6" t-if="company.partner_id.phone" t-field="company.partner_id.phone"/>
                        <span style="padding:15px"/>Fax :
                        <span class="col-6" t-if="company.partner_id.phone" t-field="company.partner_id.phone"/>
                        <br/>
                        W :
                        <span class="col-6" t-if="company.partner_id.website" t-field="company.partner_id.website"/>
                        <span style="padding:15px"/>E :
                        <span class="col-6" t-if="company.partner_id.phone" t-field="company.partner_id.phone"/>
                        <br/>
                        UEN :
                        <span class="col-6">200502661D</span>
                        <span style="padding:15px"/>GST REG No :
                        <span class="col-6">20-0502661D</span>
                        <br/>
                        <span t-if="company.partner_id.vat" t-field="company.partner_id.vat"/>
                        <br/>
                    </div>
                </div>
                <div class="col-12" style="background-color:black;text-align:center;float:left;width:100%;">
                    <strong style="color:white;font-size:25px;text-align:center;height: 16x;">PAPER TEST CERTIFICATEA
                    </strong>
                </div>
                <br/>
                <br/>
                <br/>
                <div class="row mt32 mb32 ">
                    <div>
                        <table class="table-borderless" style=" border-color:white;  font-weight: bold;">
                            <tr style="font-weight: bold;font-size: 21px;">
                                <th colspan="2"></th>
                                <th colspan="1"></th>
                                <th colspan="3"></th>
                                <th colspan="2"></th>
                                <th colspan="1"></th>
                                <th colspan="3"></th>
                            </tr>
                            <tr>
                                <td colspan="2" style="width:25%">
                                    <strong style="font-weight: bold;font-size: 16px;">Customer</strong>
                                </td>
                                <td colspan="1">
                                    <strong style="text-align:right;padding:5px">:</strong>
                                </td>
                                <td colspan="3"
                                    style="border-bottom: 1px solid black;text-align:left;width:25%;height:10px"
                                >
                                    <t t-out="o.partner_id.name"/>
                                </td>
                                <td colspan="2" style="width:25%">
                                    <strong style="font-weight: bold;font-size: 16px;">Our Reference No</strong>
                                </td>
                                <td colspan="1">:&amp;nbsp;</td>
                                <td colspan="2" style="border-bottom: 1px solid black;text-align:center;width:25%;"
                                ></td>
                            </tr>
                            <tr>
                                <td colspan="2" style="width:25%">
                                    <strong style="font-weight: bold;font-size: 16px;">Address</strong>
                                </td>
                                <td colspan="1">
                                    <strong style="text-align:right;padding:5px">:</strong>
                                </td>
                                <td colspan="3"
                                    style="border-bottom: 1px solid black;text-align:left;width:25%;height:10px"
                                ></td>
                                <td colspan="2" style="width:25%">
                                    <strong style="font-weight: bold;font-size: 16px;">Your Reference No</strong>
                                </td>
                                <td colspan="1">:&amp;nbsp;</td>
                                <td colspan="2" style="border-bottom: 1px solid black;text-align:center;width:25%;"
                                ></td>
                            </tr>
                            <tr>
                                <td colspan="2" style="width:25%">
                                </td>
                                <td colspan="1">
                                    <strong style="text-align:right;padding:5px">:</strong>
                                </td>
                                <td colspan="3"
                                    style="border-bottom: 1px solid black;text-align:left;width:25%;height:10px"
                                ></td>
                                <td colspan="2" style="width:25%">
                                    <strong style="font-weight: bold;font-size: 16px;">Requeste Date</strong>
                                </td>
                                <td colspan="1">:&amp;nbsp;</td>
                                <td colspan="2" style="border-bottom: 1px solid black;text-align:center;width:25%;"
                                ></td>
                            </tr>
                            <tr>
                                <td colspan="2" style="width:25%">
                                    <strong style="font-weight: bold;font-size: 16px;">Item Location</strong>
                                </td>
                                <td colspan="1">
                                    <strong style="text-align:right;padding:5px">:</strong>
                                </td>
                                <td colspan="3"
                                    style="border-bottom: 1px solid black;text-align:left;width:25%;height:10px"
                                ></td>
                                <td colspan="2" style="width:25%">
                                    <strong style="font-weight: bold;font-size: 16px;">Contact Person</strong>
                                </td>
                                <td colspan="1">:&amp;nbsp;</td>
                                <td colspan="2" style="border-bottom: 1px solid black;text-align:center;width:25%;"
                                ></td>
                            </tr>
                            <tr>
                                <td colspan="2" style="width:25%">
                                    <strong></strong>
                                </td>
                                <td colspan="1">
                                    <strong style="text-align:right;padding:5px"></strong>
                                </td>
                                <td colspan="3"
                                    style="border-bottom: 1px solid black;text-align:left;width:25%;height:10px"
                                ></td>
                                <td colspan="2" style="width:25%">
                                    <strong style="font-weight: bold;font-size: 16px;">Contact No</strong>
                                </td>
                                <td colspan="1">:&amp;nbsp;</td>
                                <td colspan="2" style="border-bottom: 1px solid black;text-align:center;width:25%;"
                                ></td>
                            </tr>
                            <tr>
                                <td colspan="2" style="width:25%">
                                    <strong style="font-weight: bold;font-size: 16px;">Next Inspection Date</strong>
                                </td>
                                <td colspan="1">
                                    <strong style="text-align:right;padding:5px">:</strong>
                                </td>
                                <td colspan="3"
                                    style="border-bottom: 1px solid black;text-align:left;width:25%;height:10px"
                                ></td>
                                <td colspan="2" style="width:25%">
                                    <strong style="font-weight: bold;font-size: 16px;">Item Serial Number</strong>
                                </td>
                                <td colspan="1">:&amp;nbsp;</td>
                                <td colspan="2" style="border-bottom: 1px solid black;text-align:center;width:25%;"
                                ></td>
                            </tr>
                            <tr>
                                <td colspan="2" style="width:25%">
                                    <strong></strong>
                                </td>
                                <td colspan="1">
                                    <strong style="text-align:right;padding:5px"></strong>
                                </td>
                                <td colspan="3"
                                    style="border-bottom: 1px solid black;text-align:left;width:25%;height:10px"
                                ></td>
                                <td colspan="2" style="width:25%">
                                    <strong style="font-weight: bold;font-size: 16px;">Completed Date</strong>
                                </td>
                                <td colspan="1">:&amp;nbsp;</td>
                                <td colspan="2" style="border-bottom: 1px solid black;text-align:center;width:25%;"
                                ></td>
                            </tr>
                        </table>
                    </div>
                    <br/>
                </div>

                <t t-set="worksheet_template_id"
                   t-value="env[o.worksheet_template_id.sudo().model_id.model].search([('x_project_task_id', '=', o.id)])"></t>

                <div class="col-12" style="background-color:black;text-align:center;float:left;width:100%;">
                    <strong style="color:white;ffont-size:20px;text-align:center;height: 10px;font-weight: bold;font-size: 16px;">
                        TEST RESULT (PASS/FAIL)
                    </strong>
                </div>
                <table style="border:2px solid black;width:100%;border-collapse: collapse;">
                    <thead>
                        <tr style="border: 2px solid black;text-align:center;vertical-align:middle">
                            <th colspan="1" style="border-left: 2px solid black;font-weight: bold;font-size: 16px;">
                                No.
                            </th>
                            <th colspan="2" style="border-left: 2px solid black;font-weight: bold;font-size: 16px;">
                                Serial No.
                            </th>
                            <th colspan="2" style="border-left: 2px solid black;font-weight: bold;font-size: 16px;">Head
                                top<br/>(Hood/Helmet)
                            </th>
                            <th colspan="3" style="border-left: 2px solid black;font-weight: bold;font-size: 16px;">
                                Fan
                                <br/>(Body,Belt<br/>Gasket)

                            </th>
                            <th colspan="2" style="border-left: 2px solid black;font-weight: bold;font-size: 16px;">
                                Warning System/
                                <br/>Alaram Signals
                            </th>
                            <th colspan="1" style="border-left: 2px solid black;font-weight: bold;font-size: 16px;">
                                Battery
                                Voltage<br/>Test /S/N:
                            </th>
                            <th colspan="1" style="border-left: 2px solid black;font-weight: bold;font-size: 16px;">
                                Airflow Test
                                Status
                            </th>
                        </tr>
                    </thead>
                    <tbody class="table-bordered">
                        <tr style="border-left: 2px solid black;vertical-align:middle">
                            <td colspan="1" style="border-left: 2px solid black;text-align:center">
                                1.
                            </td>
                            <td colspan="2" style="border-left: 2px solid black;text-align:center">
                                <t t-if="worksheet_template_id.x_studio_serial_no"
                                   t-esc="worksheet_template_id.x_studio_serial_no"/>
                            </td>
                            <td colspan="2" style="border-left: 2px solid black;text-align:center">
                                <t t-if="worksheet_template_id.x_studio_head_top"
                                   t-esc="worksheet_template_id.x_studio_head_top"/>
                            </td>
                            <td colspan="3" style="border-left: 2px solid black;text-align:center">
                                <t t-if="worksheet_template_id.x_studio_fan"
                                   t-esc="worksheet_template_id.x_studio_fan"/>
                            </td>
                            <td colspan="2" style="border-left: 2px solid black;text-align:center">
                                <t t-if="worksheet_template_id.x_studio_warning_system_alaram_signals"
                                   t-esc="worksheet_template_id.x_studio_warning_system_alaram_signals"/>
                            </td>
                            <td colspan="1" style="border-left: 2px solid black;text-align:center">
                                <t t-if="worksheet_template_id.x_studio_battery_voltage_test_sn"
                                   t-esc="worksheet_template_id.x_studio_battery_voltage_test_sn"/>
                            </td>
                            <td colspan="1" style="border-left: 2px solid black;text-align:center">
                                <t t-if="worksheet_template_id.x_studio_airflow_test_status"
                                   t-esc="worksheet_template_id.x_studio_airflow_test_status"/>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <br/>
                <div class="col-12" style="background-color:black;text-align:center;float:left;width:100%;">
                    <strong style="color:white;font-size:20px;text-align:center;height: 10px;">Work / PARTS REQUIRED
                    </strong>
                </div>

                <table style="border:1px solid black;width:100%;border-collapse: collapse;">
                    <tr style="border-left: 2px solid white;border-right: 2px solid white;">
                        <td style="border-bottom: 2px solid  #C4BDBC;">&amp;nbsp;</td>
                    </tr>
                    <tr style="border-left: 2px solid white;border-right: 2px solid white;">
                        <td style="border-bottom: 2px solid  #C4BDBC;">
                            1.Battery is not in good condition
                        </td>
                    </tr>
                    <tr style="border-left: 2px solid white;border-right: 2px solid white;">
                        <td style="border-bottom: 2px solid  #C4BDBC;">&amp;nbsp;</td>
                    </tr>
                    <tr style="border-right: 1px solid white;border-left: 2px solid white;">
                        <td style="border-bottom: 2px solid white;">&amp;nbsp;</td>
                    </tr>
                </table>
                <br/>
                <div class="col-12" style="background-color:black;text-align:center;float:left;width:100%;">
                    <strong style="color:white;font-size:20px;text-align:center;height: 10px;">REMARKS</strong>
                </div>

                <table style="border:1px solid black;width:100%;border-collapse: collapse;">
                    <tr style="border-left: 2px solid white;border-right: 2px solid white;">
                        <td style="border-bottom: 2px solid  #C4BDBC;">
                            <t t-if="worksheet_template_id.x_comments"
                               t-esc="worksheet_template_id.x_comments"/>
                        </td>
                    </tr>
                    <tr style="border-left: 2px solid white;border-right: 2px solid white;">
                        <td style="border-bottom: 2px solid  #C4BDBC;">&amp;nbsp;</td>
                    </tr>
                    <tr style="border-left: 2px solid white;border-right: 2px solid white;">
                        <td style="border-bottom: 2px solid  #C4BDBC;">&amp;nbsp;</td>
                    </tr>
                    <tr style="border-right: 1px solid white;border-left: 2px solid white;">
                        <td style="border-bottom: 2px solid white;">&amp;nbsp;</td>
                    </tr>
                </table>

                <div>
                    <t t-call="fcb_service.print_custom_footer"/>
                </div>
            </t>
        </template>
        <template id="report_fischerbell_custom_paper_test">
            <t t-call="web.html_container">
                <t t-call="web.basic_layout">
                    <t t-foreach="docs" t-as="o">
                        <t t-call="fcb_service.fischerbell_custom_paper_test" t-lang="o.partner_id.lang"/>
                    </t>
                </t>
            </t>
        </template>
        <record id="paperformat_fischerbell_report_view" model="report.paperformat">
            <field name="name">Custom fischerbell report</field>
            <field name="default" eval="False"/>
            <field name="disable_shrinking" eval="False"/>
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">40.00</field>
            <field name="margin_bottom">00</field>
            <field name="margin_left">7</field>
            <field name="margin_right">7</field>
            <field name="dpi">90</field>
        </record>

        <record id="action_paper_test_task" model="ir.actions.report">
            <field name="name">PAPER TEST CERTIFICATE</field>
            <field name="model">project.task</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">fcb_service.report_fischerbell_custom_paper_test</field>
            <field name="report_file">fcb_service.report_fischerbell_custom_paper_test</field>
            <field name="print_report_name">'Worksheet %s - %s' % (object.name, object.partner_id.name)</field>
            <field name="binding_model_id" eval="False"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="paperformat_fischerbell_report_view"/>
        </record>
    </data>
</odoo>
