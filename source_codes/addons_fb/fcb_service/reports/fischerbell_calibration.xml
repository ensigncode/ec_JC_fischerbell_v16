<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="fischerbell_custom_fischerbell_calibration">
            <t t-if="o and 'company_id' in o">
                <t t-set="company" t-value="o.company_id"></t>
            </t>
            <t t-if="not o or not 'company_id' in o">
                <t t-set="company" t-value="res_company"></t>
            </t>
            <div class="header">
                <div class="col-6" style="float:left;width:50%;">
                    <img t-if="company.logo" t-att-src="image_data_uri(company.logo)"
                         style="max-height: 100px;"/>
                </div>
                <div class="col-6"
                     style="font:16px lucida-console,sans-serif !important; text-align: left;float:right;width:50%;">
                    <strong t-field="company.partner_id"/>
                    <br/>
                    <span t-if="company.partner_id.street">
                        <span t-if="company.partner_id.street" t-field="company.partner_id.street"/>,
                    </span>

                    <span t-if="company.partner_id.street2">
                        <span t-field="company.partner_id.street2"/>
                    </span>

                    <span t-if="company.partner_id.city" t-field="company.partner_id.city"/>

                    <span t-if="company.partner_id.country_id" t-field="company.partner_id.country_id"/>
                    <br/>
                    Tel :
                    <span class="col-6" t-if="company.partner_id.phone" t-field="company.partner_id.phone"/>
                    <span style="padding:15px"/>Fax :
                    <span class="col-6" t-if="company.partner_id.phone" t-field="company.partner_id.phone"/>
                    <br/>
                    W :
                    <span class="col-6" t-if="company.partner_id.website" t-field="company.partner_id.website"/>
                    <span style="padding:15px"/>E :
                    <span class="col-6" t-if="company.partner_id.phone" t-field="company.partner_id.phone"/>
                    <br/>
                    UEN :
                    <span class="col-6">200502661D</span>
                    <span style="padding:15px"/>GST REG No :
                    <span class="col-6">20-0502661D</span>
                    <br/>
                    <span t-if="company.partner_id.vat" t-field="company.partner_id.vat"/>
                    <br/>
                </div>
            </div>
            <div>
                <div class="col-12" style="background-color:black;text-align:center;float:left;width:100%;">
                    <strong style="color:white;font-size:25px;text-align:center;height: 16x;">CALIBRATION CERTIFICATE
                    </strong>
                </div>
                <br/>
                <br/>
                <br/>
                <div class="row mt32 mb32 ">
                    <div>
                        <table>
                            <tr>
                                <th colspan="2"></th>
                                <th colspan="1"></th>
                                <th colspan="3"></th>
                                <th colspan="2"></th>
                                <th colspan="1"></th>
                                <th colspan="3"></th>
                            </tr>
                            <tr>
                                <td colspan="2" style="width:25%">
                                    <strong>Customer</strong>
                                </td>
                                <td colspan="1">
                                    <strong style="text-align:right;">:</strong>
                                </td>
                                <td colspan="3"
                                    style="border-bottom: 1px solid black;text-align:left;width:25%;height:10px">
                                    <t t-out="o.partner_id.name"/>
                                </td>
                                <td colspan="2" style="width:25%">
                                    <strong>Our Reference No</strong>
                                </td>
                                <td colspan="1">:</td>
                                <td colspan="2" style="border-bottom: 1px solid black;text-align:center;width:25%;"
                                ></td>
                            </tr>
                            <tr>
                                <td colspan="2" style="width:25%">
                                    <strong>Address</strong>
                                </td>
                                <td colspan="1">
                                    <strong style="text-align:right;">:</strong>
                                </td>
                                <td colspan="3"
                                    style="border-bottom: 1px solid black;text-align:left;width:25%;height:10px"
                                ></td>
                                <td colspan="2" style="width:25%">
                                    <strong>Your Reference No</strong>
                                </td>
                                <td colspan="1">:</td>
                                <td colspan="2" style="border-bottom: 1px solid black;text-align:center;width:25%;"
                                ></td>
                            </tr>
                            <tr>
                                <td colspan="2" style="width:25%">
                                </td>
                                <td colspan="1">
                                    <strong style="text-align:right;">:</strong>
                                </td>
                                <td colspan="3"
                                    style="border-bottom: 1px solid black;text-align:left;width:25%;height:10px"
                                ></td>
                                <td colspan="2" style="width:25%">
                                    <strong>Requeste Date</strong>
                                </td>
                                <td colspan="1">:</td>
                                <td colspan="2" style="border-bottom: 1px solid black;text-align:center;width:25%;"
                                ></td>
                            </tr>
                            <tr>
                                <td colspan="2" style="width:25%">
                                    <strong>Cylinder No.</strong>
                                </td>
                                <td colspan="1">
                                    <strong style="text-align:right;">:</strong>
                                </td>
                                <td colspan="3"
                                    style="border-bottom: 1px solid black;text-align:left;width:25%;height:10px"
                                ></td>
                                <td colspan="2" style="width:25%">
                                    <strong>Contact Person</strong>
                                </td>
                                <td colspan="1">:</td>
                                <td colspan="2" style="border-bottom: 1px solid black;text-align:center;width:25%;"
                                ></td>
                            </tr>
                            <tr>
                                <td colspan="2" style="width:25%">
                                    <strong>Brand</strong>
                                </td>
                                <td colspan="1">
                                    <strong style="text-align:right;">:</strong>
                                </td>
                                <td colspan="3"
                                    style="border-bottom: 1px solid black;text-align:left;width:25%;height:10px"
                                ></td>
                                <td colspan="2" style="width:25%">
                                    <strong>Contact No</strong>
                                </td>
                                <td colspan="1">:</td>
                                <td colspan="2" style="border-bottom: 1px solid black;text-align:center;width:25%;"
                                ></td>
                            </tr>
                            <tr>
                                <td colspan="2" style="width:25%">
                                    <strong>Model</strong>
                                </td>
                                <td colspan="1">
                                    <strong style="text-align:right;">:</strong>
                                </td>
                                <td colspan="3"
                                    style="border-bottom: 1px solid black;text-align:left;width:25%;height:10px"
                                ></td>
                                <td colspan="2" style="width:25%">
                                    <strong>Item Serial Number</strong>
                                </td>
                                <td colspan="1">:</td>
                                <td colspan="2" style="border-bottom: 1px solid black;text-align:center;width:25%;"
                                ></td>
                            </tr>
                            <tr>
                                <td colspan="2" style="width:25%">
                                    <strong>Next Service Date</strong>
                                </td>
                                <td colspan="1">
                                    <strong style="text-align:right;">:</strong>
                                </td>
                                <td colspan="3"
                                    style="border-bottom: 1px solid black;text-align:left;width:25%;height:10px"
                                ></td>
                                <td colspan="2" style="width:25%">
                                    <strong>Completed Date</strong>
                                </td>
                                <td colspan="1">:</td>
                                <td colspan="2" style="border-bottom: 1px solid black;text-align:center;width:25%;"
                                ></td>
                            </tr>
                        </table>
                    </div>
                    <br/>
                </div>
                <t t-set="worksheet_template_id"
                           t-value="env[o.worksheet_template_id.sudo().model_id.model].search([('x_project_task_id', '=', o.id)])"></t>

                <div class="col-12" style="background-color:black;text-align:center;float:left;width:100%;">
                    <strong style="color:white;font-size:20px;text-align:center;height: 10px;">EQUIPEMENT
                    </strong>
                </div>
                <div class="col-12" style="text-align:center;float:left;width:100%;">
                    <strong style="font-size:20px;text-align:center;height: 10px;">Zero &amp; Span Calibration
                    </strong>
                </div>

                <table style="border:2px solid black;width:100%;border-collapse: collapse;">
                    <thead>
                        <tr style="border: 2px solid black;text-align:center">
                            <th colspan="1" style="border-left: 2px solid black;">No.</th>
                            <th colspan="2" style="border-left: 2px solid black;">Installed
                                Sensors
                            </th>
                            <th colspan="2" style="border-left: 2px solid black;">CO Monitor S/N:
                            </th>
                            <th colspan="3" style="border-left: 2px solid black;">Unit S/N:</th>
                            <th colspan="2" style="border-left: 2px solid black;">Calibration Gas
                            </th>
                            <th colspan="1" style="border-left: 2px solid black;">Result</th>
                            <th colspan="1" style="border-left: 2px solid black;">Calibration Gas
                                Lot #
                            </th>
                        </tr>
                    </thead>
                    <tbody class="table-bordered;text-align:center">
                        <tr style="border-left: 2px solid black;">
                            <td colspan="1" style="border-left: 2px solid black;text-align:center">
                                1.
                            </td>
                            <td colspan="2" style="border-left: 2px solid black;text-align:center">
                                <t t-if="worksheet_template_id.x_studio_installed_sensors"
                                   t-esc="worksheet_template_id.x_studio_installed_sensors"/>
                            </td>
                            <td colspan="2" style="border-left: 2px solid black;text-align:center">
                                <t t-if="worksheet_template_id.x_studio_co_monitor_sn"
                                   t-esc="worksheet_template_id.x_studio_co_monitor_sn"/>
                            </td>
                            <td colspan="3" style="border-left: 2px solid black;text-align:center">
                                <t t-if="worksheet_template_id.x_studio_unit_sn"
                                   t-esc="worksheet_template_id.x_studio_unit_sn"/>
                            </td>
                            <td colspan="2" style="border-left: 2px solid black;text-align:center">
                                <t t-if="worksheet_template_id.x_studio_calibration_gas"
                                   t-esc="worksheet_template_id.x_studio_calibration_gas"/>
                            </td>
                            <td colspan="1" style="border-left: 2px solid black;text-align:center">
                                <t t-if="worksheet_template_id.x_studio_result"
                                   t-esc="worksheet_template_id.x_studio_result"/>
                            </td>
                            <td colspan="1" style="border-left: 2px solid black;text-align:center">
                                <t t-if="worksheet_template_id.x_studio_calibration_gas_lot_"
                                   t-esc="worksheet_template_id.x_studio_calibration_gas_lot_"/>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <br/>
                <div class="col-12" style="background-color:black;text-align:center;float:left;width:100%;">
                    <strong style="color:white;font-size:20px;text-align:center;height: 10px;">SERVICE REPORT</strong>
                </div>

                <table style="border:1px solid black;width:100%;border-collapse: collapse;">
                    <tr style="border-left: 2px solid white;border-right: 2px solid white;">
                        <td style="border-bottom: 2px solid  #C4BDBC;">&amp;nbsp;</td>
                    </tr>
                    <tr style="border-left: 2px solid white;border-right: 2px solid white;">
                        <td style="border-bottom: 2px solid  #C4BDBC;">&amp;nbsp;</td>
                    </tr>
                    <tr style="border-left: 2px solid white;border-right: 2px solid white;">
                        <td style="border-bottom: 2px solid  #C4BDBC;">&amp;nbsp;</td>
                    </tr>
                    <tr style="border-right: 1px solid white;border-left: 2px solid white;">
                        <td style="border-bottom: 2px solid white;">&amp;nbsp;</td>
                    </tr>
                </table>
                <br/>
                <div class="col-12" style="background-color:black;text-align:center;float:left;width:100%;">
                    <strong style="color:white;font-size:20px;text-align:center;height: 10px;">REMARKS</strong>
                </div>

                <table style="border:1px solid black;width:100%;border-collapse: collapse;">
                    <tr style="border-left: 2px solid white;border-right: 2px solid white;">
                        <td style="border-bottom: 2px solid  #C4BDBC;">
                            <t t-if="worksheet_template_id.x_comments" t-out="worksheet_template_id.x_comments"/>
                        </td>
                    </tr>
                    <tr style="border-left: 2px solid white;border-right: 2px solid white;">
                        <td style="border-bottom: 2px solid  #C4BDBC;">&amp;nbsp;</td>
                    </tr>
                    <tr style="border-left: 2px solid white;border-right: 2px solid white;">
                        <td style="border-bottom: 2px solid  #C4BDBC;">&amp;nbsp;</td>
                    </tr>
                    <tr style="border-right: 1px solid white;border-left: 2px solid white;">
                        <td style="border-bottom: 2px solid white;">&amp;nbsp;</td>
                    </tr>
                </table>

                <div>
                    <t t-call="fcb_service.print_custom_footer"/>
                </div>
            </div>
        </template>
        <template id="report_fischerbell_custom_fischerbell_calibration">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="fcb_service.fischerbell_custom_fischerbell_calibration" t-lang="o.partner_id.lang"/>
                </t>
            </t>
        </template>
        <record id="paperformat_fischerbell_report_view" model="report.paperformat">
            <field name="name">Custom fischerbell report</field>
            <field name="default" eval="False"/>
            <field name="disable_shrinking" eval="False"/>
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">40.00</field>
            <field name="margin_bottom">00</field>
            <field name="margin_left">7</field>
            <field name="margin_right">7</field>
            <field name="dpi">90</field>
        </record>

        <record id="fischerbell_calibration_task_custom_report" model="ir.actions.report">
            <field name="name">CALIBRATION CERTIFICATE</field>
            <field name="model">project.task</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">fcb_service.report_fischerbell_custom_fischerbell_calibration</field>
            <field name="report_file">fcb_service.report_fischerbell_custom_fischerbell_calibration</field>
            <field name="print_report_name">'Worksheet %s - %s' % (object.name, object.partner_id.name)</field>
            <field name="binding_model_id" eval="False"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="paperformat_fischerbell_report_view"/>
        </record>
    </data>
</odoo>
