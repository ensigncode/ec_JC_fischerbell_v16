<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<template id="print_custom_footer">
		<t t-call="web.html_container">
			 <t t-call="web.basic_layout">
			<t t-foreach="docs" t-as="doc">
				<div class="page">
					<div style="border: 1px solid black; padding: 10px;">
						<b>Policies:</b>
						<br/>
						<li style="font-size: 15px;">
							<b>Evaluation charges will be applicable should the repair not be accepted upon our
								quotation unless otherwise stated.
							</b>
						</li>
						<li style="font-size: 15px;">
							<b>The user should decide on the usability of this equipment based on its requirement
								and intended use.
							</b>
						</li>
						<li style="font-size: 15px;">
							<b>The results or findings are applicable at the time of inspection.</b>
						</li>
						<li style="font-size: 15px;">
							<b>This Report shall not be reproduced except in full without written approval of
								Fischer Bell.
							</b>
						</li>
						<li style="font-size: 15px;">
							<b>3 months warranty starts from the completion date for parts changed and repair.</b>
						</li>
						<b>Inspected by:</b>
						<div>
							<img src="/fcb_service/static/src/img/bee.jpg" alt="Image Description" width="130" height="100"/>
<!--							<img src="/fischerbell_custom/static/src/img/fischerbell_header.jpeg" width="400" height="100" style="margin-bottom: 10px;"/>-->
<!--							<img src="/fcb_service/static/src/img/sign.jpg" alt="img"-->
<!--							     style="height: 50px;width: 100px; margin-left: 20px;"/>-->
						</div>
						<hr style="border-top: 1px solid black; margin-bottom: 2px; margin-top: 20px;"/>
						<div>Name &amp; Signature :</div>
						<br/>
						<br/>
					</div>
				</div>
				</t>
			</t>
		</t>
	</template>

	<record id="custom_footer" model="ir.actions.report">
		<field name="name">Custom Footer</field>
		<field name="model">sale.order</field>
		<field name="report_type">qweb-pdf</field>
		<field name="report_name">fcb_service.print_custom_footer</field>
		<field name="report_file">fcb_service.print_custom_footer</field>
		<field name="binding_model_id" ref="sale.model_sale_order"/>
		<field name="binding_type">report</field>
	</record>
</odoo>

