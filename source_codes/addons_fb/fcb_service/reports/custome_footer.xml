<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<template id="print_custom_footer">
		<t t-call="web.html_container">
			 <t t-call="web.basic_layout">
			<t t-foreach="docs" t-as="doc">
				<div class="page">
					<div style="border: 1px solid black; padding: 10px;">
						<b>Policies:</b>
						<br/>
						<li style="font-size: 15px;">
							<b>Evaluation charges will be applicable should the repair not be accepted upon our
								quotation unless otherwise stated.
							</b>
						</li>
						<li style="font-size: 15px;">
							<b>The user should decide on the usability of this equipment based on its requirement
								and intended use.
							</b>
						</li>
						<li style="font-size: 15px;">
							<b>The results or findings are applicable at the time of inspection.</b>
						</li>
						<li style="font-size: 15px;">
							<b>This Report shall not be reproduced except in full without written approval of
								Fischer Bell.
							</b>
						</li>
						<li style="font-size: 15px;">
							<b>3 months warranty starts from the completion date for parts changed and repair.</b>
						</li>
						<b>Inspected by:</b>
						<t t-set="worksheet_template_id"
                       t-value="env[o.worksheet_template_id.sudo().model_id.model].search([('x_project_task_id', '=', o.id)])"></t>
						<div class="row">
							<div class="col-6">
								<t t-if="o.worksheet_template_id.name in 'CALIBRATION CERTIFICATE'">
									<img t-if="worksheet_template_id.x_studio_signature_calibration_certificate" t-att-src="image_data_uri(worksheet_template_id.x_studio_signature_calibration_certificate)" width="130" height="100" style="display: block; width: 200px; text-align: left; border-bottom: 1px solid;"/>
								</t>
								<t t-if="o.worksheet_template_id.name in 'CERT TEAM INSPECTION REPORT'">
									<img t-if="worksheet_template_id.x_studio_signature_cert_team_inspection_report" t-att-src="image_data_uri(worksheet_template_id.x_studio_signature_cert_team_inspection_report)" width="130" height="100" style="display: block; width: 200px; text-align: left; border-bottom: 1px solid;"/>
								</t>
								<t t-if="o.worksheet_template_id.name in 'EBA SERVICE CERTIFICATE'">
									<img t-if="worksheet_template_id.x_studio_signature_eba_service_certificate" t-att-src="image_data_uri(worksheet_template_id.x_studio_signature_eba_service_certificate)" width="130" height="100" style="display: block; width: 200px; text-align: left; border-bottom: 1px solid;"/>
								</t>
								<t t-if="o.worksheet_template_id.name in 'HAZMAT SUIT INSPECTION REPORT'">
									<img t-if="worksheet_template_id.x_studio_signature_hazmat_suit_inspection_report" t-att-src="image_data_uri(worksheet_template_id.x_studio_signature_hazmat_suit_inspection_report)" width="130" height="100" style="display: block; width: 200px; text-align: left; border-bottom: 1px solid;"/>
								</t>
								<t t-if="o.worksheet_template_id.name in 'INSTRUMENT EVALUATION/REPAIR REPORT'">
									<img t-if="worksheet_template_id.x_studio_signature_instrument_evaluation_report" t-att-src="image_data_uri(worksheet_template_id.x_studio_signature_instrument_evaluation_report)" width="130" height="100" style="display: block; width: 200px; text-align: left; border-bottom: 1px solid;"/>
								</t>
								<t t-if="o.worksheet_template_id.name in 'LIFE JACKET INSPECTION REPORT'">
									<img t-if="worksheet_template_id.x_studio_signature_life_jacket_inspection_report" t-att-src="image_data_uri(worksheet_template_id.x_studio_signature_life_jacket_inspection_report)" width="130" height="100" style="display: block; width: 200px; text-align: left; border-bottom: 1px solid;"/>
								</t>
								<t t-if="o.worksheet_template_id.name in 'MEDICAL OXYGEN RESUSCITATOR'">
									<img t-if="worksheet_template_id.x_studio_signature_medical_oxygen_resuscitator" t-att-src="image_data_uri(worksheet_template_id.x_studio_signature_medical_oxygen_resuscitator)" width="130" height="100" style="display: block; width: 200px; text-align: left; border-bottom: 1px solid;"/>
								</t>
								<t t-if="o.worksheet_template_id.name in 'PAPER TEST CERTIFICATE'">
									<img t-if="worksheet_template_id.x_studio_signature_paper_test_certificate" t-att-src="image_data_uri(worksheet_template_id.x_studio_signature_paper_test_certificate)" width="130" height="100" style="display: block; width: 200px; text-align: left; border-bottom: 1px solid;"/>
								</t>
								<t t-if="o.worksheet_template_id.name in 'PERSONAL FALL PROTECTION INSPECTION REPORT'">
									<img t-if="worksheet_template_id.x_studio_signature_personal_fall_protection" t-att-src="image_data_uri(worksheet_template_id.x_studio_signature_personal_fall_protection)" width="130" height="100" style="display: block; width: 200px; text-align: left; border-bottom: 1px solid;"/>
								</t>
								<t t-if="o.worksheet_template_id.name in 'SCBA MASK INSPECTION REPORT'">
									<img t-if="worksheet_template_id.x_studio_signature_scba_mask_inspection_report" t-att-src="image_data_uri(worksheet_template_id.x_studio_signature_scba_mask_inspection_report)" width="130" height="100" style="display: block; width: 200px; text-align: left; border-bottom: 1px solid;"/>
								</t>
							</div>
							<div class="col-6">
								<img t-if="o.company_id.company_stamp" t-att-src="image_data_uri(o.company_id.company_stamp)" alt="Stamp" width="130" height="100" style="display: block; width: 200px; text-align: right; border-bottom: 1px solid;"/>
							</div>
						</div>
						<hr style="border-top: 1px solid black; margin-bottom: 2px; margin-top: 20px;"/>
						<div>Name &amp; Signature :</div>
						<br/>
						<br/>
					</div>
				</div>
				</t>
			</t>
		</t>
	</template>

	<record id="custom_footer" model="ir.actions.report">
		<field name="name">Custom Footer</field>
		<field name="model">sale.order</field>
		<field name="report_type">qweb-pdf</field>
		<field name="report_name">fcb_service.print_custom_footer</field>
		<field name="report_file">fcb_service.print_custom_footer</field>
		<field name="binding_model_id" ref="sale.model_sale_order"/>
		<field name="binding_type">report</field>
	</record>
</odoo>

