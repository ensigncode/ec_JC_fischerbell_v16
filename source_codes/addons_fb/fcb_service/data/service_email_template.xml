<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
		<!-- Email Template -->
		<record id="email_template_service_reminder" model="mail.template">
			<field name="name">Service Reminder Email</field>
			<field name="model_id"
			       ref="model_equipment_service"/>
			<field name="subject">Service Reminder</field>
			<field name="lang">${object.partner_id.lang}</field>
			<field name="auto_delete" eval="False"/>
			<field name="body_html" type="html">
				<p>Hello <t t-out="object.partner_id.name or ''"></t>,
				</p>
				<p>your service for <t t-out="object.product_id.name or ''"></t> is due on <t
						t-out="object.service_date.strftime('%d-%m-%Y')"></t>,please contect sales team to get
					quote.
				</p>
				<p>Regards,</p>
				<p><t t-out="object.env.company.name or ''"></t></p>
			</field>
		</record>
	</data>
</odoo>
