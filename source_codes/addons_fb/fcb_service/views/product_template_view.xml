<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_templates_form_views_inherit_service" model="ir.ui.view">
        <field name="name">product.template.form.views.inherit.service</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='general_information']//group//group[@name='group_general']//field[@name='detailed_type']"
                   position="after">
                <field name="is_serviceable"/>
            </xpath>
            <xpath expr="//page[@name='invoicing']" position="after">
                <page string="Service" name="service" attrs="{'invisible': [('detailed_type', '=', 'service')]}">
                    <div>
                        <group>
                            <group>
                                <field name="required_calibration"/>
                            </group>
                        </group>
                        <field name="extra_product_ids" widget="many2many_tags" invisible="1"/>
                        <br/>
                        <br/>

                        <group string="Service Products" attrs="{'invisible': [('is_serviceable', '=',False)]}">
                            <field name="service_product_ids" colspan="2" nolabel="1" >
                                <tree editable="bottom" string="Service Products">
                                    <field name="extra_product_ids" widget="many2many_tags" invisible="1"/>
                                    <field name="product_variant_id"/>
                                    <field name="service_time"/>
                                    <field name="reminder_time"/>
                                </tree>
                            </field>
                        </group>
                    </div>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
