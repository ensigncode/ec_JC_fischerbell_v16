    <record id="view_task_form2_inherited" model="ir.ui.view">
        <field name="name">view.task.form2.inherit</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="industry_fsm_sale.view_task_form2_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_fsm_create_quotation']" position='after'>
                <button class="btn-secondary" name="action_print_calibration_report" type="object"
                        string="CALIBRATION CERTIFICATE"
                        attrs="{'invisible': [('is_fsm', '!=', True)]}"
                        title="Fischerbell Report" data-hotkey="x"/>
                <button class="btn-secondary" name="action_cert_inspection_report" type="object"
                        string="CERT TEAM INSPECTION REPORT"
                        attrs="{'invisible': [('is_fsm', '!=', True)]}"
                        title="Fischerbell Report" data-hotkey="x"/>
                <button class="btn-secondary" name="action_print_eba_service_certificate" type="object"
                        string="EBA SERVICE CERTIFICATE"
                        attrs="{'invisible': [('is_fsm', '!=', True)]}"
                        title="Fischerbell Report" data-hotkey="x"/>
                <button class="btn-secondary" name="action_print_huzmal_task_custom_report" type="object"
                        string="HUZMAT SUIT INSPECTION REPORT"
                        attrs="{'invisible': [('is_fsm', '!=', True)]}"
                        title="Fischerbell Report" data-hotkey="x"/>
                <button class="btn-secondary" name="action_fischerbell_custom_life_jacket_report" type="object"
                        string="LIFE JACKET INSPECTION REPORT"
                        attrs="{'invisible': [('is_fsm', '!=', True)]}"
                        title="Fischerbell Report" data-hotkey="x"/>
                <button class="btn-secondary" name="action_industry_ev_task_custom_report" type="object"
                        string="INSTRUMENT EVALUATION/REPAIR REPORT"
                        attrs="{'invisible': [('is_fsm', '!=', True)]}"
                        title="Fischerbell Report" data-hotkey="x"/>
                <button class="btn-secondary" name="action_medical_oxy_task_custom_report" type="object"
                        string="MEDICAL OXYGEN RESUSCITATOR"
                        attrs="{'invisible': [('is_fsm', '!=', True)]}"
                        title="Fischerbell Report" data-hotkey="x"/>
                <button class="btn-secondary" name="action_paper_test_task_custom_report" type="object"
                        string="PAPER TEST CERTIFICATEA"
                        attrs="{'invisible': [('is_fsm', '!=', True)]}"
                        title="Fischerbell Report" data-hotkey="x"/>
                <button class="btn-secondary" name="action_worksheet_custom_personal_fall_protection" type="object"
                        string="PERSONAL FALL PROTECTION INSPECTION REPORT"
                        attrs="{'invisible': [('is_fsm', '!=', True)]}"
                        title="Fischerbell Report" data-hotkey="x"/>
                <button class="btn-secondary" name="action_scba_task_custom_report" type="object"
                        string="SCBA MASK INSPECTION REPORT"
                        attrs="{'invisible': [('is_fsm', '!=', True)]}"
                        title="Fischerbell Report" data-hotkey="x"/>
            </xpath>
        </field>
    </record>

