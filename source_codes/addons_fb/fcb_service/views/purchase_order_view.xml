<?xml version='1.0' encoding='UTF-8' ?>
<odoo>
    <record id="fischerbell_purchase_order_view_form_inherit" model="ir.ui.view">
        <field name="name">fischerbell.purchase.order.form.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase_stock.purchase_order_view_form_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='incoterm_id']" position="replace">
                <field name="incoterm_id" invisible="1"/>
                <field name="incoterm_location"  invisible="1"/>
            </xpath>
        </field>
    </record>
</odoo>