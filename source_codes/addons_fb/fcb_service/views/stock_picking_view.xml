<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_picking_packing_view_form_inherited_1" model="ir.ui.view">
        <field name="name">stock.picking</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='origin']" position="after">
                <field name="task_id"/>
            </xpath>
            <xpath expr="//field[@name='location_dest_id']" position="after">
                <field name="pick_up"/>
            </xpath>
            <xpath expr="//page[@name='note']" position="after">
                <page string="Skip Reason Lines" name="skip_reasons">
                    <field name="skip_reason_line_ids">
                        <tree editable="bottom">
                            <field name="reason_date"/>
                            <field name="name"/>
                        </tree>
                    </field>
                </page>
                <page string="Attachments" name="attachments" attrs="{'invisible':[('picking_type_code', '!=', 'incoming')]}" >
                    <group>
                        <field name="attachment_ids" widget="many2many_binary" nolabel="1"
                       />
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>