<?xml version='1.0' encoding='UTF-8' ?>
<odoo>
    <template id="portal_list_transfer_inherited" inherit_id="portal_signature.portal_list_transfer">

        <xpath expr="//thead/tr/th[3]" position="replace">
            <th class='d-none'>
                <span class='d-none d-md-inline'>Name</span>
            </th>
        </xpath>
        <xpath expr="//thead/tr/th[4]" position="replace">
            <th>
                <span class='d-none d-md-inline'>Deadline</span>
            </th>
        </xpath>
        <xpath expr="//thead/tr/th[5]" position="replace">
            <th>
                <span class='d-none d-md-inline'>Adderess</span>
            </th>
        </xpath>
<!--        <xpath expr="//thead/tr/th[5]" position="after">-->
<!--            <th>-->
<!--                <span class='d-none d-md-inline'>PRINTe</span>-->
<!--            </th>-->
<!--        </xpath>-->
        <xpath expr="//tbody//t//tr[1]//td[3]" position="replace">
            <td class="d-none" id="picking">
                <t t-esc="picking_id.id"/>
            </td>
        </xpath>

        <xpath expr="//tbody//t//tr[1]//td[4]" position="replace">
            <td>
                <t t-esc="picking_id.date_deadline" t-options='{"widget": "date","format": "dd-MM-yyyy"}'/>
            </td>
        </xpath>

        <xpath expr="//tbody//t//tr[1]//td[5]" position="replace">
            <td class="d-none" id="picking">
                <td>
                    <t t-if="picking_id.is_dropship">
                        <t t-if="picking_id.responsible_customer_id">
                            <p>
                                <t t-if="picking_id.responsible_customer_id.street"
                                   t-esc="picking_id.responsible_customer_id.street"/>,
                                <t t-if="picking_id.responsible_customer_id.street2"
                                   t-esc="picking_id.responsible_customer_id.street2"/>
                                <br/>
                                <t t-if="picking_id.responsible_customer_id.city"
                                   t-esc="picking_id.responsible_customer_id.city"/>,
                                <t t-if="picking_id.responsible_customer_id.state_id.name"
                                   t-esc="picking_id.responsible_customer_id.state_id.name"/>
                                <br/>
                                <t t-if="picking_id.responsible_customer_id.country_id.name"
                                   t-esc="picking_id.responsible_customer_id.country_id.name"/>,
                                <t t-if="picking_id.responsible_customer_id.zip"
                                   t-esc="picking_id.responsible_customer_id.zip"/>
                            </p>
                        </t>
                        <t t-else="">
                            <p>
                                <t t-if="picking_id.partner_id.street" t-esc="picking_id.partner_id.street"/>,
                                <t t-if="picking_id.partner_id.street2" t-esc="picking_id.partner_id.street2"/>
                                <br/>
                                <t t-if="picking_id.partner_id.city" t-esc="picking_id.partner_id.city"/>,
                                <t t-if="picking_id.partner_id.state_id.name"
                                   t-esc="picking_id.partner_id.state_id.name"/>
                                <br/>
                                <t t-if="picking_id.partner_id.country_id.name"
                                   t-esc="picking_id.partner_id.country_id.name"/>,
                                <t t-if="picking_id.partner_id.zip" t-esc="picking_id.partner_id.zip"/>
                            </p>
                        </t>
                    </t>
                    <t t-else="">
                        <t t-if="picking_id.partner_id.parent_id">
                            <p>
                                <t t-esc="picking_id.partner_id.parent_id.street"/>,
                                <t t-esc="picking_id.partner_id.parent_id.street2"/>
                                <br/>
                                <t t-esc="picking_id.partner_id.parent_id.city"/>,
                                <t t-esc="picking_id.partner_id.parent_id.state_id.name"/>
                                <br/>
                                <t t-esc="picking_id.partner_id.parent_id.country_id.name"/>,
                                <t t-esc="picking_id.partner_id.parent_id.zip"/>
                            </p>
                        </t>
                        <t t-else="">
                            <p>
                                <t t-if="picking_id.partner_id.street" t-esc="picking_id.partner_id.street"/>,
                                <t t-if="picking_id.partner_id.street2" t-esc="picking_id.partner_id.street2"/>
                                <br/>
                                <t t-if="picking_id.partner_id.city" t-esc="picking_id.partner_id.city"/>
                                ,
                                <t t-if="picking_id.partner_id.state_id.name"
                                   t-esc="picking_id.partner_id.state_id.name"/>
                                <br/>
                                <t t-if="picking_id.partner_id.country_id.name"
                                   t-esc="picking_id.partner_id.country_id.name"/>,
                                <t t-if="picking_id.partner_id.zip" t-esc="picking_id.partner_id.zip"/>
                            </p>
                        </t>
                    </t>

                </td>
            </td>
        </xpath>
        <xpath expr="//tbody//t//tr[1]//td[6]" position="after">
            <td>
                <t t-set="picking_id" t-value="picking_id.sudo()"/>
                <a role="button"
                   class="btn btn-primary btn-lg"
                   t-att-href="'/my/transfer/%s/print' % picking_id.id">Print
                    <i class="fa fa-fw fa-download" role="img" aria-label="Download certification"
                       title="Download certification"/>
                </a>
            </td>
        </xpath>
        <xpath expr="//tbody//td[hasclass('portal_btn_blocks')]/button[1]" position="replace">
            <button class="btn btn-link o_icon_button text-primary approve_btn d-none" t-att-data-id="picking_id.id"
                    type="button">
                <i class="fa fa-pencil"/>
                Signature
            </button>
        </xpath>

    </template>
    <template id="portal_my_transfer_detail_inherited" inherit_id="portal_signature.portal_my_transfer_detail">

        <xpath expr="//tbody/tr[6]" position="after">
            <tr>
                <td style="font-weight:bold;width:20%;">Signature</td>

                <td>
                    <div class="modal fade" t-attf-id="modalsignatureaccept_{{ picking_id.id }}" tabindex="-1"
                         aria-labelledby="signature" role="dialog" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered" style="margin-left: 263px;" role="document">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="signatureForm">Signature</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                                            aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <t t-call="portal.signature_form">
                                        <t t-set="call_url"
                                           t-value="'/my/need_approved?picking_id=%s' % picking_id.id"/>
                                        <t t-if="picking_id.is_dropship">
                                            <t t-set="default_name" t-value="picking_id.responsible_customer_id.name"/>
                                        </t>
                                        <t t-else="">
                                            <t t-set="default_name" t-value="picking_id.partner_id.name"/>
                                        </t>
                                    </t>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="modal fade skip_delivery_modal" t-attf-id="modaldeliveryskip_{{ picking_id.id }}"
                         tabindex="-1" aria-labelledby="signature" role="dialog" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered" role="document">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="">Skip Delivery</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"
                                            aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <label class="" for="skip_reason"></label>
                                    <textarea type="text" rows="4" cols="50"
                                              placeholder=" Give the reason for skip this delivery." id="skip_reason"
                                              name="skip_reason"></textarea>
                                </div>
                                <div class="modal-footer">
                                    <button type="" class="btn btn-primary submit_skip_delivery"
                                            t-att-data-id="picking_id.id">Submit
                                    </button>
                                    <button type="button" data-bs-dismiss="modal" class="btn btn-secondary">Cancel
                                    </button>
                                </div>
                            </div>
                        </div>
                    </div>

                    <button class="btn btn-link o_icon_button text-primary approve_btn "
                            t-att-data-id="picking_id.id"
                            type="button">
                        <i class="fa fa-pencil"/>
                        Signature
                    </button>
                </td>
            </tr>
        </xpath>
    </template>
</odoo>