<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="view_sale_project_inherit_form_button_report" model="ir.ui.view">
		<field name="name">project.task.view.inherit.report</field>
		<field name="model">project.task</field>
		<field name="inherit_id" ref="project.view_task_form2"/>
		<field name="arch" type="xml">
			<xpath expr="//button[@name='action_assign_to_me']" position="after">
				<button class="btn-secondary" name="action_report" type="object" string="Report"/>
				<button class="btn-secondary" name="send_for_inspection" type="object"
				        string="Send for Inspection"/>
<!--				<button class="btn-secondary" name="done_inspection" type="object" string="Done"/>-->
			</xpath>
			<xpath expr="//div[hasclass('oe_button_box')]" position="inside">
				<button type="object" name="show_transfer" class="oe_stat_button" icon="fa-list"
				        >
					<field name="count_transfer" widget="statinfo" string="Show Transfer"
					       />
				</button>
			</xpath>
			<xpath expr="//field[@name='tag_ids']" position="after">
				<field name="product_id"/>
			</xpath>
			<xpath expr="//field[@name='is_fsm']" position="attributes">
				<attribute name="force_save">1</attribute>
			</xpath>
		</field>
	</record>
</odoo>
