<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="view_sale_project_inherit_form_button_report" model="ir.ui.view">
		<field name="name">project.task.view.inherit.report</field>
		<field name="model">project.task</field>
		<field name="inherit_id" ref="project.view_task_form2"/>
		<field name="arch" type="xml">
			<xpath expr="//button[@name='action_assign_to_me']" position="after">
				<button class="btn-secondary" name="send_for_inspection" type="object"
				        string="Send for Inspection" attrs="{'invisible': ['|', ('count_transfer', '>', 0), ('equipment_product_id', '=', False)]}"/>
			</xpath>
			<xpath expr="//div[hasclass('oe_button_box')]" position="inside">
				<button type="object" name="show_transfer" class="oe_stat_button" icon="fa-list"
				       attrs="{'invisible': [('count_transfer', '=', 0)]}">
					<field name="count_transfer" widget="statinfo" string="Show Transfer"
					      attrs="{'invisible': [('count_transfer', '=', 0)]}" />
				</button>
			</xpath>
			<xpath expr="//field[@name='tag_ids']" position="after">
				<field name="product_id"/>
				<field name="service_date"/>
				<field name="next_service_date"/>
				<field name="equipment_database_product" invisible="1"/>
				<field name="equipment_database_serial" invisible="1"/>
			</xpath>
			<xpath expr="//page[@name='extra_info']" position="after">
                <page name="equipment_service_database" string="Equipment Service Database">
					<group>
						<group>
							<field name="equipment_product_id" domain="equipment_database_product"/>
							<field name="equipment_database_id" domain="equipment_database_serial" context="{'model_name':'project.task'}"/>
						</group>
					</group>
				</page>
            </xpath>
		</field>
	</record>

	<record id="view_task_search_form_hr_extended_service_fields" model="ir.ui.view">
		<field name="name">helpdesk.ticket.view.search.inherit.service.task</field>
		<field name="model">helpdesk.ticket</field>
		<field name="inherit_id" ref="helpdesk.helpdesk_tickets_view_search"/>
		<field name="arch" type="xml">
			<xpath expr="//field[@name='team_id']" position="after">
				<field name="service_type" string="Service Type"/>
				<field name="service_priority" string="Service Priority"/>
			</xpath>
			<filter name="my_ticket" position="after">
				<filter string="In House Service" name="In House Service"
				        domain="[('service_type', '=', 'inhouse_service')]"/>
				<filter string="Onsite Calibration" name="Onsite Calibration"
				        domain="[('service_type', '=', 'onsite_service')]"/>
				<filter string="Outsource to 3rd Party Supplier" name="outsource_service"
				        domain="[('service_type', '=', 'outsource_service')]"/>
				<filter string="Urgent Priority" name="urgent_priority"
				        domain="[('service_priority', '=', 'urgent')]"/>
				<filter string="Standard Priority" name="standard_priority"
				        domain="[('service_priority', '=', 'standard')]"/>
				<filter string="Express Priority" name="standard_priority"
				        domain="[('service_priority', '=', 'standard')]"/>
			</filter>
			<group expand="0" string="Group By">
                  <filter string="Service Type" name="service_type" context="{'group_by':'service_type'}"/>
                  <filter string="Priority" name="service_priority" context="{'group_by':'service_priority'}"/>
			</group>
		</field>
	</record>
</odoo>
