<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="fischerbell_import_export_wizard" model="ir.ui.view">
            <field name="name">eyewear.import.export.data</field>
            <field name="model">eyewear.import.export.data</field>
            <field name="arch" type="xml">
                <form>
                    <footer>
                        <button name="export_order_line" string="Export Template" type="object" default_focus="1" class="oe_highlight" />
                        or
                        <button string="Cancel" class="oe_link" special="cancel" />
                    </footer>
                </form>
            </field>
        </record>
        <record id="act_import_export_eyewear_order_drc" model="ir.actions.act_window">
            <field name="name">Import Eyewear</field>
            <field name="res_model">eyewear.import.export.data</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="fischerbell_import_export_wizard"/>
            <field name="target">new</field>
        </record>


		<menuitem id="menu_import_export_wizard_main"
          name="Import/Export Wizard"
          parent="rx_eyewear_menu"
          sequence="5"/>
        <menuitem id="menu_import_export_wizard"
          name="Import/Export Wizard"
          parent="menu_import_export_wizard_main"
          action="act_import_export_eyewear_order_drc"
          sequence="5"/>
         </data>
</odoo>