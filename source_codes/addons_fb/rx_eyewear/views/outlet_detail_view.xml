<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_outlet_detail_form" model="ir.ui.view">
            <field name="name">outlet.detail.form</field>
            <field name="model">outlet.detail</field>
            <field name="arch" type="xml">
                <form string="Outlet Detail">
                    <sheet>
                        <group>
                            <group>
                                <field name="name" string="Name" />
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="view_outlet_detail_tree" model="ir.ui.view">
            <field name="name">outlet.detail.tree</field>
            <field name="model">outlet.detail</field>
            <field name="arch" type="xml">
                <tree string="Outlet Details">
                    <field name="name" string="Name" />
                </tree>
            </field>
        </record>
        <record id="action_outlet_detail" model="ir.actions.act_window">
            <field name="name">Outlet Details</field>
            <field name="res_model">outlet.detail</field>
            <field name="view_mode">tree,form</field>
        </record>

    </data>
</odoo>