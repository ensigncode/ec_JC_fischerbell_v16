<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_fee_eyewear_form" model="ir.ui.view">
            <field name="name">fee.eyewear.form</field>
            <field name="model">fee.eyewear</field>
            <field name="arch" type="xml">
                <form string="Optician Term Condition">
                    <sheet>
                        <group>
                            <group>
                                <field name="name" string="Name" />
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="fee_eyewear_view_tree" model="ir.ui.view">
            <field name="name">fee.eyewear.view.tree</field>
            <field name="model">fee.eyewear</field>
            <field name="arch" type="xml">
                <tree string="Invoices Analysis">
                    <field name="name" />
                </tree>
            </field>
        </record>
        <record id="action_fee_eyewear_detail" model="ir.actions.act_window">
            <field name="name">Fee Eyewear</field>
            <field name="res_model">fee.eyewear</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'create': 0}</field>
        </record>
    </data>
</odoo>