<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <template id="opptician_detail_page_template" name="Optician Detail Form">
            <t t-call="website.layout">
                <div id="optician_detail_form">
                    <div class="oe_structure ">
                        <section class="s_header_title pb32 o_colored_level pt32 bg-black"
                            data-vcss="001" data-snippet="s_title" data-name="Title">
                            <div class="container s_allow_columns">
                                <h1 style="text-align: center;">
                                    <font style="font-size: 62px;">Prescriptive Eyewear Order</font>
                                </h1>
                            </div>
                        </section>

                        <section class="s_optician_detail_form">
                            <div class="container form-section">
                                <form method="post" enctype="multipart/form-data" action="/optician-detail">
                                    <input type="hidden" name="leave_hours" id="leave_hours" />
                                    <input type="hidden" name="csrf_token"
                                        t-att-value="request.csrf_token()" />
                                    <h2 class="form_title">Prescriptive Eyewear Order Form</h2>
                                    <div class="row">
                                        <div class="col-6">
                                            <div class="input-group">
                                                <label for="name">Company:</label>
                                                <input type="text" placeholder="Your Name" name="name" required="true"
                                                    id="name"></input>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="input-group">
                                                <label for="mobile">Mobile:</label>
                                                <input type="text" placeholder="Your Mobile" name="mobile" required="true"
                                                    id="mobile"></input>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="input-group">
                                                <label for="email">Email:</label>
                                                <input type="text" placeholder="Your Email" name="email" required="true"
                                                    id="email"></input>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="input-group">
                                                <label for="emp_no">
                                                    NRIC / FIN No. / Employee No.:</label>
                                                <input type="text" placeholder="NRIC / FIN No. / Employee No." name="emp_no" required="true"
                                                    id="emp_no"></input>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="input-group">
                                                <label for="dept_code">
                                                    DEPARTMENT CODE:</label>
                                                <input type="text" placeholder="DEPARTMENT CODE" name="dept_code"
                                                    id="dept_code"></input>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="input-group">
                                                <label for="product_id">Frame:</label>
                                                <select id="product_id" name="product_id" required="true">
                                                    <t t-foreach="optic_product_ids" t-as="optic_product">
                                                        <option t-att-value="optic_product.id" t-att-id="optic_product.id">
                                                            <span t-esc="optic_product.name"></span>
                                                        </option>
                                                    </t>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="input-group">
                                                <label for="lens_type">Type of Lens:</label>
                                                <select id="lens_type" name="lens_type" required="true">
                                                    <option value=""></option>
                                                    <option value="poly_carbonate_lens">POLYCARBONATE LENS​</option>
                                                    <option value="mr_lens">MR LENS​</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="input-group">
                                                <label for="presc_type">Type of Prescription:</label>
                                                <select id="presc_type" name="presc_type" required="true">
                                                    <option value=""></option>
                                                    <option value="distance">DISTANCE</option>
                                                    <option value="bifocal">BIFOCAL​</option>
                                                    <option value="reading">READING</option>
                                                    <option value="progressive">PROGRESSIVE</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="input-group">
                                                <label for="add_on_type">Add on:</label>
                                                <select id="add_on_type" name="add_on_type">
                                                    <option value=""></option>
                                                    <option value="blue_ray">BLUE RAY​</option>
                                                    <option value="photo_chromic">PHOTOCHROMIC</option>
                                                    <option value="anti_fog"> ANTI-FOG &amp; BLUE RAY​</option>
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="input-group">
                                                <label for="group">Form No:</label>
                                                <input type="number" name="form_no" id="form_number" required="true"></input>
                                            </div>
                                        </div>
<!--                                        <div class="col-6">-->
<!--                                            <div class="input-group">-->
<!--                                                <label for="group">Group:</label>-->
<!--                                                <input type="text" name="company_id" id="company_id"></input>-->
<!--                                                &lt;!&ndash; <select id="company_id" name="company_id">-->
<!--                                                    <option value=""></option>-->
<!--                                                </select> &ndash;&gt;-->
<!--                                            </div>-->
<!--                                        </div>-->
                                        <div class="col-6">
                                            <div class="input-group">
                                                <label for="sphere_left">SPHERE Left:</label>
                                                <input type="text" placeholder="SPHERE left" name="sphere_left"
                                                    id="sphere_left"></input>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="input-group">
                                                <label for="cyl_left">CYL Left:</label>
                                                <input type="text" placeholder="CYL left" name="cyl_left"
                                                    id="cyl_left"></input>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="input-group">
                                                <label for="axis_left">AXIS Left:</label>
                                                <input type="text" placeholder="AXIS left" name="axis_left"
                                                    id="axis_left"></input>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="input-group">
                                                <label for="sphere_right">SPHERE Right:</label>
                                                <input type="text" placeholder="SPHERE right" name="sphere_right"
                                                    id="sphere_right"></input>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="input-group">
                                                <label for="cyl_right">CYL Right:</label>
                                                <input type="text" placeholder="CYL right" name="cyl_right"
                                                    id="cyl_right"></input>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="input-group">
                                                <label for="axis_right">AXIS Right:</label>
                                                <input type="text" placeholder="AXIS right" name="axis_right"
                                                    id="axis_right"></input>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="input-group">
                                                <label for="add">ADD:</label>
                                                <input type="text" placeholder="ADD" name="add"
                                                    id="add"></input>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="input-group">
                                                <label for="pd">PD:</label>
                                                <input type="text" placeholder="PD" name="pd"
                                                    id="pd"></input>
                                            </div>
                                        </div>
                                        <div class="col-6">
                                            <div class="input-group">
                                                <label for="requirements">REQUIRMENTS:</label>
                                                <textarea placeholder="Your Requirements" name="requirements" rows="4" cols="50" id="Requirements"></textarea>
                                               
                                            </div>
                                        </div>
<!--                                        <div class="col-6">-->
<!--                                            <div class="input-group">-->
<!--                                                <label for="group">Form No:</label>-->
<!--                                                <input type="number" name="form_no" id="form_number" required="true"></input>-->
<!--                                            </div>-->
<!--                                        </div>-->
                                    </div>

                                    <input class="submit_btn" type="submit" id="leave_submit"
                                        value="Submit" />
                                </form>


                            </div>
                        </section>
                    </div>
                </div>
            </t>
        </template>

        <record id="optician_detail_page" model="website.page">
            <field name="url">/optician-detail</field>
            <field name="is_published">True</field>
            <field name="view_id" ref="opptician_detail_page_template" />
            <field name="track">True</field>
        </record>
        <record id="menu_optician_detail_web" model="website.menu">
            <field name="name">Optician</field>
            <field name="url">/optician-detail</field>
            <field name="page_id" ref="optician_detail_page" />
            <field name="parent_id" ref="website.main_menu" />
            <field name="sequence" type="int">60</field>
        </record>


    </data>
</odoo>
        