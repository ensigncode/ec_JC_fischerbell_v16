<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--    TO ADD TITLE IN BREAD CRUMBS-->
    <template id="portal_my_home_menu_optician"
        name="Portal layout : Optician menu entries"
        inherit_id="portal.portal_breadcrumbs" priority="30">
        <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'optician_detail'"
                t-attf-class="breadcrumb-item #{'active ' if not optician_detail else ''}">
                <a t-if="optician_detail"
                    t-attf-href="/my/optician-detail?{{ keep_query() }}">
                    Optician Details
                </a>
                <t t-else="">Optician Details</t>
            </li>
        </xpath>
    </template>
    <template id="portal_optician_detail_list" name="Optician Detail View">
            <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Optician Details</t>
            </t>
            <t t-if="not optician_detail">
                <p>There are currently no optician details for your
                    account.</p>
            </t>
            
            <t t-if="optician_detail" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>
                            <span class='d-none d-md-inline'>Name</span>
                        </th>
                        <th>
                            <span class='d-none d-md-inline'>Mobile</span>
                        </th>

                        <th>
                            <span class='d-none d-md-inline'>Frame</span>
                        </th>
                        <th>
                            <span class='d-none d-md-inline'>Group</span>
                        </th>
                        <th>
                            <span class='d-none d-md-inline'>Requirements</span>
                        </th>
                    </tr>
                </thead>
                <t t-foreach="optician_detail" t-as="pa">
                    <tr>
                        <td>
                            <t t-esc="pa.name"/>
                        </td>
                        <td>
                            <t t-esc="pa.mobile"/>
                        </td>
                        <td>
                            <t t-esc="pa.product_id.name"/>
                        </td>
                        <td>
                            <t t-esc="pa.company_id.name"/>
                        </td>
                        <td>
                            <t t-esc="pa.requirements"/>
                        </td>
                        
                    </tr>
                </t>
            </t>
        </t>
    </template>
    <template id="portal_view_optician_detail" name="Optician detail" customize_show="True"
              inherit_id="portal.portal_my_home" priority="90">
          <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">Optician Details</t>
                <t t-set="url" t-value="'/my/optician-detail'"/>
                <t t-set="placeholder_count" t-value="'optician_detail_count'"/>
            </t>
        </xpath>
      </template>
</odoo>