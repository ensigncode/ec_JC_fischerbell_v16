<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_optician_terms_condition_form" model="ir.ui.view">
            <field name="name">optician.term.condition.form</field>
            <field name="model">optician.term.condition</field>
            <field name="arch" type="xml">
                <form string="Optician Term Condition">
                    <sheet>
                        <group>
                            <group>
                                <field name="name" string="Name" />
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="open_term_report_view_tree" model="ir.ui.view">
            <field name="name">optician.term.condition.view.tree</field>
            <field name="model">optician.term.condition</field>
            <field name="arch" type="xml">
                <tree string="Invoices Analysis">
                    <field name="name" />
                </tree>
            </field>
        </record>
        <record id="action_term_condition_detail" model="ir.actions.act_window">
            <field name="name">Optician Term Conditions</field>
            <field name="res_model">optician.term.condition</field>
            <field name="view_mode">tree,form</field>
            <field name="context">{'create': 0}</field>
        </record>
    </data>
</odoo>