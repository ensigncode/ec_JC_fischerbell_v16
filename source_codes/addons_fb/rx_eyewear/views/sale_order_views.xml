<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="sale_order_form_view_inherit_optic" model="ir.ui.view">
            <field name="name">sale.order.form.optic</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form" />
            <field name="arch" type="xml">
                <field name="partner_id" position="after">
                    <field name="optician_detail_id" invisible="1" />
                </field>
                <xpath expr="//field[@name='order_line']//tree//field[@name='product_id']" position="after">
                    <field name="child_id" optional="hide" />
                </xpath>
            </field>
        </record>

        <record id="view_picking_form_inherit_optic" model="ir.ui.view">
            <field name="name">stock.picking.form.optic</field>
            <field name="model">stock.picking</field>
            <field name="inherit_id" ref="stock.view_picking_form" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='move_ids_without_package']//tree//field[@name='product_id']" position="after">
                    <field name="child_id" optional="hide" />
                </xpath>
            </field>
        </record>


        <record id="view_stock_move_line_detailed_operation_tree_inherit_optic" model="ir.ui.view">
            <field name="name">stock.move.line.form.optic</field>
            <field name="model">stock.move.line</field>
            <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree" />
            <field name="arch" type="xml">
                <xpath expr="//field[@name='product_id']" position="after">
                    <field name="child_id" optional="hide" />
                </xpath>
            </field>
        </record>

    </data>
</odoo>