<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="ir_cron_check_invoice_status" model="ir.cron">
            <field name="name">Check Status :: Invoice / Credit Type</field>
            <field name="model_id" ref="account.model_account_move"/>
            <field name="state">code</field>
            <field name="code">model.check_invoice_status()</field>
            <field name="active" eval="True"/>
            <field name="numbercall">-1</field>
            <field name="interval_type">days</field>
            <field name="doall" eval="False"/>
            <field name="nextcall" eval="(DateTime.now() + timedelta(hours=1))"/>
        </record>
    </data>
</odoo>
