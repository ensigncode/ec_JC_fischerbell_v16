<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_move_form_inherit_invoicenow" model="ir.ui.view">
            <field name="name">account.move.form.inherit.invoicenow</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form" />
            <field name="arch" type="xml">
                <xpath expr="//button[@name='button_cancel']" position="after">
                    <!-- <button name="action_invoice_now_sent"
                                type="object"
                                string="Invoice Now"
                                attrs="{'invisible':['|', '|', ('state', '!=', 'posted'), ('is_move_sent', '=', True), ('move_type', 'not in', ('out_invoice', 'out_refund'))]}"
                                class="oe_highlight"
                                data-hotkey="i"/> -->

                    <button name="action_invoice_now_sent"
                                type="object"
                                string="Invoice Now"
                                invisible="1"
                                class="oe_highlight"
                                data-hotkey="i"/>

                 </xpath>
                <xpath expr="//page[@id='other_tab_entry']" position="after">
                    <page string="Peppol Status" name="peppol_datapost_status">
                        <group id="peppol_datapost_group" string="Send Invoice Document">
                           <field name="client_ref" force_save="1" readonly="1"/>
                           <field name="send_invoice_req_status" force_save="1" readonly="1"/>
                           <field name="send_invoice_content" force_save="1" readonly="1"/>
                           <field name="send_invoice_status" force_save="1" readonly="1"/>
                        </group>
                        <group  string="Check Invoice Status">
                            <field name="invoice_status_content" force_save="1" readonly="1"/>
                           <field name="invoice_status" force_save="1" readonly="1"/>
                           <field name="is_completed" force_save="1" readonly="1"/>
                        </group>        

                    </page>
                </xpath>
            </field>
        </record>
    </data>
</odoo>
