<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="update_product_vendor_wiz_form_view" model="ir.ui.view">
        <field name="name">update.product.vendor.wizard.form</field>
        <field name="model">update.product.vendor</field>
        <field name="arch" type="xml">
            <form string="Update Vendor">
                <group>
                    <group>
                        <field name="partner_id" required="1"/>
                    </group>
                    <group>
                         <field name="product_qty" required="1"/>
                    </group>
                </group>
                <footer>
                    <button name="confirm" type="object" string="Confirm" class="oe_highlight"/>
                    <button special="cancel" data-hotkey="z" string="Cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="wiz_action_update_product_vendor" model="ir.actions.act_window">
        <field name="name">Update Product Vendor</field>
        <field name="res_model">update.product.vendor</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="update_product_vendor_wiz_form_view"/>
    </record>
</odoo>
