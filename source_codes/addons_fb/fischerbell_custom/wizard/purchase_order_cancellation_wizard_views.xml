<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
    <record id="view_purchase_order_cancellation_wizard_form" model="ir.ui.view">
        <field name="name">purchase.order.cancellation.wizard.form</field>
        <field name="model">purchase.order.cancellation.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="reason" />
                </group>
                <footer>
                    <button string="Submit" type="object" name="submit_request" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    </data>
</odoo>
    