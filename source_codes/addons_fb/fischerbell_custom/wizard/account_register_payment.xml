<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_account_payment_register_form_inherit_payment_ip" model="ir.ui.view">
        <field name="name">account.payment.register.form.inherit.payment</field>
        <field name="model">account.payment.register</field>
        <field name="inherit_id" ref="account.view_account_payment_register_form" />
        <field name="arch" type="xml">
            <field name="payment_method_line_id" position="after">
                <field name="bank_account_no" attrs="{'invisible': [('is_bank', '=', False)]}"/>
                <field name="is_bank" invisible="1"/>
            </field>
        </field>
    </record>
</odoo>