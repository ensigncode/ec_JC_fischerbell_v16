<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_move_line_wizard" model="ir.ui.view">
        <field name="name">stock.move.wizard.form</field>
        <field name="model">stock.move.wizard</field>
        <field name="arch" type="xml">
            <form string="Move Line Data">
                <group>
                    <field name="move_line_ids">
                        <tree create="0" editable="bottom">
                            <field name="product_id" readonly="1" force_save="1"/>
                            <field name="move_qty" readonly="1" force_save="1"/>
                            <field name="line_qty" />
                            <field name="total_qty" readonly="1" force_save="1"/>
                        </tree>
                    </field>
                </group>
                <footer>
                    <button name="action_send_mail_manager" type="object" string="Send Mail Manager" class="oe_highlight"/>
                    <button string="Close" class="btn-secondary" special="cancel" />
                </footer>
            </form>
        </field>
    </record>
</odoo>