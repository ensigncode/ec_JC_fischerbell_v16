<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="purchase_order_wizard_view_form" model="ir.ui.view">
            <field name="name">purchase.order.wizard.view.form</field>
            <field name="model">purchase.order.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="purchase_order_type" widget="radio"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_select_purchase_order" type="object" class="btn-primary" string="Submit"/>
                        <button string="Cancel" class="btn-default" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_purchase_order_wizard" model="ir.actions.act_window">
            <field name="name">Purchase Order</field>
            <field name="res_model">purchase.order.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="fischerbell_custom.purchase_order_wizard_view_form"/>
            <field name="target">new</field>
        </record>

<!--        <menuitem action="action_purchase_order_wizard" id="purchase.menu_purchase_root"/>-->

    </data>
</odoo>