<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="delivery_order_with_training" model="ir.ui.view">
		<field name="name">delivery_order_with_training</field>
		<field name="model">delivery.order.with.training</field>
		<field name="arch" type="xml">
            <form String="Print Delivery Order With Training">
                <sheet>
                    <group>
                        <group>
                            <field name="sale_id"/>
                            <!-- <field name="picking_id" domain="[('sale_id', '=', sale_id)]" options="{'no_create': True}"/> -->
                        </group>
                        <group>
                            <field name="partner_id" readonly="1" force_save="1" />
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="action_print_delivery_order" type="object" class="btn-primary" string="Print Delivery Order"/>
                    <button string="Cancel" class="btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
        
        <record id="action_report_delivery_order_training_wizard" model="ir.actions.act_window">
            <field name="name">Delivery Order with Training</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">delivery.order.with.training</field>
            <field name="view_mode">form</field>
            <field name="binding_model_id" ref="sale.model_sale_order"/>
            <field name="target">new</field>
        </record>
    </data>
</odoo>
