<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="sale_order_approval_wizard_view_form" model="ir.ui.view">
            <field name="name">sale.order.approval.wizard.view.form</field>
            <field name="model">sale.order.approval.wizard</field>
            <field name="arch" type="xml">
                <form>
                    <sheet>
                        <group>
                            <field name="order_id" invisible="1"/>
                            <field name="operation_type" widget="radio" options="{'horizontal': true}"/>
                        </group>
                    </sheet>
                    <footer>
                        <button name="action_perform_operation" type="object" class="btn-primary" string="Proceed"/>
                        <button string="Cancel" class="btn-default" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>

        <record id="action_sale_order_approval_wizard" model="ir.actions.act_window">
            <field name="name">Purchase Order</field>
            <field name="res_model">sale.order.approval.wizard</field>
            <field name="view_mode">form</field>
            <field name="view_id" ref="fischerbell_custom.sale_order_approval_wizard_view_form"/>
            <field name="target">new</field>
        </record>

        <!-- <menuitem action="action_sale_order_approval_wizard" id="purchase.menu_purchase_root"/> -->

    </data>
</odoo>