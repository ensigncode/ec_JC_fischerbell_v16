<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fischerbell_manual_reminder_view_form" model="ir.ui.view">
            <field name="name">fischerbell.manual.reminder.view.form</field>
            <field name="model">account_followup.manual_reminder</field>
            <field name="inherit_id" ref="account_followup.manual_reminder_view_form"/>
            <field name="arch" type="xml">
                <xpath expr="//group[@name='email_header']/group[1]" position="after">
                    <group colspan="2" col="6">
                        <group colspan="1">
                            <label for="email_to"/>
                        </group>
                        <group colspan="5">
                            <field name="email_to" string="Email To"
                                   placeholder="Email To..." nolabel="1"
                                   colspan="2"/>
                        </group>
                    </group>
                </xpath>
            </field>
    </record>
</odoo>