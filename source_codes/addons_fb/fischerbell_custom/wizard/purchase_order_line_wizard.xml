<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <record id="view_reject_reason_wizard_form" model="ir.ui.view">
        <field name="name">reject.reason.wizard.form</field>
        <field name="model">reject.reason.wizard</field>
        <field name="arch" type="xml">
            <form string="Reject Reason">
                <sheet>
                    <div class="oe_title">
                        <label for="reason"/>
                        <h1>
                            <field name="reason" placeholder="Enter rejection reason"/>
                        </h1>
                    </div>
                    <footer>
                        <button name="action_reject" string="Submit" type="object" class="btn-primary"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </sheet>
            </form>
        </field>
    </record>
</odoo>