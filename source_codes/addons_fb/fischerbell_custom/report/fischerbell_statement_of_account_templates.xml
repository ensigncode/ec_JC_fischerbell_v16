                                                    </td>
                                                    <td width="55%" style="padding-left: 5px;">
                                                                <span style="font-family: 'Unitext Pro Regular'; line-height: 1em;"  t-esc="','.join(partners.child_ids.filtered(lambda x:x.type == 'contact').mapped('name')) "/>
                                                    </td>
                                                </tr>
                                                <tr>
                                                    <td width="40%" >
                                                        <span style="font-family: 'Unitext Pro Regular'; line-height: 1em;">Partner Payment Terms</span>
                                                    </td>
                                                    <td width="5%" >
                                                        <span style="font-family: 'Unitext Pro Regular'; line-height: 1em;">:</span>
                                                    </td>
                                                    <td width="55%"  style="padding-left: 5px;">
                                                            <span style="font-family: 'Unitext Pro Regular'; line-height: 1em;" t-esc="partners.property_payment_term_id and partners.property_payment_term_id.name or '/'"></span>
                                                    </td>
                                                </tr>
                                            </table>
                                        </td>
                                        <td width="10%"/>
                                    </tr>
                                </table>
                                <t t-if="moves">
                                <t t-set="partner_currency_id" t-value="moves.mapped('currency_id')"/>
                                <table width="100%" style="table-layout:fixed">
                                    <thead style="font-size: 15px; font-weight: bold; padding-top: 10px; padding-bottom: 10px; border-left: 2px solid white; border-bottom: 3px solid black; border-top: 3px solid black; border-right: 2px solid white; margin-bottom: 10px;">
                                        <tr>
                                            <th>Date</th>
                                            <th></th>
                                            <th style="text-align: left;"><span>lineument No.</span></th>
                                            <th style="text-align: left;"><span>Reference No. (Customer P.O)</span></th>
                                            <th><span>Sales Person</span></th>
                                            <th><span>Invoice Payment Term</span></th>
                                            <th><span>Amount Open</span></th>
                                            <th><span>Currency</span></th>
                                        </tr>
                                    </thead>
                                    <tbody style="border: 0px solid white;text-style">
                                        <t t-foreach="moves" t-as="line">
                                            <t t-if="line">
                                                 <tr>
                                                    <td class="text-center">
                                                        <t t-if="line.invoice_date">
                                                            <t t-set="date" t-value="line.invoice_date.strftime('%d.%m.%Y')"/>
                                                        </t>
                                                        <span t-esc="date"/>
                                                    </td>
                                                    
                                                    <td class="text-center">
                                                        <t t-if="line.move_type == 'out_invoice'">
                                                            <span>IN</span>
                                                        </t>
                                                        <t t-elif="line.move_type == 'entry'">
                                                            <span>JE</span>
                                                        </t>
                                                        <t t-else="">
                                                            <span/>
                                                        </t>
                                                    </td>
                                                    
                                                    <td class="text-left">
                                                        <span t-esc="line.name"/>
                                                    </td>
                                                    
                                                    <td class="text-left">
                                                        <t t-if="line.sale_id.client_order_ref">
                                                            <span t-esc="line.sale_id.client_order_ref"/>
                                                        </t>
                                                    </td>
                                                    
                                                    <td class="text-center">
                                                        <span t-esc="line.invoice_user_id and line.invoice_user_id.name or '/'"/>
                                                    </td>
                                                    
                                                    <td class="text-center">
                                                        <span t-esc="line.invoice_payment_term_id and line.invoice_payment_term_id.name or '/'"/>
                                                    </td>
                                                    
                                                    <td class="text-center">
                                                        <t t-if="line.move_type == 'out_invoice'">
                                                            <span t-esc="'{:0,.2f}'.format(float(line.amount_total))"/>
                                                        </t>
                                                        <t t-else="">
                                                            <p>(<span t-esc="'{:0,.2f}'.format(float(line.amount_total))"/>)</p>

                                                        </t>
                                                    </td>
                                                    <td class="text-center">
                                                        <span t-esc="line.currency_id.name"/>
                                                    </td>
                                                </tr>
                                            </t>
                                        </t>
                                    </tbody>
                                </table>
                            <hr class="border border-color-dark"/>
                            <div style="border-top: 2px solid white; padding-top: 7px; line-height: 1em;">
                                <table width="50%" style="float: right; vertical-align: center; border: 1px solid white;">
						        <tbody>
						        	<t t-set="partner_currency_vals" t-value="partner_currency(round(sum(moves.mapped('total_balance_due')),2),partner_currency_id)"/>
						            <tr>
						                <td width="15%" style="font-size: 15px; font-family: 'Arial'; text-align: left;"><strong>Total in Company Currency:</strong></td>
						                <td width="5%" style="font-size: 15px; font-family: 'Arial'; text-align: center;">
						                    <span t-esc="user.company_id.currency_id.name"/>
						                </td>
						                <td width="20%" style="font-size: 15px; font-family: 'Arial'; text-align: right;">
						                    <span t-esc="company_currency(round(sum(moves.mapped('total_balance_due')),2),user.company_id.currency_id)"/>
						                    <span t-esc="total_company"/>
						                </td>
						            </tr>
						            <t t-if="partner_currency_vals[2] != user.company_id.currency_id.id">
						            <tr>
						                    <td width="15%" style="font-size: 15px; font-family: 'Arial'; text-align: left;"><strong>Total in Partner Currency:</strong></td>
						                    <td width="5%" style="font-size: 15px; font-family: 'Arial'; text-align: center;">
						                        <span t-esc="partner_currency_vals[1]"/>
						                    </td>
						                    <td width="20%" style="font-size: 15px; font-family: 'Arial'; text-align: right;">
						                        <span t-esc="partner_currency_vals[0]"/>
						                        <span t-esc="p_total"/>
						                    </td>
						                </tr>
						            </t>
						        </tbody>
						    </table>
                            </div>
                            <span>
                                <br/><br/><br/>
                                DOLLARS ZERO AND CENTS ZERO ONLY
                            </span>
                            <table width="100%" style="border: 1px solid black;">
                                <tr style="height: 40px;">
                                    <th width="13%" style="text-align: right; padding-right: 3px; padding-top: 20px;"></th>
                                    <th width="13%" style="text-align: right; padding-right: 3px; padding-top: 20px;">Balance Due</th>
                                    <th width="14%" style="text-align: right; padding-right: 3px; padding-top: 20px;"><span>Current Month</span></th>
                                    <th width="15%" style="text-align: right; padding-right: 3px; padding-top: 20px;"><span>Over 1 Month</span></th>
                                    <th width="15%" style="text-align: right; padding-right: 3px; padding-top: 20px;"><span>Over 2 Months</span></th>
                                    <th width="15%" style="text-align: right; padding-right: 3px; padding-top: 20px;"><span>Over 3 Months</span></th>
                                    <th width="15%" style="text-align: right; padding-right: 3px; padding-top: 20px;"><span>Over 4 Months</span></th>
                                </tr>
                                <tbody>
                                    <tr style="height: 40px;">
                                        <td width="13%" style="text-align: center; padding-top: 10px; font-weight: bold;">Total in SGD</td>
                                        <td width="13%" style="text-align: right; padding-top: 10px; font-weight: bold; padding-right: 3px;">
                                            <span t-esc="company_currency(round(sum(moves.mapped('total_balance_due')),2), user.company_id.currency_id)"/>
                                        </td>
                                        <td width="14%" style="text-align: right; padding-top: 10px; font-weight: bold; padding-right: 3px;">
                                            <span t-esc="company_currency(sum(moves.mapped('current_month')), user.company_id.currency_id)"/>
                                        </td>
                                        <td width="15%" style="text-align: right; padding-top: 10px; font-weight: bold; padding-right: 3px;">
                                            <span t-esc="company_currency(sum(moves.mapped('over_1month')), user.company_id.currency_id)"/>
                                        </td>
                                        <td width="15%" style="text-align: right; padding-top: 10px; font-weight: bold; padding-right: 3px;">
                                            <span t-esc="company_currency(sum(moves.mapped('over_2month')), user.company_id.currency_id)"/>
                                        </td>
                                        <td width="15%" style="text-align: right; padding-top: 10px; font-weight: bold; padding-right: 3px;">
                                            <span t-esc="company_currency(sum(moves.mapped('over_3month')), user.company_id.currency_id)"/>
                                        </td>
                                        <td width="15%" style="text-align: right; padding-top: 10px; font-weight: bold; padding-right: 3px;">
                                            <span t-esc="company_currency(sum(moves.mapped('over_4month')), user.company_id.currency_id)"/>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </t>
                        <t t-else="">
                            <hr class="border border-color-dark"/>
                            <h5 class="text-center mt-5 pt-5">Records not found for the partner.</h5>
                        </t>
                        </div>
                <p style="page-break-before:always"/>
                <div class="footer">
                        <table width="100%" style="border: 1px solid white;">
                            <tr>
                                <td width="90%"></td>
                                <td width="10%">
                                    <br/>
                                    <p>Page <span class="page" /> of <span class="topage" /></p>
                                </td>
                            </tr>
                        </table>
                    </div>
                </t>
            </t>
            </t>
        </t>
    </template>

        <record id="action_report_statement_of_account" model="ir.actions.report">
            <field name="name">Statement Of Account</field>
            <field name="model">account.move</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">fischerbell_custom.fischerbell_report_soa_document</field>
            <field name="report_file">fischerbell_custom.fischerbell_report_soa_document</field>
            <field name="print_report_name">'Statement Of Account - %s' % (object.name)</field>
            <!-- <field name="print_report_name">'Statement Of Account</field> -->
            <field name="binding_model_id" ref="model_account_move"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="fischerbell_custom.fischerbell_custom_statement_of_account_paperformat"/>
        </record>
    </data>
