                                    <tr>
                                        <td width="70%">
                                            <img src="/fischerbell_custom/static/src/img/fischerbell_header.jpeg" width="400" height="100" style="margin-bottom: 10px;"/>
                                        </td>
                                        <td>
                                            <img src="/fischerbell_custom/static/src/img/fischerbell_header2.jpeg" width="180" height="100" style="margin-bottom: 10px;"/>
                                        </td>
                                        <td>
                                            <img src="/fischerbell_custom/static/src/img/fischerbell_header3.jpeg" width="130" height="100" style="margin-bottom: 10px;"/>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="3">
                                            <div class="row">
                                                <div class="document-title">
                                                    <table style="width:100%; border: 0px solid white;">
                                                        <tr>
                                                            <td width="45%" class="text-wrap">
                                                                <span style="font-weight: bold; margin-left: 5px; font-family: 'Unitext Pro Regular'; padding: 5px; font-size: 20px;">Consignment Note</span>
                                                            </td>
                                                            <td width="50%" class="text-wrap">
                                                                <span style="font-weight: bold; margin-left: 10px; font-family: 'Unitext Pro Regular'; padding: 5px; font-size: 20px;">Consignment Note No.</span>
                                                                <span style="font-weight: bold; font-family: 'Unitext Pro Regular'; padding: 5px; font-size: 20px;" t-esc="doc.name"/>
                                                            </td>
                                                        </tr>
                                                    </table>
                                                </div>
                                            </div>
                                        </td>
                                    </tr>
                                    <tr>
                                        <td colspan="3">
                                            <table width="100%" style="border-top: 2px solid black; border-left: 0px solid white; border-right: 0px solid white; border-bottom: 0px solid white; margin-left: 10px; margin-top: 5px;">
                                                <tr>
                                                    <td width="47.8%">
                                                        <table style="width:100%; border: 0px solid white;">
                                                            <tr>
                                                                <td width="30%" >
                                                                    <strong><span style="font-family: 'Unitext Pro Regular'; line-height: 1em; font-size: 12px;">Customer Code</span></strong>
                                                                </td>
                                                                <td width="5%" >
                                                                    <span style="font-family: 'Unitext Pro Regular'; line-height: 1em; font-size: 12px;">:</span>
                                                                </td>
                                                                <td width="65%" >
                                                                    <span style="font-family: 'Unitext Pro Regular'; line-height: 1em; font-size: 12px;" t-esc="doc.partner_id.customer_code"/>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td width="30%" class="text-wrap">
                                                                    <span style="font-family: 'Unitext Pro Regular'; line-height: 1em; font-size: 12px; font-weight: bold;">Company Name</span>
                                                                </td>
                                                                <td width="5%" class="text-wrap">
                                                                    <span style="font-family: 'Unitext Pro Regular'; line-height: 1em; font-size: 12px;">:</span>
                                                                </td>
                                                                <td width="65%" class="text-style">
                                                                    <t t-if="doc.partner_id">
                                                                        <span style="font-family: 'Unitext Pro Regular'; line-height: 1em; font-size: 12px;" t-esc="doc.partner_id.name"/><br/>
                                                                    </t>
                                                                    <t t-else="">
                                                                        <span><br/></span>
                                                                    </t>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td width="30%" class="text-wrap">
                                                                    <span style="font-family: 'Unitext Pro Regular'; line-height: 1em; font-size: 12px; font-weight: bold;">Address</span>
                                                                </td>
                                                                <td width="5%" class="text-wrap">
                                                                    <span style="font-family: 'Unitext Pro Regular'; line-height: 1em; font-size: 12px;">:</span>
                                                                </td>
                                                                <td width="65%" class="text-style">
                                                                    <t t-if="doc.partner_id.street">
                                                                        <span style="font-family: 'Unitext Pro Regular'; line-height: 1em; font-size: 12px;" t-esc="doc.partner_id.street"/><br/>
                                                                    </t>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td width="30%" class="text-wrap">
                                                                    <span style="font-family: 'Unitext Pro Regular'; line-height: 1em; font-size: 12px; font-weight: bold;">Postal Code</span>
                                                                </td>
                                                                <td width="5%" class="text-wrap">
                                                                    <span style="font-family: 'Unitext Pro Regular'; line-height: 1em; font-size: 12px;">:</span>
                                                                </td>
                                                                <td width="65%" class="text-style">
