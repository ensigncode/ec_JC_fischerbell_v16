                                                                    </t>
                                                                    <t t-if="doc.partner_id.zip">
                                                                        <span style="font-family: 'Unitext Pro Regular'; line-height: 1em; font-size: 12px;" t-esc="doc.partner_id.zip" /><br/>
                                                                    </t>
                                                                    <t t-else="">
                                                                        <span><br/></span>
                                                                    </t>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td width="30%" class="text-wrap">
                                                                    <span style="font-family: 'Unitext Pro Regular'; line-height: 1em; font-size: 12px; font-weight: bold;"></span>
                                                                </td>
                                                                <td width="5%" class="text-wrap">
                                                                    <span style="font-family: 'Unitext Pro Regular'; line-height: 1em; font-size: 12px;"></span>
                                                                </td>
                                                                <td width="65%" class="text-style">
                                                                    <div>
                                                                        <t t-if="doc.partner_note and int(doc.len_note) > 0">
                                                                            <t t-if="int(doc.len_note) > 118">
                                                                                <span style="line-height: 1em; font-family: 'Unitext Pro Regular'; font-size: 12px;" t-esc="doc.partner_note"/>
                                                                            </t>
                                                                            <t t-elif="int(doc.len_note) > 79">
                                                                                <span style="line-height: 1em; font-family: 'Unitext Pro Regular'; font-size: 12px;" t-esc="doc.partner_note"/><br/><br/>
                                                                            </t>
                                                                            <t t-elif="int(doc.len_note) > 40">
                                                                                <span style="line-height: 1em; font-family: 'Unitext Pro Regular'; font-size: 12px;" t-esc="doc.partner_note"/><br/><br/><br/>
                                                                            </t>
                                                                            <t t-else="">
                                                                                <span style="font-family: 'Unitext Pro Regular'; line-height: 1em; font-size: 12px;" t-esc="doc.partner_note"/><br/><br/><br/><br/>
                                                                            </t>
                                                                        </t>
                                                                        <t t-else="">
                                                                            <br/><br/><br/><br/>
                                                                        </t>
                                                                    </div>
                                                                </td>
                                                            </tr>
                                                        </table>
                                                    </td>
                                                    <td width="52.2%%" >
                                                        <table style="width:100%; border: 0px solid white;">
                                                            <tr>
                                                                <td width="30%" >
                                                                    <strong><span style="font-family: 'Unitext Pro Regular'; line-height: 1em; font-size: 12px;">Date</span></strong>
                                                                </td>
                                                                <td width="5%" >
                                                                    <span style="font-family: 'Unitext Pro Regular'; line-height: 1em; font-size: 12px;">:</span>
                                                                </td>
                                                                <td width="65%"  style="padding-left: 5px;">
                                                                    <span style="font-family: 'Unitext Pro Regular'; line-height: 1em; font-size: 12px;" t-esc="doc.date_planned_start.strftime('%d/%m/%Y')"/>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td width="30%">
                                                                    <strong><span style="font-family: 'Unitext Pro Regular'; line-height: 1em; font-size: 12px;">Consignment Period</span></strong>
                                                                </td>
                                                                <td width="5%">
                                                                    <span style="font-family: 'Unitext Pro Regular'; line-height: 1em; font-size: 12px;">:</span>
                                                                </td>
                                                                <td width="65%"  style="padding-left: 5px;">
                                                                    <span style="font-family: 'Unitext Pro Regular'; line-height: 1em; font-size: 12px;" t-esc="doc.consignment_period_id.name"></span>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td width="30%" >
                                                                    <strong><span style="font-family: 'Unitext Pro Regular'; line-height: 1em; font-size: 12px;">Salesperson</span></strong>
                                                                </td>
                                                                <td width="5%" >
                                                                    <span style="font-family: 'Unitext Pro Regular'; line-height: 1em; font-size: 12px;">:</span>
                                                                </td>
                                                                <td width="65%"  style="padding-left: 5px;">
                                                                    <span style="font-family: 'Unitext Pro Regular'; line-height: 1em; font-size: 12px;" t-esc="doc.user_id.name"/>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td width="30%" >
                                                                    <strong><span style="font-family: 'Unitext Pro Regular'; line-height: 1em; font-size: 12px;">Processor</span></strong>
                                                                </td>
                                                                <td width="5%" >
                                                                    <span style="font-family: 'Unitext Pro Regular'; line-height: 1em; font-size: 12px;">:</span>
                                                                </td>
                                                                <td width="65%"  style="padding-left: 5px;">
                                                                    <span style="font-family: 'Unitext Pro Regular'; line-height: 1em; font-size: 12px;" t-esc="doc.mrp_team_id.name"/>
                                                                </td>
                                                            </tr>
                                                        </table>
                                                    </td>
                                                </tr>
                                            </table>
                                            <table width="100%" style="border-top: 2px solid black; border-left: 0px solid white; border-right: 0px solid white; border-bottom: 0px solid white; margin-left: 10px; margin-top: 5px;">
                                                <tr>
                                                    <br/>
                                                    <td width="47.8%">
                                                        <table style="width:100%; border: 0px solid white;">
                                                            <tr>
                                                                <td width="30%" class="text-wrap">
                                                                    <span style="font-family: 'Unitext Pro Regular'; line-height: 1em; font-size: 12px; font-weight: bold;">Delivery Date</span>
                                                                </td>
                                                                <td width="5%" class="text-wrap">
                                                                    <span style="font-family: 'Unitext Pro Regular'; line-height: 1em; font-size: 12px;">:</span>
                                                                </td>
                                                                <td width="65%" class="text-style">
                                                                   <span style="font-family: 'Unitext Pro Regular'; line-height: 1em; font-size: 12px;" t-esc="doc.delivery_date.strftime('%d/%m/%Y')"></span>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td width="30%" class="text-wrap">
                                                                    <span style="font-family: 'Unitext Pro Regular'; line-height: 1em; font-size: 12px; font-weight: bold;">Requestor</span>
                                                                </td>
                                                                <td width="5%" class="text-wrap">
                                                                    <span style="font-family: 'Unitext Pro Regular'; line-height: 1em; font-size: 12px;">:</span>
                                                                </td>
                                                                <td width="65%" class="text-style">
                                                                    <t t-if="doc.partner_id.phone">
                                                                        <span style="font-family: 'Unitext Pro Regular'; line-height: 1em; font-size: 12px;" t-esc="doc.requestor_id.name" /><br/>
                                                                    </t>
                                                                    <t t-else="">
                                                                        <span><br/></span>
                                                                    </t>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td width="30%" class="text-wrap">
                                                                    <span style="font-family: 'Unitext Pro Regular'; line-height: 1em; font-size: 12px; font-weight: bold;">Contact No</span>
                                                                </td>
                                                                <td width="5%" class="text-wrap">
                                                                    <span style="font-family: 'Unitext Pro Regular'; line-height: 1em; font-size: 12px;">:</span>
                                                                </td>
                                                                <td width="65%" class="text-style">
                                                                    <t t-if="doc.partner_id.phone">
                                                                        <span style="font-family: 'Unitext Pro Regular'; line-height: 1em; font-size: 12px;" t-esc="doc.requestor_id.phone" /><br/>
                                                                    </t>
                                                                    <t t-else="">
                                                                        <span><br/></span>
                                                                    </t>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td width="30%" class="text-wrap">
                                                                    <span style="font-family: 'Unitext Pro Regular'; line-height: 1em; font-size: 12px; font-weight: bold;">Email</span>
                                                                </td>
                                                                <td width="5%" class="text-wrap">
                                                                    <span style="font-family: 'Unitext Pro Regular'; line-height: 1em; font-size: 12px;">:</span>
                                                                </td>
                                                                <td width="65%" class="text-style">
                                                                    <t t-if="doc.partner_id.email">
                                                                        <span style="font-family: 'Unitext Pro Regular'; line-height: 1em; font-size: 12px;" t-esc="doc.requestor_id.email" /><br/>
                                                                    </t>
                                                                    <t t-else="">
                                                                        <span><br/></span>
                                                                    </t>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td width="30%" class="text-wrap">
                                                                    <span style="font-family: 'Unitext Pro Regular'; line-height: 1em; font-size: 12px; font-weight: bold;">Fax</span>
                                                                </td>
                                                                <td width="5%" class="text-wrap">
                                                                    <span style="font-family: 'Unitext Pro Regular'; line-height: 1em; font-size: 12px;">:</span>
                                                                </td>
                                                                <td width="65%" class="text-style">
                                                                    <t t-if="doc.partner_id.fax">
                                                                        <span style="font-family: 'Unitext Pro Regular'; line-height: 1em; font-size: 12px;" t-esc="doc.requestor_id.fax" /><br/>
                                                                    </t>
                                                                    <t t-else="">
                                                                        <span><br/></span>
                                                                    </t>
                                                                </td>
                                                            </tr>
                                                        </table>
                                                    </td>
                                                    <td width="52.2%%" >
                                                        <table style="width:100%; border: 0px solid white;">
                                                            <tr>
                                                                <td width="30%" ><strong><span style="font-family: 'Unitext Pro Regular'; line-height: 1em; font-size: 12px;">Deliver To.</span></strong></td>
                                                                <td width="5%" ></td>
                                                                <td width="65%" class="text-style"/>
                                                            </tr>
                                                            <tr>
                                                                <td width="30%" ><strong><span style="font-family: 'Unitext Pro Regular'; line-height: 1em; font-size: 12px;">Address</span></strong></td>
                                                                <td width="5%" ><span style="font-family: 'Unitext Pro Regular'; line-height: 1em; font-size: 12px;">:</span></td>
                                                                <td width="65%" class="text-style">
                                                                    <t t-foreach="doc.partner_id.child_ids" t-as="child">
                                                                        <t t-if="child.type == 'delivery'">
                                                                            <t t-if="child.street">
                                                                                <span style="line-height: 1em; font-family: 'Unitext Pro Regular'; font-size: 12px;" t-esc="child.street"/><br/>
                                                                            </t>
                                                                        </t>
                                                                    </t>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td width="30%" ><strong><span style="font-family: 'Unitext Pro Regular'; line-height: 1em; font-size: 12px;">Postal Code</span></strong></td>
                                                                <td width="5%" ><span style="font-family: 'Unitext Pro Regular'; line-height: 1em; font-size: 12px;">:</span></td>
                                                                <td width="65%" class="text-style">
                                                                    <t t-foreach="doc.partner_id.child_ids" t-as="child">
                                                                        <t t-if="child.type == 'delivery'">
                                                                            <t t-if="child.country_id">
                                                                                <span style="line-height: 1em; font-family: 'Unitext Pro Regular'; font-size: 12px;" t-esc="child.country_id.name"/> - 
                                                                            </t>
                                                                            <t t-if="child.zip">
                                                                                <span style="line-height: 1em; font-family: 'Unitext Pro Regular'; font-size: 12px;" t-esc="child.zip"/><br/>
                                                                            </t>
                                                                        </t>
                                                                    </t>
                                                                </td>
                                                            </tr>
                                                            <tr>
                                                                <td width="30%" class="text-wrap">
                                                                    <span style="font-family: 'Unitext Pro Regular'; line-height: 1em; font-size: 12px; font-weight: bold;">Special Remarks</span>
                                                                </td>
                                                                <td width="5%" class="text-wrap">
                                                                    <span style="font-family: 'Unitext Pro Regular'; line-height: 1em; font-size: 12px;">:</span>
                                                                </td>
                                                                <td width="65%" class="text-style">
                                                                    <t t-if="doc.note">
                                                                        <span style="font-family: 'Unitext Pro Regular'; line-height: 1em; font-size: 12px;" t-esc="doc.note" /><br/>
                                                                    </t>
                                                                </td>
                                                            </tr>
                                                        </table>
                                                    </td>
                                                    <td width="10%"/>
                                                </tr>
                                            </table>
                                            <table width="100%" class="table-head" style="font-size: 15px; font-weight: bold; padding-top: 10px; padding-bottom: 10px; border-left: 2px solid white; border-bottom: 3px solid black; border-top: 3px solid black; border-right: 2px solid white; margin-bottom: 10px;">
                                                <br/>
                                                <br/>
                                                <thead>
                                                    <tr>
                                                        <th width="5%">SN</th>
                                                        <th width="10%" style="text-align: left;"><span>PRODUCT CODE</span></th>
                                                        <th width="15%" style="text-align: left;"><span>DESCRIPTION</span></th>
                                                        <th width="20%" style="text-align: left;"></th>
                                                        <th width="5%"><span>QTY</span></th>
                                                        <th width="10%"><span>UOM</span></th>
                                                    </tr>
                                                </thead>
                                            </table>
                                        </td>
                                    </tr>
                                </table>
                            </div>
                        </div>
                    </t>
                    <t>
                        <div class="page">
                            <t t-call="fischerbell_custom.page_consignment_note_template"/>
                        </div>
                        <div>
                            <br/>
                            <div style="border-top: 2px solid black; padding-top: 7px; line-height: 1em;">
                              <table width="100%" style="float: left; vertical-align: center; border: 1px solid white;">
                                <tr>
                                    <td width="50%" style="font-family: 'Unitext Pro Regular'; text-align: left; vertical-align: top; font-size: 12px;">
                                        <span t-field="doc.notes"/>
                                    </td>
                                    <td width="10%"/>
                                    <td width="40%"/>
                                </tr>
                              </table>
                            </div>
                        </div>
                        <div class="footer">
                            <div class="hide_lastpage">
                                <table width="100%" style="border: 0px solid white; padding-top: 10px; min-height: 700px;">
                                    <tr>
                                        <td style="text-align: center;">
                                            <span>Authorized Signature</span>
                                        </td>
                                        <td style="text-align: center;">
                                            <span>Acknowledged By</span>
                                        </td>
                                    </tr>
                                </table>
                                <br/>
                                <br/>
                                <br/>
                                <br/>
                                <table width="100%" style="border: 0px solid white; margin_top: 30px; min-height: 200px;">
                                    <tr>
                                        <td width="10%"/>
                                        <td width="34%" style="text-align: center; border-bottom: 2px solid black;"><strong><span>No Signature Required</span></strong></td>
                                        <td width="19%"/>
                                        <td width="27%" style="text-align: center; border-bottom: 2px solid black;"/>
                                        <td width="10%"/>
                                    </tr>
                                    <tr>
                                        <td width="10%"/>
                                        <td width="34%" style="text-align: center;"></td>
                                        <td width="19%"/>
                                        <td width="27%" style="text-align: center;"><span>Signature, Name &amp; Date</span></td>
                                        <td width="10%"/>
                                    </tr>
                                </table>
                                <br/>
                                <table width="100%" style="border: 0px solid white;">
