<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="fischerbell_custom_consignment_note_paperformat" model="report.paperformat">
            <field name="name">Fischerbell Consignment Note Paperformat</field>
            <field name="default" eval="False"/>
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">100</field>
            <field name="margin_bottom">40</field>
            <field name="margin_left">2</field>
            <field name="margin_right">3</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">100</field>
            <field name="dpi">95</field>
        </record>

        <template id="page_consignment_note_template">
            <table width="100%" style="border: 0px solid white;">
                <tbody>
                    <t t-set="count" t-value="0" />
                    <t t-if="doc.move_raw_ids">
                        <t t-foreach="doc.move_raw_ids" t-as="line" >
                            <t t-set="count" t-value="count+1" />
                            <tr>
                                <td width="5%" class="text-center"><span t-esc="count"/></td>
                                <td width="10%" class="text-left"><span t-esc="line.product_id.default_code"/></td>
                                <td width="10%">
                                    <div>
                                        <t t-if="line.product_id.image_1920" >
                                            <img class="variant-image" t-attf-src="data:image/*;base64,{{line.product_id.image_1920}}" align="center" width="5" height="70" style='margin:0px;padding-top:0px;'/>
                                        </t>
                                    </div>
                                </td>
                                <td width="25%">
                                    <span t-field="line.product_id.name"/><br/>
                                    <span t-field="line.product_id.description_sale"/>
                                </td>
                                <td width="5%" class="text-center"><t t-esc="int(line.product_uom_qty)"/></td>
                                <td width="10%" class="text-center"><t t-esc="line.product_uom.name"/></td>
                            </tr>
                        </t>
                    </t>
                    <t t-else="">
                        <span>
                            <br/>
                            <br/>
                            <br/>
                        </span>
                    </t>
                </tbody>
            </table>
        </template>

        <template id="fischerbell_report_consignment_note_document">
            <t t-call="web.html_container">
                <t t-call="web.basic_layout">
                    <t t-foreach="docs" t-as="doc">
                        <style>
                            .page { 
                                font-family: 'Arial';
                                font-size: 13px;
                            }
                            .page td {
                                vertical-align: top;
                                padding-top: 10px;
                            }
                            .footer {
                                font-size: 35px;
                                font-weight: bold;
                            }
                            .text-wrap {
                                font-weight: bold;
                                font-size: 13px;
                                font-family: 'Tara SC Black';
                            }
                            .text-style {
                                font-size: 13px;
                                font-family: 'Arial';
                            }
                            .text-note {
                                font-size: 13px;
                                font-family: 'Arial';
                            }
                            table.order-line {
                                width: 100%;
                                border: 0px solid white;
                                margin: 8px 5px 0 5px;
                            }

                            table.order-line thead tr th {
                                font-size: 13px;
                                font-family: 'Tara SC Black';
                                font-weight: bold;
                                padding-top: 10px;
                                padding-bottom: 10px;
                                border-top: 2px solid black;
                                border-bottom: 2px solid black;
                            }
                            .variant-image {
                                margin-top: 20px;
                                width: 60%;
                            }
                            .table table-total {
                                border: 1px solid black;
                                min-height: 200px; 
                                position: absolute; 
                                bottom: 0px;"
                            }
                        </style>
                        <!-- Header -->
