<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Sequences for sale.order -->
        <function name = "write" model = "ir.model.data">
            <function name = "search" model = "ir.model.data">
                <value eval = "[('module', '=', 'sale'),('name','=','seq_sale_order')]"/>
            </function>
            <value eval =" {'noupdate': False} "/>
        </function>
        <record id="sale.seq_sale_order" model="ir.sequence">
            <field name="name">Sales Order</field>
            <field name="code">sale.order</field>
            <field name="prefix">SQ/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <function name = "write" model = "ir.model.data">
            <function name = "search" model = "ir.model.data">
                <value eval = "[('module', '=', 'sale'),('name','=','seq_sale_order')]"/>
            </function>
            <value eval =" {'noupdate': True} "/>
        </function>

        <!-- Sequences for purchase.order -->
        <function name = "write" model = "ir.model.data">
            <function name = "search" model = "ir.model.data">
                <value eval = "[('module', '=', 'purchase'),('name','=','seq_purchase_order')]"/>
            </function>
            <value eval =" {'noupdate': False} "/>
        </function>

         <record id="seq_purchase_rfq" model="ir.sequence">
            <field name="name">RFQ Sequence</field>
            <field name="code">purchase.order.rfq</field>
            <field name="prefix">RFQ/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <!-- Sequence for Purchase Order -->
        <record id="seq_purchase_order" model="ir.sequence">
            <field name="name">Purchase Order Sequence</field>
            <field name="code">purchase.order.po</field>
            <field name="prefix">PO/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="credit_not_seq" model="ir.sequence">
              <field name="name">Customer Credit Seq</field>
              <field name="code">credit_note_seq</field>
              <field name="prefix">CN/%(year)s/</field>
              <field name="padding">5</field>
              <field name="company_id" eval="False"/>
        </record>
         <record id="debit_not_seq" model="ir.sequence">
              <field name="name">Debit Note Seq</field>
              <field name="code">debit_note_seq</field>
              <field name="prefix">DN/%(year)s/</field>
              <field name="padding">5</field>
              <field name="company_id" eval="False"/>
        </record>
        <record id="customer_payment_seq" model="ir.sequence">
            <field name="name">Customer Payment Seq</field>
            <field name="code">customer_payment_seq</field>
            <field name="prefix">RV/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
         <record id="supplier_payment_seq" model="ir.sequence">
            <field name="name">Supplier Payment Seq</field>
            <field name="code">supplier_payment_seq</field>
            <field name="prefix">PV/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="giro_payment_method_seq" model="ir.sequence">
            <field name="name">Giro Payment mehtod Sequence</field>
            <field name="code">giro_payment_method_seq</field>
            <field name="prefix">GIR/%(month)s/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
        <record id="paynow_payment_method_seq" model="ir.sequence">
            <field name="name">Paynow Payment mehtod Sequence</field>
            <field name="code">paynow_payment_method_seq</field>
            <field name="prefix">GIR/%(month)s/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_res_partner" model="ir.sequence">
            <field name="name">Res Partner</field>
            <field name="code">res.partner</field>
            <field name="prefix">CUS/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>