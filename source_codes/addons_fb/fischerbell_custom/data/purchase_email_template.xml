<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">
        <function name = "write" model = "ir.model.data">
            <function name = "search" model = "ir.model.data">
                <value eval = "[('module', '=', 'purchase'),('name','=','email_template_edi_purchase')]"/>
            </function>
            <value eval =" {'noupdate': False} "/>
        </function>
        <record id="purchase.email_template_edi_purchase" model="mail.template">
            <field name="name">Purchase: Request For Quotation</field>
            <field name="model_id" ref="purchase.model_purchase_order"/>
            <field name="subject">{{ object.company_id.name }} Order (Ref {{ object.name or 'n/a' }})</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="description">Sent manually to vendor to request a quotation</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
        Hello
                        <t t-out="object.partner_id.name or ''">Brandon Freeman</t>
                        <t t-if="object.partner_id.parent_id">
            (
                            <t t-out="object.partner_id.parent_id.name or ''">Azure Interior</t>)
                        </t>
                        <br/>
                        <br/>
        Here is in attachment a request for quotation
                        <span style="font-weight:bold;" t-out="object.name or ''">P00015</span>
                        <t t-if="object.partner_ref">
            with reference:
                            <t t-out="object.partner_ref or ''">REF_XXX</t>
                        </t>
        from
                        <t t-out="object.company_id.name or ''">YourCompany</t>.
                        <br/>
                        <br/>
        If you have any questions, please do not hesitate to contact us.
                        <br/>
                        <br/>
        Best regards,
                        <t t-if="not is_html_empty(object.user_id.signature)">
                            <br/>
                            <br/>
                            <t t-out="object.user_id.signature or ''">--
                                <br/>Mitchell Admin
                            </t>
                        </t>
                    </p>
                </div>
            </field>
            <field name="report_template" ref="purchase.action_report_purchase_order"/>
            <field name="report_name">RFQ_{{ (object.name or '').replace('/','_') }}</field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="True"/>
        </record>

            <record id="email_template_pickup_arranged_driver_notification_template" model="mail.template">
                <field name="name">Purchase: Notification for Driver pickup arrangement</field>
                <field name="model_id" ref="purchase.model_purchase_order"/>
                <field name="email_from">{{ (object.user_id.email_formatted or object.company_id.email_formatted or user.email_formatted) }}</field>
                <field name="email_to">{{ (object.partner_id.email_formatted or object.email) }}</field>
                <field name="subject">Pickup Arrangement Notification</field>
                <field name="body_html" type="html">
                    <div style="margin: 0px; padding: 0px;">
                        <p style="margin: 0px; padding: 0px; font-size: 13px;">
                            Dear <strong><t t-out="object.partner_id.name or ''"></t></strong>, <br/> <br/>
                            We have arranged a driver for the pickup of your delivery.<br/>
                            The driver will come on <strong><t t-out="object.request_delivery_date.date().strftime('%d-%m-%Y') or ''"></t></strong>  to collect the goods.<br/> <br/>
                            Thank you for your cooperation.<br/><br/>
                            Best regards, <br/>
                            <strong><t t-out="object.company_id.name or ''"></t></strong>
                        </p>
                    </div>
                </field>
                <field name="lang">{{ object.partner_id.lang }}</field>
            </record>

        <record id="email_template_cancellation_approval_template" model="mail.template">
            <field name="name">Purchase: Request For Cancellation</field>
            <field name="model_id" ref="fischerbell_custom.model_purchase_order_cancellation_wizard"/>
            <field name="email_from">{{ (object.purchase_order_id.user_id.email_formatted or object.purchase_order_id.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="subject">Transfer (Ref {{ object.purchase_order_id.name or 'n/a' }})</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear Manager, <br/>
                        A cancellation request for Purchase Order <strong><t t-out="object.purchase_order_id.name or ''"></t></strong><br/>
                        <strong>Reason:</strong> <t t-out="object.reason or ''"></t><br/>
                        Please log in to the system to approve or reject the request.<br/><br/>
                        Thanks.
                    </p>
                </div>
            </field>
            <field name="lang">{{ object.purchase_order_id.partner_id.lang }}</field>
        </record>

        <record id="email_template_picking_cancellation_approval_template" model="mail.template">
            <field name="name">Transfer: Request For Cancellation</field>
            <field name="model_id" ref="fischerbell_custom.model_stock_picking_cancellation_wizard"/>
            <field name="email_from">{{ (object.stock_picking_id.user_id.email_formatted or object.stock_picking_id.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="subject">Order (Ref {{ object.stock_picking_id.name or 'n/a' }})</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear Manager, <br/>
                        A cancellation request for GRN <strong><t t-out="object.stock_picking_id.name or ''"></t></strong><br/>
                        <strong>Reason:</strong> <t t-out="object.reason or ''"></t><br/>
                        Please log in to the system to approve or reject the request.<br/><br/>
                        Thanks.
                    </p>
                </div>
            </field>
            <field name="lang">{{ object.stock_picking_id.partner_id.lang }}</field>
        </record>

        <record id="email_template_grn_notification" model="mail.template">
            <field name="name">GRN: Notification</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="email_from">{{ object.company_id.email or user.email_formatted }}</field>
            <field name="subject">GRN Validated: {{ object.name or 'n/a' }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0; padding: 20px; font-family: Arial, sans-serif; font-size: 14px; color: #333;">
                    <p style="margin: 0; padding: 0; font-size: 16px; font-weight: bold; color: #007bff;">Dear Team,</p>
                    <p style="margin: 10px 0; padding: 0;">A Goods Receipt Note (GRN) has been validated with the following details:</p>
                    
                    <table style="width: 100%; border-collapse: collapse; margin: 15px 0; font-size: 14px; color: #333;">
                        <tr>
                            <td style="padding: 8px; border: 1px solid #ddd; font-weight: bold; width: 30%;">GRN Reference:</td>
                            <td style="padding: 8px; border: 1px solid #ddd;"><t t-out="object.name or 'n/a'"/></td>
                        </tr>
                        <tr>
                            <td style="padding: 8px; border: 1px solid #ddd; font-weight: bold;">Vendor:</td>
                            <td style="padding: 8px; border: 1px solid #ddd;"><t t-out="object.partner_id.name or 'n/a'"/></td>
                        </tr>
                        <tr>
                            <td style="padding: 8px; border: 1px solid #ddd; font-weight: bold;">Receipt Date:</td>
                            <td style="padding: 8px; border: 1px solid #ddd;"><t t-out="object.scheduled_date or 'n/a'"/></td>
                        </tr>
                        <tr>
                            <td style="padding: 8px; border: 1px solid #ddd; font-weight: bold;">Total Products:</td>
                            <td style="padding: 8px; border: 1px solid #ddd;">
                                <t t-out="sum([line.product_qty for line in object.move_ids_without_package]) or 0"/>
                            </td>
                        </tr>
                    </table>
                    
                    <p style="margin: 10px 0; padding: 0; font-weight: bold;">Product Details:</p>
                    <ul style="padding-left: 20px; margin: 10px 0;">
                        <t t-foreach="object.move_ids_without_package" t-as="line">
                            <li>
                                <strong><t t-out="line.product_id.display_name or 'n/a'"/></strong>: 
                                <t t-out="line.product_qty or 0"/> 
                                <t t-out="line.product_uom.name or ''"/>
                            </li>
                        </t>
                    </ul>

                    <hr style="margin: 20px 0; border: none; border-top: 1px solid #ddd;" />

                    <p style="margin: 10px 0; padding: 0;">Additionally, the associated purchase details are:</p>
                    <table style="width: 100%; border-collapse: collapse; margin: 15px 0; font-size: 14px; color: #333;">
                        <tr>
                            <td style="padding: 8px; border: 1px solid #ddd; font-weight: bold; width: 30%;">Purchase Order:</td>
                            <td style="padding: 8px; border: 1px solid #ddd;"><t t-out="object.origin or 'n/a'"/></td>
                        </tr>
                        <tr>
                            <td style="padding: 8px; border: 1px solid #ddd; font-weight: bold;">Purchase Date:</td>
                            <td style="padding: 8px; border: 1px solid #ddd;">
                                <t t-out="object.purchase_id.date_order or 'n/a'"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 8px; border: 1px solid #ddd; font-weight: bold;">Total Ordered Quantity:</td>
                            <td style="padding: 8px; border: 1px solid #ddd;">
                                <t t-out="sum([line.product_qty for line in object.purchase_id.order_line]) or 0"/>
                            </td>
                        </tr>
                        <tr>
                            <td style="padding: 8px; border: 1px solid #ddd; font-weight: bold;">Expected Delivery Date:</td>
                            <td style="padding: 8px; border: 1px solid #ddd;">
                                <t t-out="object.purchase_id.date_planned or 'n/a'"/>
                            </td>
                        </tr>
                    </table>

                    <p style="margin: 20px 0 10px; padding: 0; color: #007bff; font-weight: bold;">Please log in to the system for further details.</p>
                    <p style="margin: 0; padding: 0;">Thanks,</p>
                </div>
            </field>
            <field name="lang">{{ object.partner_id.lang }}</field>
        </record>

        <record id="email_template_notify_account_manager" model="mail.template">
            <field name="name">Notify Account Manager</field>
            <field name="model_id" ref="purchase.model_purchase_order"/>
            <field name="subject">{{ object.company_id.name }} Purchase Order: {{ object.name or 'n/a' }}</field>
            <field name="partner_to">{{ object.partner_id.id }}</field>
            <field name="description">Notify Account Manager</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; font-size: 14px;">
                    <p>Dear <strong><t t-out="object.partner_id.name or ''">Vendor Name</t></strong>,</p>
                    <p>We are pleased to share with you the details of a new purchase order <strong><t t-out="object.name or ''"></t></strong>.</p>
                    <p><strong>Order Details:</strong></p>
                    <ul>
                        <li><strong>Purchase Order Reference:</strong> <t t-out="object.name or ''">PO12345</t></li>
                        <li><strong>Total Amount:</strong> <t t-out="format_amount(object.amount_total, object.currency_id) or ''"></t></li>
                        <li><strong>Vendor Reference:</strong> <t t-out="object.partner_ref or 'N/A'">REF-ABC</t></li>
                        <li><strong>Order Date:</strong> <t t-out="format_date(object.date_order) or ''">01/01/2025</t></li>
                        <li><strong>Scheduled Receipt Date:</strong> <t t-out="format_date(object.date_planned) or 'N/A'">15/01/2025</t></li>
                    </ul>
                    <p>Please find the attached purchase order for your reference. We kindly request you to review and acknowledge the receipt of this order at your earliest convenience.</p>
                    <t t-if="not is_html_empty(object.user_id.signature)">
                        <p>Thank you for your cooperation.</p>
                        <p><strong><t t-out="object.user_id.name or ''">Mitchell Admin</t></strong></p>
                        <p><t t-out="object.user_id.signature or ''">Signature</t></p>
                    </t>
                    <p>Best regards,</p>
                    <p><strong><t t-out="object.company_id.name or ''">Your Company</t></strong></p>
                </div>
            </field>
            <field name="report_template" ref="purchase.action_report_purchase_order"/>
            <field name="report_name">PO_{{ (object.name or '').replace('/','_') }}</field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="False"/>
        </record>

        <record id="email_template_notify_buyer" model="mail.template">
            <field name="name">Notify Buyer on Payment</field>
            <field name="model_id" ref="purchase.model_purchase_order"/>
            <field name="subject">Payment Completed for {{ object.name or 'n/a' }}</field>
            <field name="email_from">${(object.company_id.email or 'info@yourcompany.com')|safe}</field>
            <field name="email_to">{{ (object.partner_id.email_formatted or object.email) }}</field>
            <field name="body_html" type="html">
                <div style="font-family: Arial, sans-serif; font-size: 14px;">
                    <p>Hello,</p>
                    <p>The payment for Purchase Order <t t-out="object.name or ''" /> has been completed. Please follow up if needed.</p>
                    <p>Thank you.</p>
                </div>
            </field>
        </record>

        <record id="email_template_delivery_confirmation" model="mail.template">
            <field name="name">Delivery Confirmation Email</field>
            <field name="model_id" ref="stock.model_stock_picking"/>
            <field name="email_from">{{ object.company_id.email or user.email_formatted }}</field>
            <field name="email_to">{{ (object.partner_id.email_formatted or user.email_formatted) }}</field>
            <field name="subject">Delivery Completed: {{ object.name or 'n/a' }}</field>
            <field name="body_html" type="html">
                <div style="margin: 0; padding: 20px; font-family: Arial, sans-serif; font-size: 14px; color: #333;">
                    <p>Dear <t t-out="object.partner_id.name or ''" /> ,</p>
                    <p>We are pleased to inform you that the delivery for your order <b><t t-out="object.origin or ''" /> </b> has been successfully completed.</p>
                    <p>Please find the attached signature confirming the delivery.</p>
                    <p>Thank you for choosing our service!</p>
                    <p>Best regards,<br/><t t-out="object.company_id.name or ''" /> </p>
                    <p style="margin: 0; padding: 0;">Thanks,</p>
                </div>
            </field>
            <!-- <field name="attachment_ids" eval="[(4, object.upload_images.id)]"/> -->
            <field name="lang">{{ object.partner_id.lang }}</field>
        </record>


    </data>
</odoo>