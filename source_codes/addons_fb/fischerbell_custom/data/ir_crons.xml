<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="order_followup_cron" model="ir.cron">
            <field name="name">Set First Followup Date In Quotation</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="state">code</field>
            <field name="code">model.cron_set_followup_date()</field>
        </record>
    
        <record id="order_sec_followup_cron" model="ir.cron">
            <field name="name">Set Sec Followup Date In Quotation</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="state">code</field>
            <field name="code">model.cron_set_sec_followup_date()</field>
        </record>

        <record id="cron_send_email_to_customer" model="ir.cron">
			<field name="name">Send Email to Customer</field>
			<field name="model_id" ref="stock.model_stock_picking"/>
			<field name="state">code</field>
			<field name="code">model.send_email_to_customer()</field>
			<field name='interval_number'>1</field>
			<field name='interval_type'>days</field>
			<field name="numbercall">-1</field>
		</record>
        <record id="min_qty_re_order_cron" model="ir.cron">
            <field name="name">Re Order for min Quantity </field>
            <field name="model_id" ref="stock.model_stock_warehouse_orderpoint"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="state">code</field>
            <field name="code">model.cron_min_qty_alert()</field>
        </record>

         <record id="reminder_sales_to_quotation_cron" model="ir.cron">
            <field name="name">send mail to salesperson to create quotation</field>
            <field name="model_id" ref="crm.model_crm_lead"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="state">code</field>
            <field name="code">model.cron_remainder_to_salesperson()</field>
        </record>

        <record id="reminder_customer_to_status_cron" model="ir.cron">
            <field name="name">send mail to customer about status</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="state">code</field>
            <field name="code">model.cron_reminder_customer_to_status()</field>
        </record>

        <record id="processing_team_to_followup_cron" model="ir.cron">
            <field name="name">send mail to processing team to followup</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="state">code</field>
            <field name="code">model.cron_reminder_processing_team_to_followup()</field>
        </record>

        <!-- For Delivery lead time -->
        <record id="ir_cron_check_delivery_lead_time" model="ir.cron">
            <field name="name">Check Delivery Lead Time</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="state">code</field>
            <field name="code">model.check_delivery_lead_time()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="numbercall">-1</field>
            <field name="doall" eval="False"/>
            <field name="active" eval="True"/>
        </record>

        <record id="ir_cron_followup_reminders" model="ir.cron">
            <field name="name">Send Quotation Follow-Up Reminders</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="state">code</field>
            <field name="code">model._send_followup_reminders()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"></field>
        </record>
        
    </data>
</odoo>
