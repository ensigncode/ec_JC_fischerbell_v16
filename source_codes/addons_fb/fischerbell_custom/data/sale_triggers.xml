<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="email_template_sale_draft_trigger" model="mail.template">
            <field name="name">Ready For Review</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">Ready For Review: {{ object.name }}</field>
            <field name="email_from">{{ object.company_id.email_formatted }}
            </field>
            <field name="email_to">{{ object.partner_id.email_formatted }}</field>
            <field name="description">First trigger when order drafted for review</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear <t t-out="object.partner_id.name or ''"></t>,
                        <br/>
                        Your quotation <t t-out="object.name"/> amounting in <strong><t t-out="format_amount(object.amount_total, object.pricelist_id.currency_id) or ''"/>.</strong> is ready for review.
                        <br/>
                        Please do not hesitate to contact us if you have any questions.
                        <br/>
                        <t class="o_signature">
                            <div t-if="not is_html_empty(object.env.user.sudo().signature)"
                                 t-out="object.env.user.sudo().signature" style="font-size: 13px;"/>
                        </t>
                    </p>
                </div>
            </field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="True"/>
        </record>

        <!-- Second trigger -->
        <record id="email_template_sale_sale_state_trigger" model="mail.template">
            <field name="name">Quotation Confirmed</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">Quotation Confirmed: {{ object.name }}</field>
            <field name="email_from">{{ object.company_id.email_formatted }}
            </field>
            <field name="email_to">{{ object.partner_id.email_formatted }}</field>
            <field name="description">Second trigger when order confirmed</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear <t t-out="object.partner_id.name or ''"></t>,
                        <br/>
                        Thank you for confirming quotation <t t-out="object.name"/> amounting in <strong><t t-out="format_amount(object.amount_total, object.pricelist_id.currency_id) or ''"/>.</strong> We will contact you shortly to make the necessary arrangements.
                        <br/>
                        If you have any concerns or special instructions, please contact us immediately.
                        <br/>
                        <t class="o_signature">
                            <div t-if="not is_html_empty(object.env.user.sudo().signature)"
                                 t-out="object.env.user.sudo().signature" style="font-size: 13px;"/>
                        </t>
                    </p>
                </div>
            </field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="True"/>
        </record>

        <!-- Third trigger -->
        <record id="email_template_sale_picking_pending_state_trigger" model="mail.template">
            <field name="name">Operation Picked Up</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">Picked Up By Operation Team: {{ object.name }}</field>
            <field name="email_from">{{ object.company_id.email_formatted }}
            </field>
            <field name="email_to">{{ object.partner_id.email_formatted }}</field>
            <field name="description">Third Trigger when picked up by operation team</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear <t t-out="object.partner_id.name or ''"></t>,
                        <br/>
                        Your order <t t-out="object.name"/>has been packed and scheduled for delivery on <strong><t t-out="object.scheduled_delivery_date"  t-options='{"format": "MMM d, yyyy"}' />.</strong> We will contact you shortly to make the necessary arrangements.
                        <br/>
                        If you have any concerns or special instructions, please contact us immediately.
                        <br/>
                        <t class="o_signature">
                            <div t-if="not is_html_empty(object.env.user.sudo().signature)"
                                 t-out="object.env.user.sudo().signature" style="font-size: 13px;"/>
                        </t>
                    </p>
                </div>
            </field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="True"/>
        </record>

        <!-- Fourth trigger -->
        <record id="email_template_sale_picking_done_state_trigger" model="mail.template">
            <field name="name">Delivered</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="subject">Order Delivered: {{ object.name }}</field>
            <field name="email_from">{{ object.company_id.email_formatted }}
            </field>
            <field name="email_to">{{ object.partner_id.email_formatted }}</field>
            <field name="description">Fourth Trigger when products delivered to customer</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear <t t-out="object.partner_id.name or ''"></t>,
                        <br/>
                        Your order <t t-out="object.name"/>has been delivered on <strong><t t-out="object.scheduled_delivery_date"  t-options='{"format": "MMM d, yyyy"}' />.</strong> Attached is the Delivery Order <t t-out="','.join(object.picking_ids.filtered(lambda p: p.state == 'done').mapped('name'))" />  for your reference.
                        <br/>
                        <t t-set="invoice" t-value="object.invoice_ids"/>
                        <t t-if="invoice">
                            Here is your invoice <t t-out="invoice[0].name"> (with reference:<t t-out="object.name"/> )</t> amounting in <t t-out="invoice[0].amount_total"/> from Fischer Bell Private Ltd. Please remit payment at your earliest convenience.
                        </t>
                        <br/>
                        If you have any concerns or special instructions, please contact us immediately.
                        <br/>
                        <t class="o_signature">
                            <div t-if="not is_html_empty(object.env.user.sudo().signature)"
                                 t-out="object.env.user.sudo().signature" style="font-size: 13px;"/>
                        </t>
                    </p>
                </div>
            </field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="True"/>
        </record>
    </data>
</odoo>
