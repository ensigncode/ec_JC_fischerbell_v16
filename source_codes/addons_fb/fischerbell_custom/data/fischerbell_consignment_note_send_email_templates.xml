<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
		<record id="fischerbell_consignment_note_template_email" model="mail.template">
			<field name="name">Send: Consignment Note</field>
			<field name="model_id" ref="fischerbell_custom.model_mrp_production"/>
			<field name="subject">Consignment Note of {{ object.name }}</field>
			<field name="partner_to">{{ object.partner_id.id }}</field>
			<field name="body_html" type="html">
				<div>
					<p>
						<p>Hello,</p>
						<p>Here is the consignment note for  <t t-if="object.name" t-out="object.name or ''"/> 
							Plase finish the manufacute in <t t-if="object.consignment_period_id" t-out="object.consignment_period_id.name or ''"/> and deliver at <t t-if="object.delivery_date" t-out="object.delivery_date.strftime('%d %b %Y') or ''"/>
						</p>
						<p>Do not hesitate to contact us if you have any questions.
						Thank you!</p>
						<br/><br/>

						<p>Best regards,</p>
						<p><t t-out="object.user_id.name or ''"/></p><br/>
					</p>
				</div>
			</field>
		</record>
        <record id="email_template_to_customer" model="mail.template">
            <field name="name">Delivery: Order Is Ready To Ship</field>
            <field name="model_id" ref="sale.model_sale_order"/>
            <field name="email_from">{{ (object.company_id.email_formatted or user.email_formatted) }}</field>
            <field name="subject">{{ object.company_id.name }} Invoice ({{ object.name or 'n/a' }})</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Your order <span style="font-weight:bold;" t-out="object.name or ''"/> items is back in stock it will deliver to you soon</p>
                </div>
            </field>
            <field name="lang">{{ object.partner_id.lang }}</field>
            <field name="auto_delete" eval="True"/>
        </record>

	</data>
</odoo>
