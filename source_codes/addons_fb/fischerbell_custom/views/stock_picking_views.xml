<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="view_picking_form_inherit" model="ir.ui.view">
		<field name="name">stock.picking.form.inherit</field>
		<field name="model">stock.picking</field>
		<field name="inherit_id" ref="stock.view_picking_form" />
		<field name="arch" type="xml">
			<xpath expr="//notebook//page[@name='note']" position="attributes">
				<attribute name="string">Special Remark</attribute>
			</xpath>
			<xpath expr="//notebook//page[@name='note']//field[@name='note']" position="attributes">
				<attribute name="placeholder">Special Remark....</attribute>
			</xpath>
			<xpath expr="//group//group//field[@name='location_id']" position="attributes">
				<attribute name="readonly">1</attribute>
			</xpath>
			<xpath expr="//group//group//field[@name='location_dest_id']" position="attributes">
				<attribute name="readonly">1</attribute>
			</xpath>
			<xpath expr="//group//group//field[@name='date_done']" position="attributes">
				<attribute name="string">Delivery Date</attribute>
			</xpath>
			<xpath expr="//div[@name='button_box']//button[@name='action_see_move_scrap']" position="before">
				<label for="is_return_loan" string="Check Is Loan" invisible="1"/>
				<field name="is_return_loan" invisible="1"/>
			</xpath> 
			<xpath expr="//group//group//field[@name='origin']" position="after">
				<field name="operation_id" invisible="1"/>
				<field name="is_to_check" attrs="{'invisible': [('picking_type_code','!=','internal')], 'readonly': [('state','=','done')]}"/>
				<field name="pick_id" string="Pick Number" readonly="1" attrs="{'invisible': [('picking_type_code','!=','outgoing')]}"/>
				<field name="partner_note"/>
				<field name="user" invisible="1"/>
			</xpath>
			<xpath expr="//page[@name='operations']//field[@name='move_ids_without_package']//tree//field[@name='product_id']" position="after">
				<field name="mrp_line_id" invisible="1"/>
				<field name="mrp_customer_id" invisible="1"/>
			</xpath>
			<xpath expr="//group//group//div[@class='o_td_label']" position="replace">
				<div class="o_td_label">
					<field name="partner_type" invisible="1"/>
                    <label for="partner_id" string="Delivery Address" style="font-weight:bold;" attrs="{'invisible': [('picking_type_code', '!=', 'outgoing')]}"/>
                    <label for="partner_id" string="Receive From" style="font-weight:bold;" attrs="{'invisible': [('picking_type_code', '!=', 'incoming')]}"/>
                    <label for="partner_id" string="Contact" style="font-weight:bold;" attrs="{'invisible': ['|',('picking_type_code', 'in', ['incoming', 'outgoing']),('partner_type','=','followup')]}"/>
                    <label for="partner_id" string="Pick Address" style="font-weight:bold;" attrs="{'invisible': ['|',('picking_type_code', 'in', ['incoming', 'outgoing']),('partner_type','!=','followup')]}"/>
                </div>
            </xpath>
            <xpath expr="//group//group//field[@name='partner_id']" position="after">
            	<div attrs="{'invisible': ['|',('picking_type_code', 'in', ['incoming', 'outgoing']),('partner_type','!=','followup')]}">
            		<label for="partner_address" string=""/>
            	</div>
            </xpath>
            <xpath expr="//group//group//field[@name='picking_type_id']" position="before">
	            <field name="partner_address" nolabel="1" attrs="{'invisible': ['|',('picking_type_code', 'in', ['incoming', 'outgoing']),('partner_type','!=','followup')]}"/>
	        </xpath>
	        <xpath expr="//group//group//field[@name='backorder_id']" position="before">
	        	<field name="delivery_type" attrs="{'invisible': [('picking_type_code','!=','outgoing')]}"/>
	        	<field name="route_id" attrs="{'invisible': [('picking_type_code','!=','outgoing')]}"/>
	        </xpath>
	        <xpath expr="//page[@name='extra']//group//group[@name='other_infos']//field[@name='user_id']" position="after">
	        	<field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color', 'no_create_edit': True}" />
	        </xpath>
	        <xpath expr="//page[@name='detailed_operations']" position="inside">
		        <group name="terms_and_conditions" col="6" class="mt-2 mt-md-0">
                    <group colspan="4">
                        <field colspan="2" name="terms_and_conditions" nolabel="1" placeholder="Terms and conditions..."/>
                        <field name="is_default_terms" invisible="1"/>
	                    <button colspan="2" name="action_is_default_terms" string="Set Defaults" type="object"/>
                    </group>
                    <div class="clearfix"/>
                </group>
            </xpath>
			<xpath expr="//page[@name='operations']" position="after">
				<page string="Service" name="service">
					<field name="order_lines">
						<tree string="Stock Moves" editable="bottom">
							 <field name="product_id"/>
							 <field name="product_uom_qty"/>
							 <field name="product_uom"/>
							<field name="price_unit"/>
						</tree>
					</field>
				</page>
			</xpath>
		</field>
	</record>

    <record id="fischerbell_view_stock_move_operations" model="ir.ui.view">
        <field name="name">fischerbell.stock.move.operations.form</field>
        <field name="model">stock.move</field>
        <field name="inherit_id" ref="stock.view_stock_move_operations"/>
        <field name="priority">1000</field>
        <field name="arch" type="xml">
        	<xpath expr="//form//footer//button[@special='save']" position="attributes">
        		<attribute name="invisible">1</attribute>
        	</xpath>
        	<xpath expr="//form//footer//button[@special='save']" position="before">
        		<button name="confirm_stock" type="object" string="Confirm" class="oe_highlight"/>
        	</xpath>
        </field>
    </record>

    <record id="fischerbell_view_picking_internal_search" model="ir.ui.view">
        <field name="name">fischerbell.stock.picking.internal.search</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
        	<xpath expr="//search//filter[@name='backorder']" position="after">
        		<filter name="purchase_return" string="Purchase Return" domain="[('is_purchase_return','=',True)]"/>
        		<separator/>
        		<filter name="is_printed" string="Printed" domain="[('is_printed','=',True)]"/>
        		<filter name="is_printed" string="Not Printed" domain="[('is_printed','=',False)]"/>
        	</xpath>
        </field>
    </record>

    <record id="fischerbell_vpicktree" model="ir.ui.view">
        <field name="name">fischerbell.stock.picking.tree</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
        	<xpath expr="//tree//field[@name='partner_id']" position="after">
        		<field name="is_purchase_return" readonly="1"/>
        	</xpath>
        	<xpath expr="//field[@name='state']" position="before">
        		<field name="activity_ids" widget="list_activity"/>
        		<field name="is_printed"/>
        		<field name="print_date"/>
        		<field name="po_type" invisible="1"/>
        	</xpath>
        </field>
    </record>
</odoo>
