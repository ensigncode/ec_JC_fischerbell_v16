    <!-- Custom order line view. -->
    <record id="sale_order_analysis_report_tree_view" model="ir.ui.view">
        <field name="name">sale.order.analysis.report.tree.view</field>
        <field name="model">sale.order.line</field>
        <field name="arch" type="xml">
            <header>
                <button name="update_request_price" type="object" 
                            class="btn-primary" string="Approve Request"
                            attrs="{'invisible':[('approval_state','!=','pending')]}"
                            groups="account.group_account_manager"/>
                <button name="reject_request" type="object" 
                            class="btn-primary" string="Reject Request"
                            attrs="{'invisible':[('approval_state','!=','pending')]}"
                            groups="account.group_account_manager"/>
            </header>
            <tree string="Sales Order Lines" create="false">
                <field name="order_id"/>
                <field name="product_id" string="Product"/>
                <field name="name"/>
                <field name="salesman_id"/>
                <field name="product_uom_qty" string="Qty"/>
                <field name="qty_delivered"/>
                <field name="qty_invoiced"/>
                <field name="qty_to_invoice"/>
                <field name="product_uom" string="Unit of Measure" groups="uom.group_uom"/>
                <field name="last_invoice_date" />
                <field name="last_invoice_price" />
                <field name="price_unit"/>
                <field name="request_price" groups="account.group_account_manager"/>
                <field name="approval_state"/>
                <field name="price_subtotal" sum="Total" widget="monetary"/>
                <field name="currency_id" invisible="1"/>
            </tree>
        </field>
    </record>
    <record id="fischerbell_action_order_report_all" model="ir.actions.act_window">
        <field name="name">Sales Analysis</field>
        <field name="res_model">sale.order.line</field>
        <field name="view_mode">tree,form</field>
        <field name="target">current</field>
    </record>
    <menuitem id="fischerbell_menu_sale_report"
        name="Reporting"
        action="fischerbell_custom.fischerbell_action_order_report_all"
        groups="sales_team.group_sale_manager"
        parent="sale.menu_sale_report"
        sequence="40"/>
    <record id="action_all_report_loan_item" model="ir.actions.act_window">
        <field name="name">Loan Items</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">report.loan.item</field>
        <field name="view_mode">form</field>
        <field name="context">{}</field>
        <field name="domain">[]</field>
        <field name="target">new</field>
    </record>
    <menuitem id="menu_sale_loan_item_report"
        name="Loan Items"
        action="fischerbell_custom.action_all_report_loan_item"
        groups="sales_team.group_sale_salesman"
        parent="sale.menu_sale_report"
        sequence="41"/>

    <record id="inherit_rental_order_form_view" model="ir.ui.view">
        <field name="name">inherit.rental.order.form.view</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_renting.rental_order_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//div[hasclass('badge') and hasclass('rounded-pill') and hasclass('text-bg-info')  and hasclass('float-end') and hasclass('border-0')]" position="replace"/>
            <xpath expr="//div[hasclass('badge') and hasclass('rounded-pill') and hasclass('text-bg-info')  and hasclass('float-end') and hasclass('border-0')]" position="replace"/>
            <xpath expr="//div[hasclass('badge') and hasclass('rounded-pill') and hasclass('text-bg-warning')  and hasclass('float-end') and hasclass('border-0')]" position="replace"/>
            <xpath expr="//div[hasclass('badge') and hasclass('rounded-pill') and hasclass('text-bg-danger')  and hasclass('float-end') and hasclass('border-0')]" position="replace"/>
            <xpath expr="//div[hasclass('badge') and hasclass('rounded-pill') and hasclass('text-bg-success')  and hasclass('float-end') and hasclass('border-0')]" position="replace"/>
        </field>
    </record>
    
    <record id="sale_order_line_form_inherit_chater" model="ir.ui.view">
        <field name="name">sale.order.line.form.inherit.chatter</field>
        <field name="model">sale.order.line</field>
        <field name="inherit_id" ref="sale.sale_order_line_view_form_readonly"/>
        <field name="arch" type="xml">
            <xpath expr="//form/sheet" position="before">
                <header>
                    <field name="is_requested" invisible="1"/>
                    <button name="update_request_price" type="object" class="btn-primary" string="Approve Request"
                            groups="account.group_account_manager" attrs="{'invisible':['|',('approval_state','in',('approved','rejected')),('is_requested','=',False)]}"/>
                    <button name="reject_request" type="object" 
                            class="btn-primary" string="Reject Request"
                            attrs="{'invisible':['|',('approval_state','in',('approved','rejected')),('is_requested','=',False)]}"
                            groups="account.group_account_manager"/>
                <field name="approval_state" widget="statusbar" statusbar_visible="pending,approved,rejected"/>
                </header>
            </xpath>
            <xpath expr="//field[@name='price_unit']" position="after">
                <field name="request_price" groups="account.group_account_manager"/>
                <field name="approval_state"/>
            </xpath>
            <xpath expr="//form/sheet" position="after">
                <div class="oe_chatter">
	                <field name="message_follower_ids"/>
	                <field name="activity_ids"/>
	                <field name="message_ids"/>
                </div>
            </xpath>
        </field>
     </record>

    <record id="fischerbell_action_order_update_request" model="ir.actions.act_window">
        <field name="name">Update Request</field>
        <field name="res_model">sale.order.line</field>
        <field name="view_mode">tree,form</field>
