<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="fischerbell_view_manufacture_lot_form" model="ir.ui.view">
        <field name="name">fischerbell.view.manufacture.lot.form</field>
        <field name="model">fischerbell.manufacture.lot</field>
        <field name="arch" type="xml">
        	<form>
        		<sheet>
        			<div class="oe_title">
                        <label for="name"/>
                        <h1>
                            <field name="name" placeholder="..."/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="partner_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Lines">
                            <field name="manufacture_lot_line_ids">
                                <tree editable="bottom">
                                    <field name="product_tmpl_id"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
				</sheet>
			</form>
        </field>
    </record>

    <record id="fischerbell_view_manufacture_lot_filter" model="ir.ui.view">
        <field name="name">fischerbell.view.manufacture.lot.filter</field>
        <field name="model">fischerbell.manufacture.lot</field>
        <field name="priority" eval="15"/>
        <field name="arch" type="xml">
            <search string="Search">
                <field name="name" string="Manufacture No" filter_domain="[('name', 'ilike', self)]"/>
                <field name="partner_id" string="Manufacturer" filter_domain="[('partner_id.name','ilike', self)]"/>
            </search>
        </field>
    </record>

	<record id="fischerbell_view_manufacture_lot_tree" model="ir.ui.view">
        <field name="name">fischerbell.view.manufacture.lot.tree</field>
        <field name="model">fischerbell.manufacture.lot</field>
        <field name="arch" type="xml">
        	<tree>
	        	<field name="name"/>
                <field name="partner_id"/>
			</tree>
        </field>
    </record>

    <record id="action_fischerbell_manufacture_lot" model="ir.actions.act_window">
        <field name="name">Manufacture No</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">fischerbell.manufacture.lot</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'group_by': 'partner_id'}</field>
        <field name="domain">[]</field>
        <field name="search_view_id" ref="fischerbell_custom.fischerbell_view_manufacture_lot_filter"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Manufacture No
            </p>
        </field>
    </record>

    <menuitem id="menu_fischerbell_manufacture_lot"
        name="Manufacture No"
        action="fischerbell_custom.action_fischerbell_manufacture_lot"
        parent="stock.menu_stock_inventory_control"
        />
</odoo>
