<?xml version='1.0' encoding='UTF-8' ?>
<odoo>
    <record id="fischerbell_mrp_production_form_view" model="ir.ui.view">
        <field name="name">fischerbell.mrp.production.form</field>
        <field name="model">mrp.production</field>
        <field name="inherit_id" ref="mrp.mrp_production_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group//group//field[@name='product_id']" position="before">
                <field name="partner_id" string="Manufacture Company"/>
                <field name="requestor_id"/>
            </xpath>
            <xpath expr="//page[@name='components']//field[@name='move_raw_ids']//tree//field[@name='location_id']" position="after">
                <field name="customer_id" domain="[('type','=','dept_staff')]"/>
                <field name="phone"/>
                <field name="batch_number"/>
                <field name="lot_id"/>
            </xpath>
            <xpath expr="//page[@name='components']//field[@name='move_raw_ids']" position="after">
                <field name="notes" placeholder="Terms and Conditions..."/>
            </xpath>
            <xpath expr="//group//group[@name='group_extra_info']//field[@name='user_id']" position="before">
                <field name="delivery_date"/>
                <field name="consignment_period_id"/>
                <field name="sale_id"/>
                <field name="procurement_group_id" invisible="1"/>
            </xpath>
            <xpath expr="//page[@name='miscellaneous']//group//group//field[@name='origin']" position="after">
                <field name="mrp_team_id"/>
            </xpath>
            <xpath expr="//page[@name='miscellaneous']" position="after">
                <page string="Special Remark">
                    <field name="len_note" invisible="1"/>
                    <field name="note" string="" placeholder="Special Remark...."/>
                </page>
            </xpath>
            <xpath expr="//group//group[@name='group_extra_info']//field[@name='user_id']" position="after">
                <field name="partner_note"/>
            </xpath>
            <xpath expr="//header//button[@name='action_confirm']" position="before">
                <button name="action_consignment_send" type="object" string="Send By Email" context="{'is_consignment_send': True}" class="oe_highlight"/>
            </xpath>
        </field>
    </record>
</odoo>
