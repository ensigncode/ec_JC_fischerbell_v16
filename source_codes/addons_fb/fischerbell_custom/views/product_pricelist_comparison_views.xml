<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="product_pricelist_comparison_view_tree" model="ir.ui.view">
        <field name="name">product.pricelist.comparison.tree</field>
        <field name="model">product.pricelist.comparison</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="pricelist_id"/>
                <field name="comparison_line_ids"/>
            </tree>
        </field>
    </record>

    <record id="product_pricelist_comparison_view" model="ir.ui.view">
        <field name="name">product.pricelist.comparison.form</field>
        <field name="model">product.pricelist.comparison</field>
        <field name="arch" type="xml">
            <form string="Products Pricelist Comparison">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="bg-danger" attrs="{'invisible': [('active', '=', True)]}"/>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="e.g. Public Pricelist Comparasion"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="pricelist_id"/>
                            <field name="active" invisible="1"/>
                            <field name="filename" invisible="1"/>
                            <field name="demo_filename" invisible="1"/>
                        </group>
                        <group>
                            <field name="demo_file" filename="demo_filename"/>
                            <field name="comparison_file" filename="filename"/>
                        </group>
                    </group>
                    <div class="oe_inline">
                        <button string="Read XLSX Data" name="read_xlsx_data" type="object" class="oe_highlight"/>
                    </div>
                    <notebook>
                        <page name="pricelist_product_lines" string="Product Pricelist">
                            <field name="comparison_line_ids" nolabel="1">
                                <tree string="Pricelist Rules" editable="bottom" decoration-danger="operation_type == 'reject'" decoration-success="operation_type == 'approve'">
                                    <field name="product_tmpl_id" string="Products" required="1"/>
                                    <field name="product_id" string="Variants" groups="product.group_product_variant" domain="[('product_tmpl_id', '=', product_tmpl_id)]" options="{'no_create':1}"/>
                                    <field name="old_price"/>
                                    <field name="new_price"/>
                                    <field name="difference"/>
                                    <field name="comparison_id" invisible="1"/>
                                    <field name="operation_type" invisible="1"/>
                                    <button name="action_apply" string="Apply" type="object" attrs="{'invisible': [('operation_type', '!=', False)]}" class="btn-link" icon="fa-check"/>
                                    <button name="action_reject" string="Reject" type="object" attrs="{'invisible': [('operation_type', '!=', False)]}" class="btn-link" icon="fa-ban"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_product_pricelist_comaparison" model="ir.actions.act_window">
        <field name="name">Pricelists Comparison</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.pricelist.comparison</field>
        <field name="view_mode">tree,form</field>
    </record>

    <record id="product_pricelist_comparison_line_view_tree" model="ir.ui.view">
        <field name="name">product.pricelist.comparison.line.tree</field>
        <field name="model">product.pricelist.comparison.line</field>
        <field name="arch" type="xml">
            <tree create="0" decoration-danger="operation_type == 'reject'" decoration-success="operation_type == 'approve'">
                <field name="comparison_id" invisible="1"/>
                <field name="product_tmpl_id" string="Products"/>
                <field name="product_id" string="Variants" groups="product.group_product_variant"/>
                <field name="old_price"/>
                <field name="new_price"/>
                <field name="difference"/>
                <field name="operation_type" invisible="1"/>
                <button name="action_apply" string="Apply" type="object" attrs="{'invisible': [('operation_type', '=', True)]}" class="btn-link" icon="fa-check"/>
                <button name="action_reject" string="Reject" type="object" attrs="{'invisible': [('operation_type', '=', True)]}" class="btn-link" icon="fa-ban"/>
            </tree>
        </field>
    </record>

    <record id="action_product_pricelist_comparison_line" model="ir.actions.act_window">
        <field name="name">Product Pricelist Lines</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.pricelist.comparison.line</field>
        <field name="view_mode">tree</field>
    </record>

    <menuitem id="menu_product_pricelist_comparison"
        name="Pricelists Comparison"
        parent="sale.product_menu_catalog"
        action="action_product_pricelist_comaparison"
        sequence="31"/>
    
    <menuitem id="menu_product_pricelist_comparison_line"
        name="Product Pricelist Lines"
        parent="sale.product_menu_catalog"
        action="action_product_pricelist_comparison_line"
        sequence="32"/>

</odoo>
