        <field name="view_mode">tree,form</field>
		<field name="domain">[('cargo_clearance_permit_no', '!=', False )]</field>
		<field name="view_id" ref="fischerbell_custom.purchase_order_report_sg_tree_view"/>
<!--        <field name="target">current</field>-->
    </record>

