<?xml version='1.0' encoding='UTF-8' ?>
<odoo>
	<record id="fischerbell_purchase_order_form_inherit" model="ir.ui.view">
		<field name="name">fischerbell.purchase.order.form.inherit</field>
		<field name="model">purchase.order</field>
		<field name="inherit_id" ref="purchase.purchase_order_form"/>
		<field name="arch" type="xml">
			<xpath expr="//label[@for='date_planned']" position="before">
				<field name="request_delivery_date" required="1"/>
				<field name="estimated_delivery_date"/>
			</xpath>
			<xpath expr="//field[@name='currency_id']" position="before">
				<field name="reject_reason" attrs="{'invisible': [('state', '!=', 'reject')]}"/>
				<field name="is_supplier" readonly="1" force_save="1"/>
			</xpath>

			<xpath expr="//div[@name='reminder']" position="attributes">
				<attribute name="invisible">1</attribute>
			</xpath>
			<xpath expr="//label[@for='receipt_reminder_email']" position="attributes">
				<attribute name="invisible">1</attribute>
			</xpath>
			<xpath expr="//group//group//field[@name='partner_id']" position="after">
				<field name="supplier_code"/>
			</xpath>
			<xpath expr="//field[@name='order_line']//field[@name='price_unit']" position="before">
				<field name="last_purchase_price"/>
				<button name="action_open_last_purchase_order" type="object" icon="fa-share-square-o" title="Last Purchase Order" attrs="{'invisible': [('last_purchase_price', '=', 0.0)]}"/>
				<field name="last_po_id" invisible="1"/>
			</xpath>
			<xpath expr="//field[@name='order_line']//field[@name='product_id']" position="after">
				<field name="product_code"/>
			</xpath>
			<xpath expr="//field[@name='order_line']//tree//field[@name='product_id']" position="attributes">
				<attribute name="context">{'partner_id':parent.partner_id, 'quantity':product_qty,'uom':product_uom, 'company_id': parent.company_id, 'is_purchase_order': True}</attribute>
			</xpath>
			<xpath expr="//field[@name='order_line']//field[@name='name']" position="after">
				<field name="comments" sting="Comments" optional="hide"/>
				<field name="customer_id"  optional="hide"/>
				<field name="customer_sku" optional="hide"/>
				<field name="manufacture_lot_id" optional="hide"/>
				<field name="batch_number" invisible="1"/>
				<field name="lot_id" optional="hide"/>
				<field name="request_delivery_date"  optional="hide"/>
				<field name="used_lot_serials"  optional="hide"/>
				<field name="approval_state"  optional="hide"/>
				<field name="estimated_delivery_date"  optional="hide"/>
				<field name="po_reason"  optional="hide"/>
				<field name="sale_line_id" invisible="1"/>
				<button name="action_approve_line" type="object" string="Approve" 
                    attrs="{'invisible': [('approval_state', '=', 'approved')]}" class="btn-primary"/>
            	<button name="action_reject_line" type="object" string="Reject" 
                    attrs="{'invisible': [('approval_state', '=', 'approved')]}" class="btn-secondary"/>
			</xpath>	
			<xpath expr="//field[@name='order_line']//field[@name='date_planned']" position="attributes">
				<attribute name="invisible">1</attribute>
			</xpath>
			<xpath expr="//notebook//page[@name='purchase_delivery_invoice']" position="after">
				<page string="Internal Remarks" name="special_remark">
					<field name="internal_note" nolabel="1" placeholder="Special Remark...."/>
				</page>
			</xpath>
			<xpath expr="//page[@name='purchase_delivery_invoice']//group//group[@name='invoice_info']//field[@name='invoice_status']" position="before">
				<field name="journal_id" domain="[('type','in',['cash','bank'])]"/>
			</xpath>
			<xpath expr="//page[@name='purchase_delivery_invoice']//group//group[@name='other_info']//field[@name='user_id']" position="after">
				<field name="purchase_team_id" optional="hide"/>
				<field name="artwork_attachment_ids" optional="hide" widget="many2many_binary" string="Artwork/Attachment"/>
			</xpath>
			<xpath expr="//page[@name='products']//group//group//field[@name='notes']" optional="hide" position="after">
				<field name="po_comments" optional="hide"/>
				<field name="is_default_terms" invisible="1" optional="hide"/>
				<button colspan="2" name="action_is_default_terms_purchase" string="Set Defaults" type="object"/>
			</xpath>
			<xpath expr="//header//button[@name='button_cancel']" position="before">
				<field name="partner_request_state" invisible="1"/>
				<field name="is_contact_created" invisible="1"/>
				<button name="action_submit_approval" type="object" string="Send for Approval" attrs="{'invisible': [('state','!=','draft')]}" class="btn-primary" />
				<!-- <button name="sc_approved" string="Approved" type="object" attrs="{'invisible': ['|',('partner_request_state','!=','approved'),('state','=','approved')]}" class="btn-primary"/> -->
				<button name="create_sequance_contact" string="Financial Approval" type="object" 
                        class="btn-primary" attrs="{'invisible': ['|',('is_contact_created','=',True),'|', '|',('partner_request_state', 'in', ('approved', 'pending')),('state', '!=', 'approve'),('approval_state', '!=', 'approved')]}"/>
                 <button name="action_to_approve" type="object" string="Approve" attrs="{'invisible': [('state','!=','submitted')]}" class="btn-primary" />
                <button name="action_to_reject" type="object" string="Reject" attrs="{'invisible': [('state','!=','submitted')]}" class="btn-primary"/>
			</xpath>
			<xpath expr="//field[@name='partner_id']" position="after">
				<field name="can_create_bill" invisible="1" />
			</xpath>
			<!-- <xpath expr="//header/button[@name='action_create_invoice'][1]" position="attributes">
				<attribute name="attrs">{
					'invisible': [
						'|','|',
						('state', 'not in', ('purchase', 'done')),
						('invoice_status', 'in', ('no', 'invoiced')),
						('can_create_bill', '=', False)
					]
				}</attribute>
        	</xpath>
			<xpath expr="//header/button[@name='action_create_invoice'][2]" position="attributes">
			<attribute name="attrs">{
				'invisible': [
					'|', '|', '|',
					('state', 'not in', ('purchase', 'done')), 
					('invoice_status', 'not in', ('no', 'invoiced')), 
					('order_line', '=', []), 
					('can_create_bill', '=', False)
				]
			}</attribute>
		</xpath> -->
			<xpath expr="//header//button[@name='button_cancel']" position="attributes">
				 <attribute name="states"></attribute>
				 <attribute name="attrs">{'invisible': [('state','in',('draft','done','cancel','purchase','cancel_approval'))]}</attribute>
			</xpath>
			<xpath expr="//notebook//page[@name='special_remark']" position="after">
				<page string="Shipment Tracking">
					<group>
						<group>
							<field name="shipment_tracking_date"/>
							<field name="cargo_clearance_permit_no"/>
							<field name="logistics"/>
							<field name="partner_id"/>
							<field name="total_cif"/>
							<field name="total_amount_payable"/>
						</group>
						<group>
							<field name="api_no"/>
							<field name="remarks_one"/>
							<field name="remarks_two"/>
							<field name="status"/>
						</group>
					</group>
				</page>
			</xpath>
			<xpath expr="//field[@name='date_planned']" position="attributes">
				<attribute name="invisible">1</attribute>
			</xpath>
			<xpath expr="//field[@name='date_order']" position="attributes">
				<attribute name="invisible">1</attribute>
			</xpath>
			<xpath expr="//header//button[@name='print_quotation'][1]" position="after">
			   <button name="button_confirm_wizard" type="object" string="Confirm Order" context="{'validate_analytic': True}" class="oe_highlight" id="bid_confirm" data-hotkey="v" attrs="{'invisible':['|',('partner_request_state','!=','approved'),('state','!=','approve')]}"/>
			   <button name="button_supplier_confirm" type="object" string="Supplier Confirm" context="{'validate_analytic': True}" class="oe_highlight" id="bid_confirm" data-hotkey="v" attrs="{'invisible':['|', ('is_supplier', '=', True), ('state','!=','draft')]}"/>
			   <button name="button_confirm_po" type="object" string="Confirm Order" context="{'validate_analytic': True}" class="oe_highlight" id="bid_confirm" data-hotkey="v" attrs="{'invisible':[('state','!=','draft')]}"/>
			</xpath>
			<!-- <xpath expr="//header//button[@name='print_quotation'][2]" position="after">
			    <button name="button_confirm_wizard" type="object" context="{'validate_analytic': True}" attrs="{'invisible':['|',('partner_request_state','!=','approved'),('state','!=','approve')]}" string="Confirm Order" id="draft_confirm"/>

			</xpath> -->
			<xpath expr="//button[@name='action_rfq_send'][1]" position="attributes">
				<attribute name="attrs">{'invisible':[('state','!=','approve')]}</attribute>
				<attribute name="states"></attribute>
			</xpath>
			<xpath expr="//button[@name='action_rfq_send'][2]" position="attributes">
				<attribute name="attrs">{'invisible':['|',('partner_request_state','!=','approved'),('state','in',('draft','sent','purchase','done', 'submitted', 'approve'))]}</attribute>
				<attribute name="states"></attribute>
			</xpath>
			<xpath expr="//header//button[@name='print_quotation'][1]" position="attributes">
				<attribute name="attrs">{'invisible':['|',('partner_request_state','!=','approved'),('state','not in',('draft','reject')),('approval_state','not in',('no','approve'))]}</attribute>
				<attribute name="states"></attribute>
			</xpath>
			<xpath expr="//header//button[@name='print_quotation'][2]" position="attributes">
				<attribute name="attrs">{'invisible':['|',('partner_request_state','!=','approved'),('state','in',('sent','draft'))]}</attribute>
				<attribute name="states"></attribute>
			</xpath>
			<xpath expr="//button[@name='button_confirm'][1]" position="attributes">
				<attribute name="invisible">True</attribute>
				<attribute name="states"></attribute>
			</xpath>
			<xpath expr="//button[@name='button_confirm'][2]" position="attributes">
				<attribute name="invisible">True</attribute>
				<attribute name="states"></attribute>
			</xpath>
			<xpath expr="//form//sheet" position="before">
            	<div class="alert alert-info text-center o_form_header" role="alert" attrs="{'invisible':[('partner_request_state','!=','pending')]}">
                  <a class="close" data-bs-dismiss="alert" href="#">x</a>
                  <div>
                    <strong>Vendor is in Approval Process. </strong>
                  </div>
                </div>
            </xpath>
            <xpath expr="//form//sheet" position="before">
            	<div class="alert alert-danger text-center o_form_header" role="alert" attrs="{'invisible':[('partner_request_state','!=','rejected')]}">
                  <a class="close" data-bs-dismiss="alert" href="#">x</a>
                  <div>
                    <strong>Vendor is Rejected. </strong>
                  </div>
                </div>
            </xpath>
            <xpath expr="//field[@name='date_order']" position="before">
            	<field name="approval_state" widget="badge" decoration-danger="approval_state == 'reject'" decoration-warning="approval_state == 'waiting_approval'" decoration-success="approval_state == 'approved'" decoration-info="approval_state == 'no'" />
            </xpath>
			<field name="partner_ref" position="after">
				<field name="po_req_type_id" />
			</field>
		</field>
	</record>

	<record id="fischerbell_purchase_order_view_form_inherit" model="ir.ui.view">
		<field name="name">fischerbell.purchase.order.form.inherit</field>
		<field name="model">purchase.order</field>
		<field name="inherit_id" ref="purchase_stock.purchase_order_view_form_inherit"/>
		<field name="arch" type="xml">
			<xpath expr="//field[@name='picking_type_id']" position="after">
				<field name="mail_sended" readonly="1"/>
				<field name="partner_note"/>
			</xpath>
			<xpath expr="//field[@name='incoterm_location']" position="attributes">
				<attribute name="invisible">True</attribute>
			</xpath>
		</field>
	</record>

	<record id="purchase_order_kpis_tree_inherit_purchase_requisition_new" model="ir.ui.view">
        <field name="name">purchase.order.kpis.tree.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_view_tree"/>
        <field name="arch" type="xml">
			<field name="name" position="before">
				<field name="create_date" optional="hide" />
			</field>
            <field name="invoice_status" position="after">
				<field name="next_delivery_date"/>
                <field name="estimated_delivery_date"/>
                <field name="approval_state" widget="badge" decoration-danger="approval_state == 'reject'" decoration-warning="approval_state == 'waiting_approval'" decoration-success="approval_state == 'approved'" decoration-info="approval_state == 'no'" />
            </field>
	        <xpath expr="//field[@name='date_planned']" position="attributes">
				<attribute name="invisible">1</attribute>
			</xpath>

        </field>
    </record>

	<record id="purchase_order_kpis_tree_inherit" model="ir.ui.view">
        <field name="name">purchase.order.kpis.tree.inherit</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_kpis_tree"/>
        <field name="arch" type="xml">
			<field name="name" position="before">
				<field name="create_date" optional="hide" />
			</field>
			<xpath expr="//field[@name='date_order']" position="attributes">
				<attribute name="invisible">1</attribute>
			</xpath>
        </field>
    </record>

