	<record id="purchase_order_report_sg_tree_view" model="ir.ui.view">
        <field name="name">purchase.order.report.sg.tree.view</field>
        <field name="model">purchase.order</field>
        <field name="arch" type="xml">
            <tree string="Purchase Order" create="false">
                <field name="name"/>
				<field name="shipment_tracking_date"/>
				<field name="cargo_clearance_permit_no"/>
				<field name="logistics"/>
				<field name="partner_id"/>
				<field name="total_cif"/>
				<field name="total_amount_payable"/>
				<field name="api_no"/>
				<field name="remarks_one"/>
				<field name="remarks_two"/>
				<field name="status"/>
            </tree>
        </field>
    </record>

	<record id="fischerbell_action_purchase_order_sg" model="ir.actions.act_window">
        <field name="name">Freight Charges</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">tree,form</field>
		<field name="domain">[('cargo_clearance_permit_no', '!=', False )]</field>
		<field name="view_id" ref="fischerbell_custom.purchase_order_report_sg_tree_view"/>
<!--        <field name="target">current</field>-->
    </record>

	 <record id="fischerbell_action_purchase_order_report_all" model="ir.actions.act_window">
        <field name="name">Purchase Analysis</field>
        <field name="res_model">purchase.order.line</field>
        <field name="view_mode">tree,form</field>
        <field name="target">current</field>
    </record>

	<menuitem id="fischerbell_menu_purchase_report"
        name="Reporting"
        action="fischerbell_custom.fischerbell_action_purchase_order_report_all"
        parent="purchase.purchase_report_main" />

	<menuitem id="fischerbell_menu_freight_charges"
        name="Freight Charges"
	    action="fischerbell_custom.fischerbell_action_purchase_order_sg"
		parent="purchase.purchase_report_main" />

	<record id="fischerbell_purchase_history_tree_inherit" model="ir.ui.view">
		<field name="name">fischerbell.purchase.history.tree.inherit</field>
		<field name="model">purchase.order.line</field>
		<field name="inherit_id" ref="purchase.purchase_history_tree"/>
		<field name="arch" type="xml">
			<xpath expr="//field[@name='order_id']" position="after">
				<field name="product_id"/>
				<field name="name"/>
			</xpath>
		</field>
	</record>

