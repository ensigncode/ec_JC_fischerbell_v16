<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="fischerbell_view_sale_terms_and_conditions_form" model="ir.ui.view">
        <field name="name">fischerbell.view.sale.terms.and.conditions.form</field>
        <field name="model">fischerbell.sale.terms.and.conditions</field>
        <field name="arch" type="xml">
        	<form>
        		<sheet>
        			<group>
        				<group>
				        	<field name="name"/>
				        </group>
                        <group>
                            <field name="type"/>
                        </group>
				    </group>
                    <group colspan="4">
                        <field name="note" colspan="2" nolabel="1" placeholder="Terms and conditions..."/>
                    </group>
				</sheet>
			</form>
        </field>
    </record>

	<record id="fischerbell_view_sale_terms_and_conditions_tree" model="ir.ui.view">
        <field name="name">fischerbell.view.sale.terms.and.conditions.tree</field>
        <field name="model">fischerbell.sale.terms.and.conditions</field>
        <field name="arch" type="xml">
        	<tree>
	        	<field name="name"/>
			</tree>
        </field>
    </record>

    <record id="action_fischerbell_sale_terms_and_conditions" model="ir.actions.act_window">
        <field name="name">Terms and Conditions</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">fischerbell.sale.terms.and.conditions</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="domain">[]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Terms and Conditions
            </p>
        </field>
    </record>

    <menuitem id="menu_fischerbell_terms_and_conditions"
        name="Terms and Conditions"
        action="fischerbell_custom.action_fischerbell_sale_terms_and_conditions"
        parent="sale.menu_sales_config"
        />
</odoo>
