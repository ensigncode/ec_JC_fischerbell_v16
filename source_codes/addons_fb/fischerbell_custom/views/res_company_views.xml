<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_company_form_inherit_social_media_fcb" model="ir.ui.view">
        <field name="name">res.company.form.inherit.social.media.fcb</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='social_twitter']" position="after">
                    <field name="social_lazada"/>
                    <field name="social_store"/>
                    <field name="social_shopee"/>
            </xpath>
        </field>
    </record>

</odoo>
