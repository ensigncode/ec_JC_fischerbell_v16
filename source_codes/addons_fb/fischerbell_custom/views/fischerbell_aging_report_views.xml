<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="fischerbell_aging_report_menu_action" model="ir.actions.act_window">
        <field name="name">Aging Report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.product</field>
        <field name="view_mode">tree</field>
        <field name="context">{}</field>
        <field name="domain">[('tracking', 'in', ['lot','serial'])]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new aging report
            </p>
        </field>
    </record>

    <menuitem id="menu_aging_report"
        action="fischerbell_aging_report_menu_action"
        parent="stock.menu_warehouse_report"/>
</odoo>