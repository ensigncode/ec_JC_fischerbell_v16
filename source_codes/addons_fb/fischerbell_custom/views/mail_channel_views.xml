<?xml version='1.0' encoding='UTF-8' ?>
<odoo>
    <record id="fischerbell_mail_channel_view_form_inherit" model="ir.ui.view">
        <field name="name">fischerbell.mail.channel.form.inherit</field>
        <field name="model">mail.channel</field>
        <field name="inherit_id" ref="mail.mail_channel_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@class='o_label_nowrap']" position="after">
                <group class="o_label_nowrap">
                    <field name="is_sales_loan_management" />
                </group>
            </xpath>
        </field>
    </record>
</odoo>