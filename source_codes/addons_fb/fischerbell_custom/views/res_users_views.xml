<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_inherit" model="ir.ui.view">
        <field name="name">res.users.form.inherits</field>
        <field name="model">res.users</field>
        <field name="type">form</field>
        <field name="inherit_id" ref="hr.res_users_view_form_profile" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='signature']" position="before">
                <field name="email_signature_option" />
            </xpath>
        </field>
    </record>
    <record id="view_users_form_simple_modif_fcb" model="ir.ui.view">
        <field name="name">res.users.preferences.form.fcb</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form_simple_modif" />
        <field name="arch" type="xml">
            <xpath expr="//h1" position="after">
                <group id="fcb_data_show">
                    <group>
                        <field name="can_edit" invisible="1" />
                        <field name="mobile_phone" widget="phone" attrs="{'readonly': [('can_edit', '=', False)]}" />
                        <field name="work_phone" widget="phone" attrs="{'readonly': [('can_edit', '=', False)]}" />
                    </group>
                    <group>
                        <field name="work_email" widget="email" attrs="{'readonly': [('can_edit', '=', False)]}" />
                        <field name="address_id" invisible="1" />
                        <field name="work_location_id" />
                        <field name="company_id" invisible="1" />
                    </group>
                    <group>
                        <field name="employee_parent_id" attrs="{'readonly': [('can_edit', '=', False)]}" />
                        <field name="coach_id" attrs="{'readonly': [('can_edit', '=', False)]}" />
                    </group>
                </group>
            </xpath>
        </field>
    </record>
    <record id="res_users_view_form_profile_fcb" model="ir.ui.view">
        <field name="name">res.users.preferences.form.inherit.fcb</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="hr.res_users_view_form_profile" />
        <field name="arch" type="xml">
            <xpath expr="//group[@id='fcb_data_show']" position="replace">
            </xpath>
        </field>
    </record>
    <record id="action_portal_users" model="ir.actions.act_window">
        <field name="name">Portal Users</field>
        <field name="res_model">res.users</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="base.view_users_form" />
        <field name="context">{'portal_user':True, 'default_is_portal_user': True}</field>
        <field name="domain">[('is_portal_user', '=', True)]</field>
    </record>
    <record id="portal_user_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="3" />
        <field name="view_mode">tree</field>
        <field name="view_id" ref="base.view_users_tree" />
        <field name="act_window_id" ref="action_portal_users" />
    </record>
    <record id="portal_user_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="4" />
        <field name="view_mode">form</field>
        <field name="view_id" ref="base.view_users_form" />
        <field name="act_window_id" ref="action_portal_users" />
    </record>
    <menuitem id="menu_portal_user" name="Portal User" parent="sale.sale_menu_root" sequence="10" action="action_portal_users" groups="sales_team.group_sale_manager"/>
</odoo>