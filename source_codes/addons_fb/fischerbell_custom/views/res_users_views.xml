<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="view_users_form_inherit" model="ir.ui.view">
            <field name="name">res.users.form.inherits</field>
            <field name="model">res.users</field>
            <field name="type">form</field>
<!--            <field name="inherit_id" ref="base.view_users_form"/>-->
            <field name="inherit_id" ref="hr.res_users_view_form_profile"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='signature']" position="before">
                            <field name="email_signature_option"/>
                </xpath>
            </field>
        </record>

     <record id="view_users_form_simple_modif_fcb" model="ir.ui.view">
            <field name="name">res.users.preferences.form.fcb</field>
            <field name="model">res.users</field>
            <field name="inherit_id" ref="base.view_users_form_simple_modif"/>
            <field name="arch" type="xml">

                    <xpath expr="//field[@name='signature']" position="before">
                        <field name="email_signature_option"/>
                    </xpath>
                    <xpath expr="//h1" position="after">
                        <group>
                        <group>
                            <field name="can_edit" invisible="1"/>
                            <field name="mobile_phone" widget="phone" attrs="{'readonly': [('can_edit', '=', False)]}"/>
                            <field name="work_phone" widget="phone" attrs="{'readonly': [('can_edit', '=', False)]}"/>
                        </group>
                        <group>
                            <field name="work_email" widget="email" attrs="{'readonly': [('can_edit', '=', False)]}"/>
                            <field name="address_id" invisible="1"/>
                            <field name="work_location_id"/>
                            <field name="company_id" invisible="1"/>
                        </group>
                        <group>
                            <field name="employee_parent_id" attrs="{'readonly': [('can_edit', '=', False)]}"/>
                            <field name="coach_id" attrs="{'readonly': [('can_edit', '=', False)]}"/>
                        </group>
                    </group>
                    </xpath>
            </field>
        </record>

</odoo>
