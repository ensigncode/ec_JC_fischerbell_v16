<?xml version='1.0' encoding='UTF-8' ?>
<odoo>
    <record id="fischerbell_view_partner_form" model="ir.ui.view">
        <field name="name">fischerbell.res.partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority" eval="1"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sale']" position="inside">
                <field name="credit_limit"/>
            </xpath>
            <xpath expr="//field[@name='user_ids']" position="before">
                <field name="fax" widget="phone"/>
            </xpath>
            <xpath expr="//field[@name='vat']" position="after">
<!--                <field name="partner_seq"/>-->
                <field name="e_invoice_email" widget="email"/>
                <field name="soa_email" widget="email"/>
                <field name="currency_id" readonly="False" force_save="1"/>
            </xpath>
            <xpath expr="//field[@name='vat']" position="after">
                <field name="no_delivery_days_selection"/>
                <field name="no_delivery_days" attrs="{'invisible':[('no_delivery_days_selection','in',['date',False])]}"/>
                <label for="delivery_restriction_start_date" string="Date" attrs="{'invisible':[('no_delivery_days_selection','in',['days',False])]}"/>
                <div name="dates" class="o_row" attrs="{'invisible':[('no_delivery_days_selection','in',['days',False])]}">
                    <field name="delivery_restriction_start_date" widget="daterange" options='{"related_end_date": "delivery_restriction_end_date"}'/>
                    <i class="fa fa-long-arrow-right mx-2 oe_edit_only" aria-label="Arrow icon" title="Arrow"/>
                    <i class="fa fa-long-arrow-right mx-2 oe_read_only" aria-label="Arrow icon" title="Arrow" attrs="{'invisible': [('delivery_restriction_start_date', '=', False), ('delivery_restriction_end_date', '=', False)]}"/>
                    <field name="delivery_restriction_end_date" widget="daterange" options='{"related_start_date": "delivery_restriction_start_date"}'/>
                </div>
            </xpath>
            <xpath expr="//group[@name='sale']" position="inside">
                <field name="attn_to"/>
                <field name="customer_code" attrs="{'readonly': [('parent_id','!=', False)]}"/>
                <field name="partner_seq"/>
            </xpath>
            <xpath expr="//group[@name='purchase']" position="inside">
                <field name="supplier_code"/>
                <field name="batch_number"/>
            </xpath>
            <xpath expr="//field[@name='child_ids']//form//field[@name='mobile']" position="after">
                <field name="dept_code" attrs="{'invisible': [('type','!=','dept_staff')]}"/>
            </xpath>
            <xpath expr="//page[@name='internal_notes']" position="after">
                <page string="User Training">
                    <field name="user_training_ids">
                        <tree editable="bottom">
                            <field name="name"/>
                            <field name="datetime" string="Date &amp; Time"/>
                            <field name="venue"/>
                            <field name="type"/>
                        </tree>
                    </field>
                </page>
                <page string="Platform Link">
                    <group>
                        <field name="platform_name"/>
                        <field name="platform_login"/>
                        <field name="platform_pwd"/>
                    </group>
                </page>
            </xpath>
            <xpath expr="//field[@name='child_ids']//form//field[@name='comment']" position="after">
                 <field  name="delivery_instruction" placeholder="Delivery instruction..." nolabel="1" colspan="2" attrs="{'invisible': [('type','!=','delivery')]}"/>
                 <field name="invoice_instruction" placeholder="Inovice instruction..." nolabel="1" colspan="2" attrs="{'invisible': [('type','!=','invoice')]}"/>
            </xpath>
            <xpath expr="//page[@name='sales_purchases']//group[@name='misc']" position="after">
                <group name="instruction" string="Instruction">
                    <field name="delivery_instruction" placeholder="Delivery instruction..." nolabel="1" colspan="2" attrs="{'invisible': [('type','!=','delivery')]}" />
                    <field name="invoice_instruction" placeholder="Inovice instruction..." nolabel="1" colspan="2" attrs="{'invisible': [('type','!=','invoice')]}"/>
                </group>
            </xpath>
             <xpath expr="//field[@name='category_id']" position="after">
                <field name="type_of_invoice"/>
            </xpath>
            <xpath expr="//span[@name='address_name']" position="before">
                <field name="is_contact_created" invisible="1"/>
                <field name="code" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='zip']" position="attributes">
                <attribute name="placeholder">Postal Code</attribute>
            </xpath>
            <xpath expr="//div[hasclass('o_address_format')]" position="after">
                <field name="district_code" placeholder='District Code' 
                        readonly="1"/>
            </xpath>
            <xpath expr="//notebook[last()]" position="inside">
                <page string="Request Approval" name="request_approval" groups="account.group_account_manager">
                    <h5 class="font-weight-bold" attrs="{'invisible':[
                        '|',('is_request_creditlimit','=',True),'|',('is_request_pricelist','=',True),('is_request_paymentterm','=',True)]}">Currently there is no Update Request.</h5>
                    <field name="is_request_creditlimit" invisible="1"/>
                    <group name="approval_requests">
                        <group string="Requested Credit Limit" name="credit_limit" attrs="{'invisible':[('is_request_creditlimit','=',False)]}">
                            <group>
                                <field name="credit_limit" readonly="1"/>
                                <filed name="creditlimit_approval_state" readonly="1"/>
                            </group>
                            <group>
                                <field name="requested_credit_limit" readonly="1"/>
                            </group>
                            <group>
                                    <button name="approve_creditlimt" type="object" string="Approve" class="oe_highlight"/>
                                    <button name="reject_creditlimt" type="object" string="Reject" class="oe_highlight"/>
                            </group>
                        </group>

                        <field name="is_request_pricelist" invisible="1"/>
                        <group string="Requested Pricelist" name="price_list" attrs="{'invisible':['|',('company_type','=','person'),('is_request_pricelist','=',False)]}">
                            <group>
                                <field name="property_product_pricelist" readonly="1"/>
                            </group>
                            <group>
                                <field name="requested_pricelist_id" readonly="1"/>
                            </group>
                            <group>
                                    <button name="approve_pricelist" type="object" string="Approve" class="oe_highlight"/>
                                    <button name="reject_pricelist" type="object" string="Reject" class="oe_highlight"/>
                            </group>
                        </group>

                        <field name="is_request_paymentterm" invisible="1"/>
                        <group string="Requested Payment Term" name="price_list" attrs="{'invisible':[('is_request_paymentterm','=',False)]}">
                            <group>
                                <field name="property_payment_term_id" readonly="1"/>
                            </group>
                            <group>
                                <field name="requested_payment_term_id" readonly="1"/>
                            </group>
                            <group>
                                    <button name="approve_paymnetterm" type="object" string="Approve" class="oe_highlight"/>
                                    <button name="reject_paymnetterm" type="object" string="Reject" class="oe_highlight"/>
                            </group>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <record id="fischerbell_view_partner_property_form" model="ir.ui.view">
        <field name="name">fischerbell.res.partner.purchase.property.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="purchase.view_partner_property_form"/>
        <field name="priority">37</field>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='purchase']//field[@name='property_purchase_currency_id']" position="after">
                <field name="currency_type" readonly="1" force_save="1"/>
            </xpath>
            <xpath expr="//field[@name='property_payment_term_id']" position="attributes">
                <attribute name="readonly">True</attribute>
            </xpath>
            <xpath expr="//field[@name='property_payment_term_id']" position="after">
                <field name="is_request_paymentterm" invisible="1"/>
                <field name="paymentterm_approval_state" readonly="1" attrs="{'invisible':[('paymentterm_approval_state','not in',('approved','rejected','pending'))]}"/>
            </xpath>
            <xpath expr="//field[@name='credit_limit']" position="attributes">
                <attribute name="readonly">True</attribute>
            </xpath>
            <xpath expr="//field[@name='credit_limit']" position="after">
                <field name="is_request_creditlimit" invisible="1"/>
                <field name="creditlimit_approval_state" readonly="1" attrs="{'invisible':[('creditlimit_approval_state','not in',('approved','rejected','pending'))]}"/>
            </xpath>
            <xpath expr="//field[@name='property_product_pricelist']" position="attributes">
                <attribute name="readonly">True</attribute>
            </xpath>
            <xpath expr="//field[@name='property_product_pricelist']" position="after">
                <field name="is_request_pricelist" invisible="1"/>
                <field name="pricelist_approval_state" readonly="1" attrs="{'invisible': [('pricelist_approval_state','not in',('approved','rejected','pending'))]}"/>

            </xpath>
            <xpath expr="//group[@name='container_row_2']" position="before">
                    <div class="col-6">
                        <button name="%(fischerbell_custom.action_request_partner_details_wizard)d" type="action" string="Update Details" class="btn_primariy oe_highlight"
                            attrs="{'invisible':['|',('is_request_creditlimit','=',True),'|',('is_request_pricelist','=',True),('is_request_paymentterm','=',True)]}"/>
                    </div>
            </xpath>
        </field>
    </record>

    <record id="fischerbell_view_res_partner_inherit" model="ir.ui.view">
        <field name="name">fischerbell_view_res_partner_inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="postal_management.view_res_partner_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='postal_code_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='postal_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
             <xpath expr="//field[@name='is_driver']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='is_forwarder']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
