<?xml version='1.0' encoding='UTF-8' ?>
<odoo>
	<record id="fischerbell_view_partner_form" model="ir.ui.view">
        <field name="name">fischerbell.res.partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority" eval="1"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sale']" position="inside">
                <field name="credit_limit"/>
            </xpath>
            <xpath expr="//field[@name='user_ids']" position="before">
                <field name="fax" widget="phone"/>
            </xpath>
            <xpath expr="//field[@name='vat']" position="after">
<!--                <field name="partner_seq"/>-->
                <field name="e_invoice_email" widget="email"/>
                <field name="soa_email" widget="email"/>
                <field name="currency_id"/>
            </xpath>
            <xpath expr="//field[@name='vat']" position="after">
                <field name="no_delivery_days_selection"/>
                <field name="no_delivery_days" attrs="{'invisible':[('no_delivery_days_selection','in',['date',False])]}"/>
                <label for="delivery_restriction_start_date" string="Date" attrs="{'invisible':[('no_delivery_days_selection','in',['days',False])]}"/>
                <div name="dates" class="o_row" attrs="{'invisible':[('no_delivery_days_selection','in',['days',False])]}">
                    <field name="delivery_restriction_start_date" widget="daterange" options='{"related_end_date": "delivery_restriction_end_date"}'/>
                    <i class="fa fa-long-arrow-right mx-2 oe_edit_only" aria-label="Arrow icon" title="Arrow"/>
                    <i class="fa fa-long-arrow-right mx-2 oe_read_only" aria-label="Arrow icon" title="Arrow" attrs="{'invisible': [('delivery_restriction_start_date', '=', False), ('delivery_restriction_end_date', '=', False)]}"/>
                    <field name="delivery_restriction_end_date" widget="daterange" options='{"related_start_date": "delivery_restriction_start_date"}'/>
                </div>
            </xpath>
            <xpath expr="//group[@name='sale']" position="inside">
        		<field name="attn_to"/>
                <field name="customer_code" attrs="{'readonly': [('parent_id','!=', False)]}"/>
                <field name="partner_seq"/>
            </xpath>
            <xpath expr="//group[@name='purchase']" position="inside">
                <field name="supplier_code"/>
                <field name="batch_number"/>
            </xpath>
            <xpath expr="//field[@name='child_ids']//form//field[@name='mobile']" position="after">
                <field name="dept_code" attrs="{'invisible': [('type','!=','dept_staff')]}"/>
            </xpath>
            <xpath expr="//page[@name='internal_notes']" position="after">
                <page string="User Training">
                    <field name="user_training_ids">
                        <tree editable="bottom">
                            <field name="name"/>
                            <field name="datetime" string="Date &amp; Time"/>
                            <field name="venue"/>
                            <field name="type"/>
                        </tree>
                    </field>
                </page>
                <page string="Platform Link">
                    <group>
                        <field name="platform_name"/>
                        <field name="platform_login"/>
                        <field name="platform_pwd"/>
                    </group>
                </page>
            </xpath>
            <xpath expr="//field[@name='child_ids']//form//field[@name='comment']" position="after">
                 <field  name="delivery_instruction" placeholder="Delivery instruction..." nolabel="1" colspan="2" attrs="{'invisible': [('type','!=','delivery')]}"/>
                 <field name="invoice_instruction" placeholder="Inovice instruction..." nolabel="1" colspan="2" attrs="{'invisible': [('type','!=','invoice')]}"/>
            </xpath>
            <xpath expr="//page[@name='sales_purchases']//group[@name='misc']" position="after">
                <group name="instruction" string="Instruction">
                    <field name="delivery_instruction" placeholder="Delivery instruction..." nolabel="1" colspan="2" attrs="{'invisible': [('type','!=','delivery')]}" />
                    <field name="invoice_instruction" placeholder="Inovice instruction..." nolabel="1" colspan="2" attrs="{'invisible': [('type','!=','invoice')]}"/>
                </group>
            </xpath>
             <xpath expr="//field[@name='category_id']" position="after">
                <field name="type_of_invoice"/>
            </xpath>
            <xpath expr="//span[@name='address_name']" position="before">
                <field name="is_contact_created" invisible="1"/>
                <field name="code" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='zip']" position="attributes">
                <attribute name="placeholder">Postal Code</attribute>
            </xpath>
            <xpath expr="//div[hasclass('o_address_format')]" position="after">
                <field name="district_code" placeholder='District Code' 
                        readonly="1"/>
            </xpath>
        </field>
    </record>

    <record id="fischerbell_view_partner_property_form" model="ir.ui.view">
        <field name="name">fischerbell.res.partner.purchase.property.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="purchase.view_partner_property_form"/>
        <field name="priority">37</field>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='purchase']//field[@name='property_purchase_currency_id']" position="after">
                <field name="currency_type" readonly="1" force_save="1"/>
            </xpath>
        </field>
    </record>

    <record id="fischerbell_view_res_partner_inherit" model="ir.ui.view">
        <field name="name">fischerbell_view_res_partner_inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="postal_management.view_res_partner_inherit"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='postal_code_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='postal_ids']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
             <xpath expr="//field[@name='is_driver']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='is_forwarder']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
        </field>
    </record>
</odoo>
