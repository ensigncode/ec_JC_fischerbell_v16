<?xml version='1.0' encoding='UTF-8' ?>
<odoo>
	<record id="fischerbell_view_partner_form" model="ir.ui.view">
        <field name="name">fischerbell.res.partner.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="priority" eval="1"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='user_ids']" position="before">
                <field name="fax" widget="phone"/>
            </xpath>
            <xpath expr="//group[@name='sale']" position="inside">
        		<field name="attn_to"/>
                <field name="customer_code" attrs="{'readonly': [('parent_id','!=', False)]}"/>
            </xpath>
            <xpath expr="//group[@name='purchase']" position="inside">
                <field name="supplier_code"/>
                <field name="batch_number"/>
            </xpath>
            <xpath expr="//field[@name='child_ids']//form//field[@name='mobile']" position="after">
                <field name="dept_code" attrs="{'invisible': [('type','!=','dept_staff')]}"/>
            </xpath>
            <xpath expr="//page[@name='internal_notes']" position="after">
                <page string="User Training">
                    <field name="user_training_ids">
                        <tree editable="bottom">
                            <field name="name"/>
                            <field name="datetime" string="Date &amp; Time"/>
                            <field name="venue"/>
                            <field name="type"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

    <record id="fischerbell_view_partner_property_form" model="ir.ui.view">
        <field name="name">fischerbell.res.partner.purchase.property.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="purchase.view_partner_property_form"/>
        <field name="priority">37</field>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='purchase']//field[@name='property_purchase_currency_id']" position="after">
                <field name="currency_type" readonly="1" force_save="1"/>
            </xpath>
        </field>
    </record>
</odoo>