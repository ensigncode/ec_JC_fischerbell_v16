<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="view_opportunity_type_form" model="ir.ui.view">
            <field name="name">opportunity.type.form</field>
            <field name="model">opportunity.type</field>
            <field name="arch" type="xml">
                <form string="Opportunity">
                    <sheet>
                        <group>
                            <group>
                                <field name="name" string="Name" />
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="fee_opportunity_type_tree" model="ir.ui.view">
            <field name="name">opportunity.type.view.tree</field>
            <field name="model">opportunity.type</field>
            <field name="arch" type="xml">
                <tree string="Opportunity">
                    <field name="name" />
                </tree>
            </field>
        </record>
        <record id="action_opportunity_type" model="ir.actions.act_window">
            <field name="name">Opportunity Type</field>
            <field name="res_model">opportunity.type</field>
            <field name="view_mode">tree,form</field>
        </record>
        <menuitem id="opportunity_type_menu_action" action="action_opportunity_type" groups="sales_team.group_sale_manager" parent="crm.crm_menu_config" sequence="1" />
    </data>
</odoo>