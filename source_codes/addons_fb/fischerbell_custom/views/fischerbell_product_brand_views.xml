<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="fischerbell_view_product_brand_form" model="ir.ui.view">
        <field name="name">fischerbell.view.product.brand.form</field>
        <field name="model">fischerbell.product.brand</field>
        <field name="arch" type="xml">
        	<form>
        		<sheet>
        			<group>
        				<group>
				        	<field name="name"/>
				        </group>
				    </group>
				</sheet>
			</form>
        </field>
    </record>

	<record id="fischerbell_view_product_brand_tree" model="ir.ui.view">
        <field name="name">fischerbell.view.product.brand.tree</field>
        <field name="model">fischerbell.product.brand</field>
        <field name="arch" type="xml">
        	<tree>
	        	<field name="name"/>
	
			</tree>
        </field>
    </record>

    <record id="action_fischerbell_product_brand" model="ir.actions.act_window">
        <field name="name">Product Brand</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">fischerbell.product.brand</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{}</field>
        <field name="domain">[]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new product brand
            </p>
        </field>
    </record>

    <menuitem id="menu_fischerbell_product_brand"
        name="Product Brand"
        action="fischerbell_custom.action_fischerbell_product_brand"
        parent="stock.menu_stock_inventory_control"
        sequence="2"/>
</odoo>
