<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<record id="fischerbell_view_configuration_note_tree" model="ir.ui.view">
        <field name="name">fischerbell.view.configuration.note.tree</field>
        <field name="model">fischerbell.configuration.note</field>
        <field name="arch" type="xml">
        	<tree editable="bottom" create="1" edit="1">
	        	<field name="note"/>
                <field name="type"/>
                <field name="partner_ids" widget="many2many_tags"/>
			</tree>
        </field>
    </record>

    <record id="action_fischerbell_configuration_note" model="ir.actions.act_window">
        <field name="name">Configuration Note</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">fischerbell.configuration.note</field>
        <field name="view_mode">tree</field>
        <field name="context">{}</field>
        <field name="domain">[]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Configuration Note
            </p>
        </field>
    </record>

    <menuitem id="menu_fischerbell_configuration_note"
        name="Configuration Note"
        action="fischerbell_custom.action_fischerbell_configuration_note"
        parent="contacts.res_partner_menu_config"
        />
</odoo>
