<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_my_home_menu_transfer"
              name="Portal layout : Transfer menu entries"
              inherit_id="portal.portal_breadcrumbs" priority="30">
         <xpath expr="//ol[hasclass('o_portal_submenu')]" position="inside">
            <li t-if="page_name == 'transfer'"
                t-attf-class="breadcrumb-item #{'active ' if not transfer else ''}">
                <a t-if="transfer"
                   t-attf-href="/my/transfer{{ keep_query() }}">
                    My Transfer
                </a>
                <t t-else="">My Transfer</t>
            </li>
            <li t-if="transfer" class="breadcrumb-item active">
                <t t-esc="picking_id.name" />
            </li>
        </xpath>
     </template>
    
     <template
        id="portal_my_home_transfer"
        name="Portal My Home : Transfer entries"
        inherit_id="portal.portal_my_home"
        priority="30">
        <xpath expr="//div[hasclass('o_portal_docs')]" position="inside">
            <t t-call="portal.portal_docs_entry">
                <t t-set="title">My Transfer</t>
                <t t-set="url" t-value="'/my/transfer'" />
                <t t-set="placeholder_count" t-value="'transfer_count'" />
            </t>
        </xpath>
    </template>

      <template id="portal_list_transfer" name="Transfer View">
        <t t-call="portal.portal_layout">
            <t t-set="breadcrumbs_searchbar" t-value="True"/>
            <t t-call="portal.portal_searchbar">
                <t t-set="title">Transfer
                </t>
            </t>
            <t t-if="not page_name">
                <p>There are currently no transfer information for your
                    account.
                </p>
            </t>
            <t t-if="page_name" t-call="portal.portal_table">
                <thead>
                    <tr class="active">
                        <th>
                            <span class='d-none d-md-inline'>Name</span>
                        </th>
                        
                        <th class='d-none'>
                            <span class='d-none'>Delivery</span>
                        </th>

                        <th>
                            <span class='d-none d-md-inline'>Scheduled Date</span>
                        </th>
                         <th>
                            <span class='d-none d-md-inline'>Deadline</span>
                        </th>
                        <th>
                            <span class='d-none d-md-inline'>Source Document</span>
                        </th>
                         <th>
                            <span class='d-none d-md-inline'>Status</span>
                        </th>
                    </tr>
                </thead>
                <tbody class="tbody_class">
                  <t t-foreach="picking_ids" t-as="picking_id">
                    <tr draggable="true"> 
                        <td class="d-none" id="picking">
                            <t t-esc="picking_id.id"/>
                        </td>
                        <td>
                            <a t-attf-href="/my/transfer/#{picking_id.id}?{{ keep_query() }}"><span t-field="picking_id.name"/></a>
                        </td>
                       
                        
                        <td>
                            <t t-esc="picking_id.scheduled_date" t-options='{"widget": "date","format": "dd-MM-yyyy"}'/>
                        </td>
                        <td>
                            <t t-esc="picking_id.date_deadline" t-options='{"widget": "date","format": "dd-MM-yyyy"}'/>
                        </td>
                         <td>
                            <t t-esc="picking_id.origin"/>
                        </td>
                          <t t-set="status_list" t-value="{
                        'draft':'Draft',
                        'waiting': 'Waiting another operation',
                        'confirmed': 'Waiting',
                        'assigned': 'Ready',
                        'done':'Done',
                        'cancel':'Cancelled',
                        }"/>
                        <td>
                            <t t-foreach="status_list" t-as="status">
                                 <t t-if="picking_id.state == 'draft'">
                                     <span class="badge badge-pill bg-secondary">
                                         <t t-esc="status_list[status]"/>
                                     </span>
                                 </t>
                                 <t t-if="status == picking_id.state">
                                    <t t-if="picking_id.state == 'waiting'">
                                        <span class="badge badge-pill bg-success">
                                            <t t-esc="status_list[status]"/>
                                        </span>
                                    </t>
                                    <t t-if="picking_id.state == 'confirmed'">
                                        <span class="badge badge-pill bg-warning">
                                            <t t-esc="status_list[status]"/>
                                        </span>
                                    </t>
                                    <t t-if="picking_id.state == 'assigned'">
                                        <span class="badge badge-pill bg-info">
                                            <t t-esc="status_list[status]"/>
                                        </span>
                                    </t>
                                    <t t-if="picking_id.state == 'done'">
                                        <span class="badge badge-pill bg-success">
                                            <t t-esc="status_list[status]"/>
                                        </span>
                                    </t>
                                    <t t-if="picking_id.state == 'cancel'">
                                        <span class="badge badge-pill bg-danger">
                                            <t t-esc="status_list[status]"/>
                                        </span>
                                    </t>
                                    
                                </t>
                                
                            </t>
                        </td>
                        
                        <div class="modal fade" t-attf-id="modalsignatureaccept_{{ picking_id.id }}" tabindex="-1" aria-labelledby="signature" role="dialog" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered" style="margin-left: 263px;" role="document">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title" id="signatureForm">Signature</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        <t t-call="portal.signature_form">
                                            <t t-set="call_url" t-value="'/my/need_approved?picking_id=%s' % picking_id.id"/>
                                            <t t-if="picking_id.is_dropship">
                                                <t t-set="default_name" t-value="picking_id.responsible_customer_id.name"/>
                                            </t>
                                            <t t-else="">
                                                <t t-set="default_name" t-value="picking_id.partner_id.name"/>
                                            </t>
                                        </t>
                                    </div>
                                </div>
                            </div>
                        </div>

                          <div class="modal fade skip_delivery_modal" t-attf-id="modaldeliveryskip_{{ picking_id.id }}" tabindex="-1" aria-labelledby="signature" role="dialog" aria-hidden="true">
                            <div class="modal-dialog modal-dialog-centered" role="document">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title" id="">Skip Delivery</h5>
                                       <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        <label class="" for="skip_reason"></label>
                                        <textarea type="text" rows="4" cols="50" placeholder=" Give the reason for skip this delivery." id="skip_reason" name="skip_reason"></textarea>
                                    </div>
                                    <div class="modal-footer">
                                        <button type="" class="btn btn-primary submit_skip_delivery" t-att-data-id="picking_id.id">Submit</button>
                                        <button type="button" data-bs-dismiss="modal" class="btn btn-secondary">Cancel</button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <td class="portal_btn_blocks" t-if="picking_id.state in ['assigned']">
                           
                                <button class="btn btn-link o_icon_button text-primary approve_btn" t-att-data-id="picking_id.id" type="button">
                                    <i class="fa fa-pencil"/>
                                    Signature
                                </button>
                                <button  class="btn btn-primary skip_delivery" 
                                t-att-disabled="picking_id.next_delivery_date and picking_id.next_delivery_date.date() &gt; current_date"
                                    t-att-data-id="picking_id.id" type="button">
                                    Skip
                                </button>
                           
                        </td>
                        <td class="portal_btn_blocks" t-else="">
                        </td>
                         <!-- <t t-else="">
                           <td class="portal_btn_blocks"></td>
                         </t> -->
                     </tr>
                  </t>
               </tbody>
             </t>
         </t>
       </template>
       <template id="portal_my_transfer_detail" name="My Transfer">
            <t t-call="portal.portal_layout">
                <table class="table rounded mb-0 mt-3 bg-white o_portal_my_doc_table">
                    <tbody>
                        <tr>
                            <td style="font-weight:bold;width:20%;">Picking</td>
                            <td><t t-esc="picking_id.name"/></td>
                        </tr>
                        <tr>
                            <td style="font-weight:bold;width:20%;">Company Name</td>
                            <td><t t-if="picking_id.partner_id.parent_id" t-esc="picking_id.partner_id.parent_id.name"/></td>
                        </tr>
                        <tr>
                            <td style="font-weight:bold;width:20%;">Company Address</td>
                            <td>
                                <p>
                                    <t t-esc="picking_id.partner_id.parent_id.street"/>,<t t-esc="picking_id.partner_id.parent_id.street2"/><br />
                                    <t t-esc="picking_id.partner_id.parent_id.city"/>,<t t-esc="picking_id.partner_id.parent_id.state_id.name"/><br />
                                    <t t-esc="picking_id.partner_id.parent_id.country_id.name"/>,<t t-esc="picking_id.partner_id.parent_id.zip"/>
                                </p>
                            </td>
                        </tr>
                        <tr>
                            <td style="font-weight:bold;width:20%;">Instructions</td>
                            <td><t t-esc="picking_id.delivery_instruction"/></td>
                        </tr>
                        <tr>
                            <td style="font-weight:bold;width:20%;">Contact Person</td>
                            <td><t t-esc="picking_id.partner_id.name"/></td>
                        </tr>
                        <tr>
                            <td style="font-weight:bold;width:20%;">Phone Number</td>
                            <td><t t-esc="picking_id.partner_id.phone"/></td>
                        </tr>
                        
                    </tbody>
                </table>
            </t>
    </template>

      
      
</odoo>