<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_picking_reason_line_view_tree" model="ir.ui.view">
        <field name="name">stock.picking.reason.line.view.tree</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.vpicktree"/>
        <field name="arch" type="xml">
            <field name="state" position="after">
                <field name="latest_skip_reason" optional="hide" />
            </field>
        </field>
    </record>
    <record id="stock_picking_reason_line_view_form" model="ir.ui.view">
        <field name="name">stock.picking.reason.line.view.form</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <field name="location_dest_id" position="after">
                <field name="responsible_customer_id" attrs="{'invisible': [('picking_type_code', '!=', 'incoming')]}" />
            </field>
            <xpath expr="//page[@name='note']" position="after">
                <page string="Skip Reason Lines" name="skip_reasons">
                    <field name="skip_reason_line_ids">
                        <tree editable="bottom">
                            <field name="reason_date"/>
                            <field name="name"/>
                        </tree>    
                    </field>
                </page>
            </xpath>
        </field>
    </record>
    <record id="view_picking_skip_reason_search" model="ir.ui.view">
		<field name="name">stock.picking.skip.reason.search</field>
		<field name="model">stock.picking</field>
		<field name="inherit_id" ref="stock.view_picking_internal_search"/>
		<field name="arch" type="xml">
			<xpath expr="//search//filter[@name='backorder']" position="after">
				<filter name="successfull_transfer" string="Successful Delivery" domain="[('successfull_delivery','=',True),('state','=','done')]"/>
				<filter name="unsuccessfull_transfer" string="Unsuccessful Delivery" domain="[('successfull_delivery','=',False)]"/>
			</xpath>
		</field>
	</record>
</odoo>
