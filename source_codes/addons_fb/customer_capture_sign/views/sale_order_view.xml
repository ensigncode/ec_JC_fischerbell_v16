<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_sale_order_inherited_sign" model="ir.ui.view">
        <field name="name">view_sale_order_inherited_sign</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form" />
        <field name="arch" type="xml">
            <xpath expr="//button[@name='action_quotation_send']" position="after">
                <button name="action_esign_send_mail" type="object" string="Capture Sign BY Email" states="sale"/>
            </xpath>
        </field>
    </record>
</odoo>