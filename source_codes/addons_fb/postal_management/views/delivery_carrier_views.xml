<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="driver_delivery_carrier_view_form_inherit" model="ir.ui.view">
        <field name="name">driver.delivery.carrier.view.form.inherit</field>
        <field name="model">delivery.carrier</field>
        <field name="inherit_id" ref="delivery.view_delivery_carrier_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='company_id']" position="after">
                <field name="assigned_driver" domain="[('is_forwarder', '=', True)]" />
            </xpath>
        </field>
    </record>
</odoo>