<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_picking_driver_view_form_inherit" model="ir.ui.view">
        <field name="name">stock.picking.driver.view.form.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='other_infos']" position="before">
                <group name='shipping_label_report_data' string="Shipping Label Information">
                    <field name="packing_dimentions"/>
                    <label for="weight_shipping_label" string="Weight Shipping label"/>
                    <div>
                        <field name="weight_shipping_label" class="oe_inline" style="width:10% !important"/>
                        <field name="weight_uom_shipping_label" nolabel="1" class="oe_inline" style="margin-left:3px;width:30% !important"/>
                    </div>
                </group>
            </xpath>
            
            <xpath expr="//page//group[@name='other_infos']" position="after">
                <group string="Driver Information" name="driver_infos">
                    <field name="driver_ids" widget="many2many_tags" invisible="1" />
                    <field name="driver_id" domain="[('id','in',driver_ids)]" attrs="{'invisible': [('carrier_id', '!=', False)]}" options="{'no_create_edit': True,'no_create': True}"/>
                    <field name="collection" widget="radio"/>
                    <field name="driver_remarks" attrs="{'invisible': [('collection', '!=', 'self_collection')]}" force_save="1" />
                    <field name="forwarder_id" domain="[('is_forwarder','=',True)]"  attrs="{'invisible': [('carrier_id', '=', False)]}" />
                    <field name="assign_driver" invisible="1"/>
                    <field name="vehicle_id" domain="[('driver_id','=',driver_id)]"/>
                </group>
            </xpath>
            <xpath expr="//page[@name='note']" position="after">
                <page string="Customer's Signature" name="customer_signature">
                    <group>
                        <field name="signed_by" readonly="1"/>
                        <field name="signed_on" readonly="1"/>
                        <field name="signature" class="w-50" widget="image" readonly="1"/>
                        <field name="signature_uploded" invisible="1"/>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
    <record id="view_picking_internal_search_driver_inherit" model="ir.ui.view">
        <field name="name">stock.picking.internal.search.driver.inherit</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_internal_search"/>
        <field name="arch" type="xml">
            <field name="partner_id" position="after">
                <field name="driver_id"></field>
            </field>
            <filter name="picking_type" position="after">
                <filter string="Driver" name="batch" domain="[]" context="{'group_by': 'driver_id'}"/>
            </filter>
        </field>
    </record>
</odoo>
