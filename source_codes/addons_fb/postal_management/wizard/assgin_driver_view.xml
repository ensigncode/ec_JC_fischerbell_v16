<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_assign_driver_line_form" model="ir.ui.view">
        <field name="name">view.assign.driver.line.form</field>
        <field name="model">assign.driver.line</field>
        <field name="arch" type="xml">
        	<form>
                <sheet>
                    <field name="assign_driver_ids" nolabel="1">
                        <tree editable="bottom">
                            <field name="order_id"/>
                            <field name="picking_id"/>
                            <field name="driver_id" domain="[('id','in',driver_ids)]"/>
                            <field name="vehicle_id" domain="[('driver_id','=',driver_id)]"/>
                            <field name="driver_ids" widget="many2many_tags" readonly="1" force_save="1"/>
                        </tree>
                    </field>
                </sheet>
        		<footer>
                    <button string="Assgin Driver" name="assign_driver" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn-default" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

     <record id="action_assign_driver" model="ir.actions.act_window">
        <field name="name">Assgin Driver</field>
        <field name="res_model">assign.driver.line</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="view_id" ref="view_assign_driver_line_form"/>
    </record>

    <record id="action_view_sale_advance_payment_inv" model="ir.actions.act_window">
        <field name="name">Assign Delivery Driver</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">assign.driver.line</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_view_types">list</field>
    </record>

</odoo>