<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="account_partner_view_inherit" model="ir.ui.view">
        <field name="name">account.partner.view.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form" />
        <field name="arch" type="xml">
            <xpath expr="//page//group//field[@name='credit_limit']" position="before">
                <field name="customer_taxes"/>
            </xpath>
            <xpath expr="//page//group//field[@name='property_supplier_payment_term_id']" position="before">
                <field name="supplier_taxes"/>
            </xpath>
        </field>
    </record>
</odoo>