<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_fit_test_training_tree" model="ir.ui.view">
        <field name="name">view_fit_test_training_detail_tree</field>
        <field name="model">fit.test.training</field>
        <field name="arch" type="xml">
            <tree string="fit test training Detail" sample="1">
                <field name="name"/>
                <field name="date"/>
                <field name="charge_name"/>
                <field name="phone"/>
                <field name="company"/>
                <field name="training_type"/>
            </tree>
        </field>
    </record>

    <record id="view_fit_test_training_form" model="ir.ui.view">
        <field name="name">view_fit.test.training_detail_form</field>
        <field name="model">fit.test.training</field>
        <field name="arch" type="xml">
            <form string="fit test training Detail">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="charge_name"/>
                            <field name="training_type"/>
                            <field name="company"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="phone"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_fit_test_training">
        <field name="name">Fit Test Training Detail</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">fit.test.training</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem name="Fit Test Training"
              id="menu_website_fit_test_training"
              action="action_fit_test_training"
              parent="sale.report_sales_team"
    />


</odoo>