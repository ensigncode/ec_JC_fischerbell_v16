<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_fit_test_training_tree" model="ir.ui.view">
        <field name="name">view_fit_test_training_detail_tree</field>
        <field name="model">fit.test.training</field>
        <field name="arch" type="xml">
            <tree string="fit test training Detail" sample="1">
                <field name="name"/>
                <field name="date"/>
                <field name="charge_name"/>
                <field name="phone"/>
                <field name="company"/>
                <field name="training_type"/>
            </tree>
        </field>
    </record>

    <record id="view_fit_test_training_form" model="ir.ui.view">
        <field name="name">view_fit.test.training_detail_form</field>
        <field name="model">fit.test.training</field>
        <field name="arch" type="xml">
            <form string="fit test training Detail">
                <header>
                    <button name="action_send_email" type="object" string="Send By Email" class="oe_highlight" />
                    <button name="action_fitness_form" type="object" string="Fitness Form" class="oe_highlight"/>

                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <div class="oe_title">
                        <h1>
                            <field name="reference_no"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="name_of_trainer"/>
                            <field name="charge_name"/>
                            <field name="training_type"/>
                            <field name="company"/>
                            <field name="training_types"/>
                            <field name="trainer_sign" widget="signature"/>
                            <field name="trainer_sign" widget="binary" string="Signature"/>
                        </group>
                        <group>
                            <field name="date"/>
                            <field name="phone"/>
<!--                            <field name="number_of_person"/>-->
                            <field name="location"/>
                            <field name="partner_id"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Fits Lines" name="fit_lines">
                            <field name="fit_ids">
                                <tree string="Fits Lines" editable="top"
                                      widget="section_and_note_one2many" mode="tree,kanban">
                                    <control>
                                        <create string="Add a Line"/>
                                    </control>
                                     <field name="fit_id" invisible="1"/>
                                     <field name="trainee"/>
                                     <field name="trainee_email"/>
                                     <field name="passport_no"/>
                                     <field name="size"/>
                                     <field name="is_pass_fail"/>
                                     <field name="tested_on"/>
                                </tree>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record model="ir.actions.act_window" id="action_fit_test_training">
        <field name="name">Training Details</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">fit.test.training</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem name="Fit Test Training"
              id="menu_website_fit_test_training"
              action="action_fit_test_training"
              parent="sale.report_sales_team"
    />


</odoo>