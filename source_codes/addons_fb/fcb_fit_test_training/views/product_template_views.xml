<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_product_template_inherit_form" model="ir.ui.view">
        <field name="name">view_product_template_inherit_form</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//label[@for='purchase_ok']" position="after">
                <field name="is_fit_test_training"/>
                <label for="is_fit_test_training"/>
            </xpath>
        </field>
    </record>
</odoo>