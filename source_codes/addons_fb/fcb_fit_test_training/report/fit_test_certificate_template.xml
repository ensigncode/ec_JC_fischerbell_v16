<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<template id="report_certificate">
		<t t-call="web.basic_layout">
			<t t-call="web.html_container">
				<div class="page">
					<t t-foreach="docs" t-as="doc">
						<div class="container">
							<t t-if="doc.fit_ids">
								<t t-foreach="doc.fit_ids" t-as="o">
									<div class="row">
										<div class="col-6" style="padding: 0; margin-left: -37px">
											<img src="/fcb_fit_test_training/static/src/img/side_bar_image.jpeg"
											     alt="certificate" style="height: 792px;width: 400px; margin: 0;"/>
										</div>
										<div class="col-6">
											<br/>
											<p style="font-size: 30px;">Fit Test Certificate</p>
											<br/>
											<br/>
											<p style="font-size: 25px;">This is to certify that
												<br/>
												<strong style="font-size: 25px;">
													<t t-if="o.trainee">
														<span t-field="o.trainee"/>
													</t>
												</strong>
											</p>
											<p style="font-size: 25px;">IC /FIN No. /Employee No:
												<t t-if="o.passport_no">
													<span t-field="o.passport_no"/>
												</t>
											</p>
											<p style="font-size: 25px;">from
												<br/>
												<strong style="font-size: 25px;">Elmer</strong>
											</p>
											<p style="font-size: 20px;">Passed the Training
												<br/>Type of Training:
												<t t-if="o.fit_id.training_type">
													<span t-field="o.fit_id.training_type"/>
												</t>
												<br/>Size / Result:
												<b>
													<t t-if="o.size">
														<span t-field="o.size"/>&#160;/&#160;
													</t>
												</b>
												<b>
													<t t-if="o.is_pass_fail == True">Pass</t>
													<t t-else="">Fail
													</t>
												</b>
											</p>
											<p style="font-size: 25px;">Tested On:
												<t t-if="o.tested_on">
													<span t-field="o.tested_on"/>
												</t>
											</p>
											<br/>
											<br/>
											<br/>
											<br/>
											<br/>
											<br/>
											<br/>
											<p style="font-size: 15px;text-align: right;">
												______________________________
											</p>
											<b>
												<p style="font-size: 15px; text-align: right;">Patric Yeo | Trainer</p>
											</b>
											<b>
												<p style="font-size: 15px; text-align: right;">Fischer Bell Private
													Limited
												</p>
											</b>
											<p style="font-size: 15px;text-align: center;">This Certificate is valid for
												one (1) year from the date issued
											</p>
										</div>
									</div>
									<p style="page-break-before:always;"></p>
								</t>
							</t>
							<t t-else="">
								<div class="col-6">
									<strong style="font-size: 40px;">Fit Test Certificate</strong>
									<br/>
									<br/>
									<br/>
									<p style="font-size: 30px;">This is to certify that
										<br/>
									</p>
									<p style="font-size: 30px;">IC /FIN No. /Employee No:
									</p>
									<p style="font-size: 30px;">From
										<br/>
									</p>
									<p style="font-size: 30px;">Passed the Training
										<br/>Type of Training

										<br/>Size

										<br/>
										<b>Result
										</b>
									</p>
									<p style="font-size: 30px;">Tested On
									</p>
								</div>
							</t>
						</div>
					</t>
				</div>
			</t>
		</t>
	</template>
</odoo>

