<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<template id="report_certificate">
		<t t-call="web.basic_layout">
			<t t-call="web.html_container">
				<div class="page">
					<t t-foreach="docs" t-as="doc">
						<div class="container">
							<t t-if="doc.fit_ids">
								<t t-foreach="doc.fit_ids" t-as="o">
								<t t-if="o.is_pass_fail==True">
									<div class="row">
										<div class="col-6" style="padding: 0; margin-left: -37px">
											<img src="/fcb_fit_test_training/static/src/img/test_cert_bg.jpeg"
											     alt="certificate" style="height: 792px;width: 400px; margin: 0;"/>s
										</div>
										<div class="col-6 mt-4 pt-4">
											<t t-if="doc.training_types == 'aed'">
												<p style="font-size: 42px;">AED Training Certificate</p>
											</t>
											<t t-if="doc.training_types == 'scba'">
												<p style="font-size: 42px;">SCBA Training Certificate</p>
											</t>
											<t t-if="doc.training_types == 'spill_traning'">
												<p style="font-size: 42px;">Spill Training Certificate</p>
											</t>
											<t t-if="doc.training_types == 'fit_test'">
												<p class="zilla-slab-regular" style="font-size: 42px;">Fit Test Certificate</p>
											</t>
											<div style="height:470px;">
											<p style="font-size: 22px;">This is to certify that
												
												<strong>
													<t t-if="o.trainee">
														<span t-field="o.trainee"/>
													</t>
												</strong>
											</p>
											<br />
											<p style="font-size: 22px;">IC /FIN No. /Employee No:
												<t t-if="o.passport_no">
													<strong t-field="o.passport_no"/>
												</t>
											</p>
											<p style="font-size: 22px;">From
												<strong>
													<t t-if="doc.company">
														<span t-field="doc.company"/>
													</t>
												</strong>
											</p>
											<t t-if="doc.training_types == 'fit_test'">
												<p style="font-size: 22px;">Passed the Qualitative Fit Test Training
													<br/>Type of Training:
													<t t-if="o.product_id">
														<strong t-field="o.product_id"/>
													</t>
													<br/>Size / Result:
															<b>
																<t t-if="o.size">
																	<span t-field="o.size"/>&#160;/&#160;
																</t>
															</b>
															<b>
																<t t-if="o.is_pass_fail == True">Pass</t>
																<t t-else="">Fail
																</t>
															</b>
													<br/><br/>
													<span>Tested On:
														<t t-if="o.tested_on">
															<strong t-field="o.tested_on" t-options='{"widget": "date","format": "dd MMMM yyyy"}'/>
														</t>
													</span>
												</p>
											</t>
											<br/>
											<p t-if="doc.training_types == 'aed' or doc.training_types == 'scba' or doc.training_types == 'spill_traning'">
												<span style="font-size: 22px;">Attended the Training on
													<t t-if="o.tested_on">
														<span t-field="o.tested_on" t-options='{"widget": "date","format": "dd-MM-yyyy"}'/>
													</t>
												</span>
												<br/>
												<span style="font-size: 22px;">Type of Training:
													<t t-if="o.product_id">
														<strong t-field="o.product_id"/>
													</t>
												</span>
												<br/>
												<span style="font-size: 22px;">Result:
													<strong>
														<t t-if="o.is_pass_fail == True">Pass</t>
														<t t-else="">Fail</t>
													</strong>
												</span>
											</p>
											<div class="row">
												<div class="col-7">
												</div>
												<div class="col-5">
													<t t-if="doc.trainer_sign">
														<div>
															<span class="trainer_sign" t-field="doc.trainer_sign" t-options='{"widget": "image"}' width="65%"/>
														</div>
													</t>
													<t t-else="">
														<div style="height:75px;">
															<span class="trainer_sign"  />
														</div>
													</t>
													<span class="line_span"> </span>
													<p style="font-size: 15px; margin-bottom:0;font-weight:bold;text-align:center;">
														<t t-if="doc.name">
															<span t-field="doc.name"/>
														</t> | Trainer
													</p>
													<p style="font-size: 15px;font-weight:bold;text-align:center; ">Fischer Bell Private
														Limited
													</p>
												</div>
											</div>

											
											<p style="font-size: 15px;text-align: start;margin-top:12%;">This Certificate is valid for
												one (1) year from the date issued
											</p>
											</div>
										</div>
									</div>
									<p style="page-break-before:always;"></p>
								</t>
								</t>
							</t>
							<t t-else="">
								<div class="col-6">
									<strong class="zilla-slab-regular" style="font-size: 40px;">Fit Test Certificate</strong>
									<br/>
									<br/>
									<br/>
									<p style="font-size: 30px;">This is to certify that
										<br/>
									</p>
									<p style="font-size: 30px;">IC /FIN No. /Employee No:
									</p>
									<p style="font-size: 30px;">From
										<br/>
									</p>
									<p style="font-size: 30px;">Passed the Training
										<br/>Type of Training:

										<br/>Size:

										<br/>
										<b>Result:
										</b>
									</p>
									<p style="font-size: 30px;">Tested On
									</p>
								</div>
							</t>
						</div>
					</t>
				</div>
			</t>
		</t>
	</template>

