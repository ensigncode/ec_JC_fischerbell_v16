<?xml version="1.0" encoding="utf-8"?>
<odoo>
	<data>
		Define Custom Paper Format
		<record id="paperformat_label_sheet_card" model="report.paperformat">
			<field name="name">A4 Label Sheet</field>
			<field name="default" eval="False"/>
			<field name="format">A4</field>
			<field name="orientation">Portrait</field>
			<field name="margin_top">5</field>
			<field name="margin_bottom">5</field>
			<field name="margin_left">5</field>
			<field name="margin_right">5</field>
			<field name="page_height">0</field>
			<field name="page_width">0</field>
			<field name="disable_shrinking" eval="True"/>
			<field name="dpi">96</field>
		</record>

		Report Action
		<record id="action_report_card_0" model="ir.actions.report">
			<field name="name">Fit Test Training Card</field>
			<field name="model">fit.test.training</field>
			<field name="report_type">qweb-pdf</field>
			<field name="report_name">fcb_fit_test_training.report_card</field>
			<field name="report_file">fcb_fit_test_training.report_card</field>
			<field name="paperformat_id"
			       ref="fcb_fit_test_training.paperformat_label_sheet_card"/>
			<field name="binding_model_id" ref="fcb_fit_test_training.model_fit_test_training"/>
			<field name="binding_type">report</field>
		</record>

		<!-- QWeb Template -->
		<template id="report_card">
			<t t-call="web.basic_layout">
				<t t-call="web.html_container">
					<div class="page"
					     style="position: relative; width: 100%; height: 100%; font-family: Arial, sans-serif;">
						<t t-foreach="docs" t-as="doc">
							<t t-if="doc.fit_ids">
								<t t-foreach="doc.fit_ids" t-as="o">
									<div style="float: left; width: 45%; margin: 1.5%; padding: 10px; border: 1px solid #000; box-sizing: border-box; height: 197px; position: relative;">
										<img src="/fcb_fit_test_training/static/src/img/test_cert_bg.png" alt="Background" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: -1; opacity: 0.2;"/>
										<div style="position: relative; z-index: 1;">
											<h4 style="text-align: center; margin-bottom: 5px; font-size: 12px;">
												Respiratory Fit Test Passed Card
											</h4>
											<h5 style="text-align: center; margin-bottom: 10px; font-size: 10px; font-weight: bold;">
												TRILOGIA ENGINEERING PTE LTD
											</h5>
											<span style="font-size: 11px; display: block; margin-bottom: 3px; font-weight: bold;">
												<strong>Staff Name &#160;&#160;&#160;&#160;&#160;:</strong>
												<t t-esc="o.trainee"/>
											</span>
											<span style="font-size: 11px; display: block; margin-bottom: 3px; font-weight: bold;">
												<strong>NRIC No &#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;:
												</strong>
												<t t-esc="o.passport_no"/>
											</span>
											<span style="font-size: 11px; display: block; margin-bottom: 3px; font-weight: bold;">
												<strong>Fit Test Date &#160;&#160;:</strong>
												<t t-esc="o.tested_on"
												   t-options='{"widget": "date","format": "dd-MM-yyyy"}'/>
											</span>
											<span style="font-size: 11px; display: block; margin-bottom: 3px; font-weight: bold;">
												<strong>Size &#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;&#160;:</strong>
												<t t-esc="o.size"/>
											</span>
											<span style="font-size: 11px; display: block; margin-bottom: 3px; font-weight: bold;">
												<strong>Expiry Date &#160;&#160;&#160;:</strong>
												<!--																					<t t-esc="doc.expiry_date"/>-->
											</span>
											<div style="display: flex; justify-content: space-between; margin-top: 10px;">
												<span style="text-align: left; flex: 1; font-size: 9px;">
													<strong>Instructor’s Signature</strong>
													<span t-field="doc.trainer_sign"
													      t-options='{"widget": "image"}'
													      style="display: inline-block; width: 30px; height: 20px; margin-top: 5px;">
													</span>
												</span>
												<span style="text-align: right; flex: 1; font-size: 9px;">
													<strong>Conducted By</strong>
													<img src="/fcb_fit_test_training/static/src/img/logo.jpeg"
													     alt="Conducted By Logo"
													     style="width: 50px; height: 20px; margin-top: 5px;"/>
												</span>
											</div>
											<div class="text-muted" style="text-align: center; font-size: 9px;">Please
												call
												us @6425 0443 for Fit Test Certificate renewal
											</div>
										</div>
									</div>
								</t>
							</t>
						</t>
					</div>
				</t>
			</t>
		</template>
	</data>
</odoo>
