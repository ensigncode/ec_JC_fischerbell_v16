<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="email_template_fit_test" model="mail.template">
            <field name="name">Fit Test Training: Send Certificate</field>
            <field name="model_id" ref="fcb_fit_test_training.model_fit_test_training"/>
            <field name="subject">{{ object.name }}</field>
            <field name="email_from">{{ (object.company.email_formatted or object.company.email_formatted or user.email_formatted) }}</field>
            <field name="partner_to">{{ object.company.id }}</field>
            <field name="auto_delete" eval="False" />
            <field name="description">Used by salespeople when they send quotations or proforma to prospects</field>
            <field name="body_html" type="html">
                <div style="margin: 0px; padding: 0px;">
                    <p style="margin: 0px; padding: 0px; font-size: 13px;">
                        Dear <t t-out="doc_name or ''"/>,

                            The training has been completed on {{object.date.day}}, November 14, 2023 at 10.00 am. Attached is the Training Certificate for your reference.

                            Please do not hesitate to contact us if you have any questions, or require any amendments of the certificate.
                        <br/><br/>
                    </p>
                </div>
            </field>
            <field name="report_template" ref="action_report_certificate_0"/>
            <field name="report_name">{{ (object.name or '').replace('/','_') }}</field>
            <field name="lang">{{ object.partner_id.lang }}</field>
        </record>
    </data>
</odoo>