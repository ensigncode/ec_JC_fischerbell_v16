<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="mrp_bom_view_form_inherit" model="ir.ui.view">
        <field name="name">mrp.bom.view.form.inherit</field>
        <field name="model">mrp.bom</field>
        <field name="inherit_id" ref="mrp.mrp_bom_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='code']" position="after">
                <field name="sales_price" attrs="{'invisible':[('type','!=','phantom')]}"/>
            </xpath>
             <xpath expr="//field[@name='bom_line_ids']//tree//field[@name='operation_id']" position="after">
                <field name="pricelist_price" optional="hide" readonly="1" force_save="1"/>
            </xpath>
        </field>
    </record>
</odoo>