<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="sale_order_form_view_inherit_optic" model="ir.ui.view">
            <field name="name">sale.order.form.optic</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form" />
            <field name="arch" type="xml">
                <field name="partner_id" position="after">
                    <field name="optician_detail_ids"  widget="many2many_tags" invisible="1" />
                </field>
                <xpath expr="//field[@name='order_line']//tree//field[@name='product_id']" position="after">
                    <field name="child_id" optional="hide" />
                </xpath>
            </field>
        </record>
    </data>
</odoo>